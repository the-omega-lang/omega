# A deliberately narrow platform for allocator-only coverage: no console gap
# is filled here. If a reachable code path needed Stdout, Stderr, or Stdin,
# this final link would fail rather than accidentally borrowing `plat`.

internal extern malloc : (size: usize) => *mut u8;
internal extern free : (ptr: *u8) => void;
internal extern realloc : (ptr: *u8, size: usize) => *mut u8;

glue core::platform::GlobalAllocator {
    alloc(size: usize) => *mut u8 { malloc(size) }
    free(ptr: *u8) => void { free(ptr) }
    realloc(ptr: *u8, size: usize) => *mut u8 { realloc(ptr, size) }
}
