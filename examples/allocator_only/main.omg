# This executable intentionally uses allocation from `std` but never names a
# console marker. Its sibling module supplies allocator glue only, proving the
# final link can discard `std`'s unused console paths.

import extern::std::string::String;

main() => i32 {
    mut value := String::new();
    value.push_str("allocator only");
    correct := value.len() == 14usize;
    value.free();
    if correct { 0 } else { 1 }
}
