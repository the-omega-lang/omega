# End-to-end hosted console I/O smoke test.

import extern::std::io::read_line;
import extern::std::io::string_writer;
import extern::std::io::to_string;
import extern::std::io::BufReader;
import extern::std::io::BufWriter;
import extern::std::io::SliceWriter;
import extern::std::io::Stdin;
import extern::std::io::Stderr;
import extern::std::io::Stdout;
import extern::std::io::Write;
import extern::std::io::eprintln;
import extern::std::io::println;
import extern::std::string::String;
import extern::std::fmt::Display;
import extern::std::fmt::write_uint;

# A user-defined `Display` conformance is an explicit composition. The type
# declaration itself owns only Pair's representation and inherent methods.
struct Pair {
    exposed value: i32;
}

compose Pair : Display {
    fmt(*self, out: spec *mut Write) => void {
        out.write(b"Pair(");
        Display::fmt(self.value, out);
        out.write(b")");
    }
}

main() => i32 {
    println$("integer=", -42i32, ", unsigned=", 255u8);
    println$("float=", 1.2345678f64);
    println$("bool=", true, ", char=", 'é', ", str=", "omega");
    println$("pair=", Pair { value = 7; });
    min_i8 := -127i8 - 1i8;
    min_i16 := -32767i16 - 1i16;
    min_i32 := -2147483647i32 - 1i32;
    min_i64 := -9223372036854775807i64 - 1i64;
    println$(
        "widths=", min_i8, "|", min_i16, "|", min_i32, "|", min_i64, "|",
        127i8, "|", 255u8, "|", 65535u16, "|", 4294967295u32, "|", 18446744073709551615u64
    );
    nan := 0.0f64 / 0.0f64;
    inf := 1.0f64 / 0.0f64;
    negative_inf := -1.0f64 / 0.0f64;
    println$("special=", nan, "|", inf, "|", negative_inf, "|", 0.0f64, "|", -0.0f64);
    println$("scientific=", 0.0000001f64, "|", 100000000000000000000.0f64);
    mut bases: [32]u8;
    mut base_stdout := Stdout {};
    mut base_writer := BufWriter<Stdout>::new(&mut base_stdout, &mut bases[0..]);
    write_uint(&mut base_writer, 10u64, 2u32);
    Write::write(&mut base_writer, b" ");
    write_uint(&mut base_writer, 255u64, 16u32);
    mut limited: [1]u8;
    mut memory_writer := SliceWriter::new(&mut limited[0..]);
    Write::write(&mut memory_writer, b"A");
    overflow_result := Write::write(&mut memory_writer, b"B");
    mut overflow := false;
    match overflow_result {
        Option::None => { overflow = true; },
        Option::Some => {},
    }
    println$("overflow=", overflow);
    Write::write(&mut base_writer, b"\n");
    base_writer.flush();
    mut buffered: [16]u8;
    mut stdout := Stdout {};
    mut writer := BufWriter<Stdout>::new(&mut stdout, &mut buffered[0..]);
    Write::write(&mut writer, b"buffered");
    Write::write(&mut writer, b"\n");
    writer.flush();
    mut rendered := String::new();
    mut rendered_writer := string_writer(&mut rendered);
    Write::write(&mut rendered_writer, b"owned");
    println$("string=", rendered.as_str());
    mut rendered_from_value := to_string(123i16);
    println$("to_string=", rendered_from_value.as_str());
    mut stdin := Stdin {};
    mut reader_buffer: [256]u8;
    mut reader := BufReader<Stdin>::new(&mut stdin, &mut reader_buffer[0..]);
    mut first := String::new();
    mut second := String::new();
    read_line(&mut reader, &mut first);
    read_line(&mut reader, &mut second);
    mut third := String::new();
    read_line(&mut reader, &mut third);
    mut fixed: [3]u8;
    mut fixed_writer := SliceWriter::new(&mut fixed[0..]);
    fixed_result := Write::write(&mut fixed_writer, <*[?]u8>third.as_str());
    mut fits := false;
    match fixed_result {
        Option::None => {},
        Option::Some => { fits = fixed_result.value == third.len(); },
    }
    Write::write(&mut fixed_writer, b"x");
    println$("truncated=", fits);
    println$("input=", first.as_str(), "|", second.as_str());
    eprintln$("stderr line");
    rendered.free();
    first.free();
    second.free();
    third.free();
    rendered_from_value.free();
    0
}
