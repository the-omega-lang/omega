# Console output now goes through `core::io`'s `print$`/`println$` macros and
# the `StandardOutput`/`StandardError` gaps, glued by `plat` -- this example no
# longer declares or links a single libc `extern`.

import simplemodule;
import mymodule;
import mymodule::thing::something2;
# Resolved externally -- scanned (its signatures are fully known here) but
# never compiled by this process; `examples/extern_lib/mathlib.omg` is
# compiled by its own, separate `omgc` invocation and linked in afterward:
#   omgc examples/dev/main.omg --extern=mathlib:examples/extern_lib/mathlib.omg -o target/main.o
#   omgc examples/extern_lib/mathlib.omg -o target/mathlib.o
#   cc target/main.o target/mathlib.o -o hello
import extern::mathlib;
import cycle_a::cycle_a_value;
import cycle_b::unrelated_b;
# `core` is an ambient prelude for *types* (`Writer` needs no import), but a
# free function still has to be imported by name.
import extern::core::fmt::write_uint;


# Kept at exactly `(s: *str) => i32` so `Interface::do_thing` and the
# `call_each$` macro demo still exercise a function *value*, the way they did
# when that value was libc's own `puts`.
put_line(s: *str) => i32 {
    println$(s);
    0
}

# Addresses read better in hex than decimal, and `print$`/`println$` are
# deliberately concatenative with no format specifiers -- so this drops to the
# `Writer` API directly, which is what those macros expand to anyway.
put_addr(label: *str, address: u64) => void {
    mut buf: [64]u8;
    mut w := Writer::stdout_buffered(&mut buf[0..]);
    w.write_str(label);
    w.write_str("0x");
    write_uint(&mut w, address, 16u32);
    w.newline();
    w.flush();
}

show_sum(a: i32, b: i32, c: i32) => void {
    println$("macro arg list: ", a, " + ", b, " = ", c);
}


enum CryptographicAlgorithm(exposed name: *str, exposed variants: *[?]*str) {
    AES("AES", &["128", "192", "256"]),
    RSA("RSA", &["2048", "3092", "4096"])
}

# A fixed-length array header field: unlike `variants` above (a compile-time
# *slice*, a `[ptr, len]` fat pointer written with `&[...]`), `top_movies`
# has no indirection at all -- its 3 elements live inline, directly in the
# enum's own header region, written as a bare `[...]` (no `&`, since there's
# no address being taken). Every variant supplies exactly 3 elements; the
# length is part of the field's declared type, not a per-variant choice.
enum MovieCategory(exposed description: *str, exposed top_movies: [3]*str) {
    Action("Action-packed movies", ["Some Action Movie 1", "Some Action Movie 2", "Super Action Movie"]),
    Horror("Scary movies", ["Horror Movie 1", "Horror Movie 2", "Super Scary Movie"]),
}

classify(n : i32) => *str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

abs_val(n : i32) => i32 {
    if n < 0 { -n } else { n }
}

sum_for(n : i32) => i32 {
    mut total := 0;
    for mut i := 0; i < n; ++i {
        total = total + i;
    }
    return total;
}

first_even_ge(n : i32) => i32 {
    mut i := n;
    while true {
        if i % 2 == 0 {
            break;
        }
        ++i;
    }
    return i;
}

sum_skip_multiples_of_3(n : i32) => i32 {
    mut total := 0;
    for mut i := 1; i <= n; ++i {
        if i % 3 == 0 {
            continue;
        }
        total = total + i;
    }
    return total;
}

struct Interface {
    exposed do_thing: (s : *str) => i32;
    exposed member_function(*self) => void {
        self.do_thing("You called the member function");
    }
}

fibo(n: i32) => i32 {
    if n <= 1 {
        return n;
    }

    fibo(n - 2) + fibo(n - 1)
}

struct MyNode<T> {
    exposed value: T;
    exposed next: *MyNode<T>;
}

defer_test() => void {
    println$("defer test");
    # must print in reverse order (FILO)
    defer { println$("first"); }
    defer { println$("second"); println$("followup of second"); }
    defer { println$("third"); }
}

# A struct with both static and member functions: a function declared
# *without* `self` is static -- called through the struct's name
# (`Vec2::origin()`), with no instance -- while one *with* `self` stays an
# ordinary member function. Static bodies commonly build their result with
# a struct literal (see `Vec2 { x = ...; y = ...; }` below), which must set
# every field exactly once.
struct Vec2 {
    exposed x: i32;
    exposed y: i32;
    exposed origin() => Vec2 {
        Vec2 {
            x = 0;
            y = 0;
        }
    }
    exposed new(x: i32, y: i32) => Vec2 {
        Vec2 { x = x; y = y; }
    }
    # Plain `self` -- a by-value copy, cheap here (two `i32`s) and never
    # observable to the caller even if this body reassigned it; only ever
    # reads, so a copy vs. a pointer makes no difference either way.
    exposed manhattan(self) => i32 {
        abs_val(self.x) + abs_val(self.y)
    }
    # `*mut self` -- a pointer to the caller's own `Vec2`, mutable pointee,
    # is what lets a method write back to fields the caller actually sees.
    # Calling it requires a mutable place (`v.translate(...)` needs `v`
    # itself declared `mut`; see `main`). Contrast with plain `mut self`
    # (by value): that would only mutate a local copy, invisible to the
    # caller once the call returns -- see `Vec2ByValue` below for exactly
    # that comparison.
    exposed translate(*mut self, dx: i32, dy: i32) => void {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }
    # Method overloading: distinguished by parameter type exactly like a
    # free function's (see `print_any`/`print_number2` below) -- an
    # unsuffixed literal argument (`v.scale(3)`) picks whichever candidate
    # it fits, preferring its own default type when more than one would fit.
    exposed scale(*mut self, factor: i32) => void {
        self.x = self.x * factor;
        self.y = self.y * factor;
    }
    exposed scale(*mut self, factor: f64) => void {
        println$("scale: f64 overload called");
    }
}

# Demonstrates by-value `self` vs. by-pointer `self` side by side on
# otherwise-identical structs: `gets_copy`/`gets_mutable_copy` never affect
# the caller's own value, no matter how they're called (through a plain
# value or through a pointer -- both auto-adapt, see `main`); only
# `gets_mutable_pointer` does.
struct Vec2ByValue {
    exposed x: i32;
    exposed y: i32;
    exposed gets_copy(self) => i32 {
        self.x + self.y
    }
    exposed gets_mutable_copy(mut self) => void {
        self.x = 999;
        self.y = 999;
    }
    exposed gets_pointer(*self) => i32 {
        self.x + self.y
    }
    exposed gets_mutable_pointer(*mut self) => void {
        self.x = 999;
        self.y = 999;
    }
    # Overloading on `self`'s mode is legal as long as the *other*
    # parameters differ too -- a call site disambiguates on `abc` alone,
    # never on how `self` happens to be received.
    exposed do_thing(self, abc: i32) => i32 {
        self.x + abc
    }
    exposed do_thing(*self, abc: *str) => i32 {
        put_line(abc);
        self.x
    }
}

# A struct-typed field, initialized below both by a nested literal and by an
# already-built value -- literals nest like any other expression.
struct Segment {
    exposed a: Vec2;
    exposed b: Vec2;
}

# A whole struct passed *by value* (not through a pointer like `self`) --
# flattened into one scalar argument per field at the call site.
vec_sum(v: Vec2) => i32 {
    v.x + v.y
}

# The most basic omega-style enum: no header, so the tag is implicit -- an
# auto-incrementing u16 starting at 0. Even then, every value exposes it as
# `value.tag`.
enum MyBasicEnum {
    First,  # tag: 0
    Second, # tag: 1
    Third;  # tag: 2
}

# A header: fields present on *every* variant, whose values are per-variant
# constants supplied Java-style in each variant's `(...)` -- baked in at the
# definition, constant forever (`value.description` works on any variant,
# and can never be assigned).
enum MyEnumWithHeader(exposed description: *str, exposed some_number: u32) {
    First("This is the first variant", 10),
    Second("This is the second variant", 25),
    Third("This is the third variant", 30);
}

# Variant bodies: fields only *that* variant has. At runtime the body region
# is a union of all the bodies, but the type system only ever exposes the
# body of the variant a value provably is: `E::Second { ... }` produces a
# value statically known to be `Second` (its type reads `E::Second`), which
# is what makes `.some_text` compile -- and `.some_number` not. The
# refinement never survives indirection: through `*MyEnumWithBodies` only
# the tag and header remain accessible.
enum MyEnumWithBodies {
    First,
    Second { exposed some_text: *str; }
    Third { exposed some_number: u16; exposed pointer_to_another_instance: *MyEnumWithBodies; }
}

# Shared *dynamic* fields (declared right after `{`, before the first
# variant): present on every variant like a header field, so no variant
# refinement is needed to reach them (`self.favorite_number` below works
# for any variant) -- but unlike a header field, they're ordinary
# per-instance storage, not a per-variant constant: every construction site
# supplies them, and they're freely assignable afterward, exactly like a
# variant's own body field (contrast with `description`, a real header
# field -- fixed forever once a variant is built).
enum MyEnumWithSharedDynamicFields(exposed description: *str) {
    exposed favorite_number: i32;
    exposed favorite_color: *str;

    First("This is the first variant"),
    Second("This is the second variant") {
        exposed specific_field: i32;
    },
    Third("This is the third variant");

    exposed print_favorite_number_and_color(*self) => void {
        println$("my favorite number is ", self.favorite_number, " and my favorite color is ", self.favorite_color);
    }
}

# An explicit tag: `tag` leads the header with the integer type of your
# choice, and each variant supplies its own (unique, compile-time-constant)
# value first.
enum MyEnumWithExplicitTagAndHeader(tag: u32, exposed description: *str) {
    First(10, "This is the first entry"),
    Second(20, "This is the second entry"),
    Third(30, "This is the third entry");
}

# Generic enums instantiate exactly like generic structs; expression paths
# take explicit arguments here (`Optional<u32>::Some { ... }`).
#
# `is_some` demonstrates a method on a generic enum -- `match self { ... }`
# works exactly like it does for a non-generic enum, since `T` is already a
# concrete, fully resolved type by the time this method's own body is
# checked (one independent instantiation per concrete `T` actually used,
# same as everywhere else in this language's generics).
enum Optional<T> {
    None,
    Some { exposed value: T; };

    exposed is_some(*self) => bool {
        match self {
            Optional::None => { false }
        } else {
            true
        }
    }
}

# Everything at once, plus functions after the `;` ending the variant list
# (Java-style): with `self` = member function, without = static.
enum MyCoolEnum(tag: i16, exposed description: *str) {
    Bad(-1, "Something went wrong :("),
    First(0, "This is the first value") {
        message: *str;
    },
    Second(1, "This is the second value") {
        exposed number: u64;
        exposed decimal: f64;
    },
    Third(2, "This is the third value");

    exposed print_description(*self) => void {
        # `self.description` is `*str`, a length-carrying fat pointer with no
        # null terminator -- which is exactly what `core::io` wants. The
        # length is already part of the value, so printing it is one
        # `Display` call with no cast, no terminator scan, and no chance of
        # reading past the end. (This used to need C's `%.*s` and a
        # `<*u8>` length-drop; both are gone with `printf`.)
        println$(self.description);
    }
    exposed default() => MyCoolEnum {
        MyCoolEnum::Third
    }
}

# A whole enum passed by value -- same flattening story as `vec_sum`, plus
# the opaque payload chunks the union region travels as.
cool_tag(e: MyCoolEnum) => i16 {
    e.tag
}

# Sum-type subtyping through proofs: a variant is itself a subtype of its
# enum, so a function can take a pointer to one exact variant directly --
# no helper struct, no destructuring -- and access that variant's own body
# fields right away. Calling this requires the compiler to have already
# proved its argument is specifically `Second`, either by construction
# (`x := MyEnumWithBodies::Second { ... }`) or by `match`.
print_second_text(x: *MyEnumWithBodies::Second) => void {
    println$("variant-specific field access: ", x.some_text);
}

# Matching through an existing pointer: proving `b` is `Second` narrows `b`
# itself (a `*MyEnumWithBodies`) to `*MyEnumWithBodies::Second`, so it can
# be passed straight into `print_second_text` -- no `&`, no destructuring.
# Outside the matched arm (and in `else`), `b` stays a plain
# `*MyEnumWithBodies` -- only the tag is reachable there.
describe_if_second(b: *MyEnumWithBodies) => void {
    match b {
        MyEnumWithBodies::Second => {
            print_second_text(b);
        }
    } else {
        println$("not the Second variant (tag=", b.tag, ")");
    }
}

# A union: every field overlaps the same storage -- no tag, no compiler
# proof, unlike an enum variant body. Constructed by setting exactly one
# field (`Value { as_i32 = ...; }`); any field is then readable at any time,
# freely reinterpreting whatever bytes are actually there.
union Value {
    exposed as_i32: i32;
    exposed as_f32: f32;
}

# --- Specs: interfaces/traits, with both static and dynamic dispatch ---

enum AnimalKind {
    Dog, Cat, Wolf
}

# A spec is a function-only contract: `kind`/`make_sound` are *required*
# (every implementor must provide its own matching method); `is_dog`/
# `same_kind` are *defaults* (used as-is unless a concrete implementor
# overrides them -- see `Cat` below, which overrides `is_dog`). `Self`
# inside a default body means "whatever concrete type is implementing
# this spec" -- `other: *Self` in `same_kind` becomes `*Dog` for `Dog`'s
# own instantiation of this default, `*Cat` for `Cat`'s, and so on.
#
# Spec functions always receive `self` by pointer (`*self`/`*mut self`) --
# by-value self is rejected here at the spec's own definition, since `spec
# *T` dynamic dispatch (see `make_sound_with_dynamic_dispatch` below) erases
# the concrete type down to a bare data pointer with no way to carry a
# by-value copy.
exposed spec Animal {
    kind(*self) => AnimalKind;
    make_sound(*self) => *str;
    is_dog(*self) => bool {
        self.kind().tag == AnimalKind::Dog.tag
    }
    same_kind(*self, other: *Self) => bool {
        self.kind().tag == other.kind().tag
    }
}

struct Dog : Animal {
    exposed id: i32;
    exposed kind(*self) => AnimalKind { AnimalKind::Dog }
    exposed make_sound(*self) => *str { "woof woof" }
}

struct Cat : Animal {
    exposed id: i32;
    exposed kind(*self) => AnimalKind { AnimalKind::Cat }
    exposed make_sound(*self) => *str { "meow" }
    # Overrides the default: a cat is never a dog, no matter what its own
    # (never actually called through this override) `kind()` says.
    exposed is_dog(*self) => bool { false }
}

# A spec with no dependencies of its own, purely to demonstrate one:
# `Mammal` below requires both `Animal` and `Dummy`.
exposed spec Dummy {
    dummy(*self) => void;
    something_else(*self) => void {
        self.dummy();
        println$("something else");
    }
}

# `: Animal, Dummy` -- a spec may itself depend on other specs; an
# implementor of `Mammal` must satisfy all three specs' requirements
# (`Mammal`'s own, plus `Animal`'s and `Dummy`'s), and `Mammal`'s own
# defaults may freely call functions from either dependency on `self`.
# `Mammal`'s own `dummy` also demonstrates a spec satisfying one of its
# own dependencies' requirements (`Dummy`'s bare `dummy`) with a default
# of its own -- an implementor of `Mammal` never has to provide `dummy`
# itself.
exposed spec Mammal : Animal, Dummy {
    dummy(*self) => void {
        println$("i satisfied the dummy function");
    }
    call_something_else(*self) => void {
        self.something_else();
    }
}

# A pure alias: "implements `MySpec`" means "implements both `Dummy` and
# `Mammal`" -- nothing declared here of its own.
spec MySpec = Dummy | Mammal;

# A generic spec forwarding its own still-abstract generic parameter into a
# dependency's type arguments (`Labeled<T> : Container<T>`) -- `Container`'s
# `get` requirement is only resolved once a concrete implementor's `T` is
# known (here, `Score`'s own `i32`), exactly like a spec's own functions
# already were. `Score` never overrides `describe` itself, so the compiler
# must synthesize it from `Labeled`'s own default body, which calls
# `self.get()` -- a requirement `Score` only actually satisfies through the
# forwarded `Container<i32>` dependency.
exposed spec Container<T> {
    get(*self) => T;
}
exposed spec Labeled<T> : Container<T> {
    describe(*self) => T { self.get() }
}

struct Score : Labeled<i32> {
    exposed value: i32;
    exposed get(*self) => i32 { self.value }
}

struct Wolf : Mammal {
    exposed id: i32;
    exposed kind(*self) => AnimalKind { AnimalKind::Wolf }
    exposed make_sound(*self) => *str { "howl" }
}

# Static dispatch: `T: Animal` is monomorphized once per concrete `T`
# actually used below -- a real, independently compiled copy per type, not
# a shared/erased body -- so `animal.make_sound()` resolves directly
# against whichever concrete type this particular instantiation was built
# for, exactly like any other generic function/struct in this file.
make_sound_with_static_dispatch<T: Animal>(animal: *T) => void {
    println$(animal.make_sound());
}

# Dynamic dispatch: `animal`'s concrete type is erased -- a runtime fat
# pointer (a data pointer plus a compiler-generated vtable pointer) picks
# the right `make_sound` at the call site, inside this one function body,
# which is compiled exactly once regardless of how many concrete types
# ever get passed to it.
make_sound_with_dynamic_dispatch(animal: spec *Animal) => void {
    println$(animal.make_sound());
}

# A spec-alias bound: `T: MySpec` requires every function `Dummy`/`Mammal`
# (and their own dependencies) demand, all at once.
accepts_myspec<T: MySpec>(value: *T) => void {
    value.call_something_else();
}

# Function overloading, resolved by parameter count and type. An unsuffixed
# literal argument is free to adapt to whichever candidate it fits (see the
# untyped-constant inference this builds on) as long as that candidate is
# the *unique* best match: `print_any(10)` only fits `u32` here (an int
# literal never adapts to `*str`/`f64`), so it's picked with no ambiguity
# even though it isn't `10`'s own default type.
print_any(thing: *str) => void {
    println$("print_any: string '", thing, "'");
}
print_any(thing: u32) => void {
    println$("print_any: u32 ", thing);
}
print_any(thing: f64) => void {
    println$("print_any: f64 overload called");
}

# Two overloads distinguished purely by which type an unsuffixed literal's
# own *default* is: `10`'s default is `i32`, so this candidate wins
# outright over `u32` (which could also technically hold it, just not for
# free) -- see `AmbiguousOverload`'s doc comment for the case where no
# candidate's default matches (rejected, not guessed).
print_number2(n: i32) => void {
    println$("print_number2: i32 ", n);
}
print_number2(n: u32) => void {
    println$("print_number2: u32 ", n);
}

@layout(pack = sizeof<usize>, align = sizeof<usize>)
struct CLikePacking {
    thing: u8;
    exposed longthing: usize;
    another_thing: u8;
}

# omega structs are packed by default
struct Packed {
    thing: u8;
    exposed longthing: usize;
    another_thing: u8;
}

@layout(pack = sizeof<usize>, align = sizeof<usize>)
enum EnumWithCLikePacking(tag: u8, exposed longthing: usize, another_thing: u8) {
    First(1, 123, 4),
    Second(2, 456, 7),
    Third(3, 789, 10)
}

struct MyVisibilityTest {
    exposed number : i32;
    internal text : *str;
    hidden_number: u32;

    exposed new() => Self {
        Self { number = 10; text = "this is the internal text field"; hidden_number = 42; }
    }

    print_hidden_number(*self) => void {
        print$("hidden number: ", self.hidden_number);
    }
}

receives_any_optional<T>(abc: Optional<T>) => void {
    match abc {
        Optional::None => { println$("IS None!!!"); }
    } else {
        println$("IS Some(T)!!!");
    }
}

marker MyZst {
    hello() => void {
        println$("MyZst::hello called!");
    }
}

main(argc : i32, argv : *[]*u8) => i32 {
    mut mynode1 : MyNode<i32>;
    mynode1.value = 20;

    mut mynode0 : MyNode<i32>;
    mynode0.value = 69;
    mynode0.next = &mynode1;

    println$("mynode0.value = ", mynode0.value);
    println$("mynode0.next.value = ", mynode0.next.value);

    mut iface : Interface;
    iface.do_thing = put_line;
    iface.do_thing("HELLO WORLD");
    iface.do_thing("");
    iface.member_function();
    mut ptr : *Interface;
    ptr = &iface;
    (*ptr).member_function();
    ptr.member_function();

    mut a := 5;
    mut b := 10;
    mut c := a + b;
    print$(a, " + ", b, " = ", c);
    println$();

    # this is a single line comment
    a = 10;
    b = 3; # this is also a comment
    c = a * b;
    print$(a, " * ", b, " = ", c);
    println$();

    ##### this is a
    multine ###
       ##comment #####

    arr : [3]i32 = [1, 2, 3];
    arr2 := [1, 2, 3];
    mut slice := &arr[1..];
    println$("array second item: ", slice[0]);
    println$("slice len: ", slice.length);
    slice = &arr[0..];
    println$("slice len: ", slice.length);
    slice = &arr[0..<2];
    println$("exclusive-end slice len: ", slice.length);
    slice = &arr[0..=1];
    println$("inclusive-end slice len: ", slice.length);

    big : i64 = 5_000_000_000i64;
    big2 := big + 1i64;
    println$("i64: ", big2);

    ubig : u64 = 0xFFFFFFFFFu64;
    println$("u64 (hex): ", ubig);

    oct := 0o755;
    println$("octal 0o755 = ", oct);

    bin := 0b1010;
    println$("binary 0b1010 = ", bin);

    small : u8 = 0xC8u8;
    small2 := small + 5u8;
    println$("u8: ", small, ", ", small2);

    pi : f64 = 3.14159;
    half : f32 = 0.5f32;
    sum_f32 := half + half;
    println$("f64: ", pi, ", f32: ", half, ", f32 sum: ", sum_f32);

    flag := true;
    println$("bool: ", flag);

    letter := 'A';
    println$("char codepoint: ", letter);

    neg_i64 := -big2;
    neg_f64 := -pi;
    println$("negated: ", neg_i64, ", ", neg_f64);

    q := big2 / 3i64;
    r := big2 % 3i64;
    println$("i64 div/rem: ", q, " ", r);

    println$("classify(-5) = ", classify(-5));
    println$("classify(0) = ", classify(0));
    println$("classify(5) = ", classify(5));
    println$("abs_val(-7) = ", abs_val(-7));
    println$("sum_for(10) = ", sum_for(10));
    println$("first_even_ge(7) = ", first_even_ge(7));
    println$("sum_skip_multiples_of_3(10) = ", sum_skip_multiples_of_3(10));

    mut total := 0;
    mut i := 0;
    while i < 10 {
        total = total + i;
        ++i;
    }
    println$("while sum_to(10) = ", total);

    for mut j := 5; j > 0; --j {
        println$("countdown: ", j);
    }

    x := 3;
    y := 3;
    println$("3 == 3: ", x == y, ", 3 != 3: ", x != y, ", 3 <= 3: ", x <= y, ", 3 >= 4: ", x >= 4);

    testvar1 := if x < 3 {
        "lower than 3"
    } else {
        "not lower than 3"
    };
    println$("testvar1: ", testvar1);

    # `match` also works as an ordinary value/range switch, standardized on
    # the same range grammar slicing uses: `..<` excludes its end, `..=`
    # includes it. A bare `..` (no end at all, ever) infers its own bounds
    # from whatever's left uncovered by the other arms -- here, exactly
    # `[101, u32::MAX]`, so no `else` is needed -- the compiler verifies
    # that coverage itself.
    matched_num := 100u32;
    message := match matched_num {
        0..<100 => "less than a hundred",
        100 => "a hundred",
        .. => "more than a hundred",
    };
    println$("match on value: matched_num=", matched_num, " is ", message);

    mod_a := simplemodule::something3(5);
    mod_b := mymodule::something1();
    mod_c := mymodule::thing::something2();
    mod_d := something2();
    println$("modules: ", mod_a, " ", mod_b, " ", mod_c, " ", mod_d);
    println$("fibo(20) = ", fibo(20));
    println$("forward_declared_fn() = ", forward_declared_fn());

    mut head : Node;
    head.value = 1;
    mut mid : Node;
    mid.value = 2;
    mut tail : Node;
    tail.value = 3;
    tail.next = &head; # arbitrary, just to prove `next` is a real, usable *Node
    head.next = &mid;
    mid.next = &tail;
    println$("linked list: ", head.value, " -> ", head.next.value, " -> ", head.next.next.value);

    mut gp : GenericPair<i32>;
    gp.a = 3;
    gp.b = 4;
    println$("generic pair sum: ", sum_generic(gp.a, gp.b));
    println$("generic sum (f64): ", sum_generic(1.5, 2.5));
    println$("generic pair method sum: ", gp.sum());
    println$("generic pair T-deduced sum: ", sum_pair(gp));

    # `T` inferred from the literal's own field values -- no `<i32>`
    # written anywhere, unlike `gp` above. See `GenericPair`'s own doc
    # comment further down for how field-driven inference works.
    gp2 := GenericPair { a = 5; b = 6; };
    println$("generic pair (inferred T) sum: ", gp2.sum());

    # Deep inference: `T` deduced from a *static function call's* own
    # argument types (`GenericPair::new`, no `<i32>` anywhere) -- composes
    # the same duck-typed unification across the owner/function boundary.
    gp3 := GenericPair::new(7, 8);
    println$("generic pair (static new, inferred T) sum: ", gp3.sum());

    mut gn : GenericNode<i32>;
    gn.value = 7;
    mut gn2 : GenericNode<i32>;
    gn2.value = 8;
    gn.next = &gn2;
    println$("generic linked list: ", gn.value, " -> ", gn.next.value);

    # `T` deduced from nothing but `DefaultList`'s own declared default --
    # there is no argument anywhere for ordinary inference to use.
    dl := DefaultList::new();
    println$("default list (T=i32 via default): ", dl.value);

    # `A` explicit (`<u64>`), `B` omitted -- defaults to matching `A`, i.e.
    # `u64`, not to `DefaultPair`'s own declaration order picking anything
    # else.
    dp := DefaultPair<u64>::new(1, 2);
    println$("default pair (B defaulted to A=u64): ", dp.a, ", ", dp.b);

    # Precedence, worked through explicitly:
    #  - neither argument has its own explicit type, so `T` falls back to
    #    its declared default (`u64`) rather than plain inference's own
    #    untyped-literal default (`i32`).
    sum_defaulted := add_defaulted(10, 20);
    println$("add_defaulted(10, 20) (T=u64 via default): ", sum_defaulted);

    #  - `a`'s own explicit `u32` suffix outranks the default outright, and
    #    `b`'s bare `20` then adapts to that already-pinned `T`, not to its
    #    own untyped-literal default.
    sum_defaulted2 := add_defaulted(10u32, 20);
    println$("add_defaulted(10u32, 20) (T=u32 via explicit arg): ", sum_defaulted2);

    # `add_defaulted(10, 20u32)` would be a compile error here: `a` pins
    # `T` to `u64` via the default before `b` is even looked at, so `b`'s
    # own explicit `u32` then conflicts instead of winning -- explicit only
    # outranks a default on the argument that actually carries it.

    su : usize = 7usize;
    si : isize = -2isize;
    println$("usize: ", su, ", isize: ", si);

    println$("macro sum: ", sum_macro$(3, 4));
    call_each$(put_line, "macro each: one", "macro each: two");
    call_with_args$(show_sum, 3, 4, 7);

    mut pt : Point;
    pt.x = 3;
    pt.y = 4;
    println$("macro point magnitude_sq: ", pt.magnitude_sq());

    println$("defer_demo(true) = ", defer_demo(true));
    println$("defer_demo(false) = ", defer_demo(false));
    defer_test();

    mut v := Vec2 { x = 3; y = -4; };
    println$("struct literal: (", v.x, ", ", v.y, ")");
    v.translate(2, 6);
    println$("translated: (", v.x, ", ", v.y, ")");
    o := Vec2::origin();
    println$("static call: (", o.x, ", ", o.y, ")");
    w := Vec2::new(7, 9);
    println$("static call with args: (", w.x, ", ", w.y, "), manhattan = ", w.manhattan());
    println$("struct by value: vec_sum = ", vec_sum(w));
    seg := Segment {
        a = Vec2 { x = 1; y = 2; };
        b = w;
    };
    println$("nested literal: (", seg.a.x, ",", seg.a.y, ")-(", seg.b.x, ",", seg.b.y, ")");
    if v.manhattan() > 5 {
        p := simplemodule::Pair::of(4, 5);
        println$("cross-module static: ", p.sum());
    }

    # By-value vs. by-pointer `self`: a by-value method's mutation is never
    # observed by the caller, no matter how it's called -- only a
    # by-pointer *mutable* method's mutation is.
    mut vbv := Vec2ByValue { x = 1; y = 2; };
    before := vbv.gets_copy();
    vbv.gets_mutable_copy();
    after_mut_by_value := vbv.gets_copy();
    vbv.gets_mutable_pointer();
    after_mut_by_pointer := vbv.gets_copy();
    println$("self modes: before=", before, " after-mut-by-value=", after_mut_by_value, " (unchanged) after-mut-by-pointer=", after_mut_by_pointer, " (changed)");

    # Call-site auto-adaptation: a plain value auto-refs into a by-pointer
    # method, and a pointer auto-derefs-and-copies into a by-value method --
    # both directions work no matter which one `self` actually declares.
    vbv_ptr := &vbv;
    println$("auto-adapt: value->value=", vbv.gets_copy(), " value->pointer=", vbv.gets_pointer(), " pointer->value=", vbv_ptr.gets_copy(), " pointer->pointer=", vbv_ptr.gets_pointer());

    # Overloading on self's mode alone is illegal (see `Ghi` below, which
    # doesn't compile) -- but legal as soon as another parameter differs
    # too, disambiguated purely by `abc`'s type, never by self's mode.
    println$("self-mode overload: ", vbv.do_thing(10), " ", vbv.do_thing("hi"));

    e1 := MyBasicEnum::First;
    e2 := MyBasicEnum::Third;
    println$("enum tags: ", e1.tag, " ", e2.tag);

    h := MyEnumWithHeader::Second;
    println$("enum header: tag=", h.tag, " desc=", h.description, " number=", h.some_number);

    s := MyEnumWithBodies::Second { some_text = "hello, this is some text"; };
    println$("enum body: tag=", s.tag, " text=", s.some_text);
    t := MyEnumWithBodies::Third { some_number = 777u16; pointer_to_another_instance = &s; };
    println$("enum body2: tag=", t.tag, " n=", t.some_number, " inner_tag=", t.pointer_to_another_instance.tag);

    # Sum-type subtyping: `s`'s own inferred type is `MyEnumWithBodies::Second`
    # (permanently, since it was never widened by an explicit plain type
    # annotation), so `&s` stays refined and can be passed directly where a
    # variant-specific pointer is expected -- no `match` needed here, the
    # proof already happened at construction.
    print_second_text(&s);

    # `match` proves it instead, for a value whose *static* type is plain:
    # `describe_if_second` only ever sees `*MyEnumWithBodies`, and proves
    # which variant it's holding at runtime via the tag.
    describe_if_second(&s);
    describe_if_second(&t);

    # `match` as an expression: exhaustive over every variant, no `else`
    # needed since all three are covered.
    kind := match s {
        MyEnumWithBodies::First => "first",
        MyEnumWithBodies::Second => "second",
        MyEnumWithBodies::Third => "third",
    };
    println$("match as expression: ", kind);

    # Shared dynamic fields: every construction site supplies them (even
    # `First`, which has no body fields of its own), and a shared method
    # can read them without proving the variant.
    shared_first := comp MyEnumWithSharedDynamicFields::First {
        favorite_number = 10;
        favorite_color = "green";
    };
    shared_second := MyEnumWithSharedDynamicFields::Second {
        favorite_number = 20;
        favorite_color = "blue";
        specific_field = 99;
    };
    shared_first.print_favorite_number_and_color();
    shared_second.print_favorite_number_and_color();
    println$("shared dynamic fields: description=", shared_first.description, "/", shared_second.description, " specific_field=", shared_second.specific_field);

    # Unlike a header field, a shared dynamic field is genuinely mutable --
    # an ordinary assignment through it, exactly like a body field's.
    mut shared_mut := MyEnumWithSharedDynamicFields::Third {
        favorite_number = 1;
        favorite_color = "red";
    };
    shared_mut.favorite_number = 42;
    println$("shared dynamic field mutated: ", shared_mut.favorite_number);

    xt := MyEnumWithExplicitTagAndHeader::Third;
    println$("enum explicit: tag=", xt.tag, " desc=", xt.description);

    # `core::option::Option` itself (not the locally-defined `Optional`
    # above), referenced with no `import core::option;` at all -- the
    # ambient `core` fallback (see `context::ambient_core_path`) now
    # applies uniformly to inferred/omitted generic arguments too, not
    # just explicit ones (`Option<i32>::Some { ... }` already worked
    # ambiently before this).
    ambient_some := Option::Some { value = 5i32; };
    ambient_none : Option<i32> = Option::None;
    match ambient_some {
        Option::None => { println$("ambient Option: unexpected None"); },
        Option::Some => {
            println$("ambient Option: some(value=", ambient_some.value, ")");
        },
    };
    match ambient_none {
        Option::None => { println$("ambient Option: none as expected"); },
        Option::Some => { println$("ambient Option: unexpected Some"); },
    };

    opt := Optional<u32>::Some { value = 42u32; };
    none := Optional<u32>::None;
    println$("enum generic: some(tag=", opt.tag, " value=", opt.value, ") none(tag=", none.tag, ")");
    println$("enum generic method: opt.is_some()=", opt.is_some(), " none.is_some()=", none.is_some());

    # Generic argument inference: `Optional::Some { ... }` (no `<u32>`)
    # deduces `T` from the field value's own type, the same duck-typed
    # unification a generic function call's arguments already get; a bare
    # `Optional::None` (no fields at all to look at) instead deduces `T`
    # from the `Optional<u32>` the declaration below already names.
    opt_inferred := Optional::Some { value = 7u32; };
    none_inferred : Optional<u32> = Optional::None;
    println$("enum generic (inferred T): some(tag=", opt_inferred.tag, " value=", opt_inferred.value, ") none(tag=", none_inferred.tag, ")");
    println$("enum generic T-deduced: describe_some(&opt)=", describe_some(&opt), " describe_some(&none)=", describe_some(&none));

    cool := MyCoolEnum::Second { number = 123u64; decimal = 2.5; };
    println$("enum cool: tag=", cool.tag, " number=", cool.number, " decimal=", cool.decimal);
    cool.print_description();
    dflt := MyCoolEnum::default();
    dflt.print_description();
    println$("enum by value: ", cool_tag(dflt));

    mut anyvariant : MyCoolEnum = MyCoolEnum::Bad;
    println$("enum widened: tag=", anyvariant.tag);
    anyvariant = dflt;
    picked := if anyvariant.tag > 0i16 { MyCoolEnum::Bad } else { MyCoolEnum::Third };
    println$("enum picked: ", picked.description);

    st := simplemodule::Status::make_err(42);
    println$("cross-module enum: tag=", st.tag, " label=", st.label);
    okst := simplemodule::Status::Ok;
    err := simplemodule::Status::Err { code = 7; };
    println$("cross-module enum 2: ok=", okst.tag, " err_code=", err.code);

    # A union's fields overlap the same storage: written as `as_i32`, read
    # back as `as_f32` -- exactly the bit pattern of pi as an IEEE-754 f32.
    val := Value { as_i32 = 1078530011; };
    println$("union overlap: as_i32=", val.as_i32, " as_f32=", val.as_f32);

    # `<Type>expr` casts: a numeric conversion (real width/signedness-aware
    # codegen, not just relabeling) and a pointer reinterpretation.
    ci := 10;
    cf := <f32>ci;
    println$("cast i32->f32: ", ci, " -> ", cf);

    thing := Vec2::new(11, 22);
    thing_ptr := &thing;
    void_ptr := <*void>thing_ptr;
    back := <*Vec2>void_ptr;
    println$("cast pointer roundtrip: (", back.x, ", ", back.y, ")");

    # Untyped-constant inference: an unsuffixed literal adapts to whatever
    # concrete type context expects, as long as the *kind* still matches
    # (an int-kind literal never becomes a float, only a same-kind width/
    # signedness adapts -- `coerced_wrong : f64 = 10;` would still error).
    coerced_u64 : u64 = 10;
    coerced_f64 : f64 = 10.0;
    coerced_f32 : f32 = 10.0;
    coerced_neg : i8 = -100;
    coerced_arr : [3]u64 = [1, 2, 3];
    coerced_branch := if coerced_u64 > 5u64 { 5u64 } else { 10 };
    println$("literal coercion: u64=", coerced_u64, " f64=", coerced_f64, " f32=", coerced_f32, " neg=", coerced_neg, " arr[2]=", coerced_arr[2], " branch=", coerced_branch);

    # The identical adaptation, now inside a binary-op operand rather than a
    # declaration's own initializer: an outer `expected` (here, `mut narrow_u:
    # u32`'s own type, threaded through the assignment) reaches both of `+`'s
    # operands, and a comparison's left operand (already concretely `i64`)
    # becomes the anchor its own right operand's bare `0` adapts to -- neither
    # bare literal defaults to `i32` and then mismatches, the way it used to.
    mut narrow_u : u32 = 0;
    narrow_u = narrow_u + 1;
    narrow_i : i64 = -7;
    narrow_abs := if narrow_i < 0 { -narrow_i } else { narrow_i };
    println$("binary-op literal narrowing: narrow_u=", narrow_u, " narrow_abs=", narrow_abs);

    print_any("hello");
    print_any(10);
    print_any(10.0);
    print_number2(10);

    mut scaled := Vec2::new(2, 3);
    scaled.scale(3);
    println$("method overload: (", scaled.x, ", ", scaled.y, ")");

    # A typed declaration annotation uniquely disambiguates which overload
    # of `print_number2` is meant -- `print_number2_ref2 := print_number2;`
    # (no annotation) would stay ambiguous, since nothing pins down which
    # candidate is intended.
    print_number2_ref : (n: u32) => void = print_number2;
    print_number2_ref(7u32);

    # Literal inference now always anchors on the *earliest* element --
    # here, branch 0's own explicit `u16` decides the whole `if`'s type, and
    # the later unsuffixed `8` adapts to match it, never the other way
    # around (`if true { 8 } else { 7u16 }` would now be a type mismatch:
    # branch 0's default `i32` doesn't retroactively become `u16`).
    earliest_wins := if true { 7u16 } else { 8 };
    println$("earliest-wins if: ", earliest_wins);

    # `&`/`&mut` make a slice's mutability explicit -- an immutable slice
    # and a mutable slice can both be taken from the same `mut` array, and
    # writing through the mutable one is visible through the array itself.
    mut sliceable := [10, 20, 30];
    imm_view := &sliceable[0..];
    mut_view := &mut sliceable[0..];
    mut_view[0] = 99;
    println$("slice mutability: imm[0]=", imm_view[0], " mut[0]=", mut_view[0], " array[0]=", sliceable[0]);

    # A binary string literal -- `*[?]u8` (a slice, not `*u8`), no null
    # terminator, its length known at compile time.
    bytes : *[?]u8 = b"binary string here";
    println$("byte string: len=", bytes.length, " first=", <i32>bytes[0]);

    # `*str`: a UTF-8 string slice, distinct from `*[?]u8` even though both
    # are the exact same `[data_ptr, len]` fat pointer at runtime -- no
    # implicit coercion either way (see `ResolvedType::Str`). Every
    # `"..."` literal is one of these now.
    greeting : *str = "hello, omega";
    println$("str: size=", greeting.size);

    # Byte indexing and range-slicing both work exactly like `*[?]u8` does
    # (symmetric, no artificial restriction) -- `[i]` yields a raw `u8`,
    # `&s[a..b]` yields another `*str` over the same underlying bytes.
    first_byte := greeting[0];
    str_tail : *str = &greeting[7..];
    println$("str[0]=", <i32>first_byte, " tail.size=", str_tail.size);

    # Freely castable to the types you'd expect -- `*u8`/`*i8` drop the
    # length (`CastKind::DropLength`, a sound "give me just the pointer"
    # narrowing, not a claim of null-termination); `*[?]u8`/`*[?]i8` keep
    # both leaves unchanged (`CastKind::Reinterpret`, since the runtime
    # shape is already identical).
    as_u8_slice : *[?]u8 = <*[?]u8>greeting;
    as_i8_slice : *[?]i8 = <*[?]i8>greeting;
    as_thin_u8 : *u8 = <*u8>&greeting[0..<5];
    println$("str casts: [u8]len=", as_u8_slice.length, " [i8]len=", as_i8_slice.length, " thin[0]=", <i32>*as_thin_u8);

    # Multi-line strings: an opening run of N quotes (N odd, N >= 3),
    # closed only by an exact run of N quotes -- content in between is
    # verbatim (no escape processing), so shorter runs of quotes, even
    # right next to real content, don't terminate it early.
    my_long_string := """
  this is a long string! it can even have quotes ("") inside of it!
  as long as it doesnt contain with the same amount of quotes that it started, it's fine.
  otherwise, it will terminate the string.
""";

    my_even_longer_string := """""""""
  this is also allowed!
  look how many quotes i inserted.
  there are 9 quotes in the beginning.
  so there must be 9 quotes to terminate the string.
  if i do just 7, for instance, the string wont terminate: """""""
  im gonna terminate now.
""""""""";

    println$("multiline sizes: ", my_long_string.size, " ", my_even_longer_string.size);

    # Bitwise operators, at standard precedence (bitwise binds tighter than
    # comparison, matching Rust rather than C's looser-than-`==` gotcha).
    bit_and := 5 & 1;
    bit_or := 5 | 2;
    bit_xor := 5 ^ 1;
    bit_not := ~bit_xor;
    bit_shl := 5 << 2;
    bit_shr := 5 >> 1;
    println$("bitwise: and=", bit_and, " or=", bit_or, " xor=", bit_xor, " not=", bit_not, " shl=", bit_shl, " shr=", bit_shr);

    # Every arithmetic/bitwise operator has an "operate and assign"
    # counterpart.
    mut compound := 5;
    compound += 5;
    compound -= 2;
    compound *= 3;
    compound /= 4;
    compound %= 5;
    compound &= 3;
    compound ^= 1;
    compound |= 8;
    compound <<= 2;
    compound >>= 1;
    println$("compound assign: ", compound);

    # An external project's function and struct, resolved and type-checked
    # here but compiled by mathlib's own, separate `omgc` invocation (see
    # this file's `import extern::mathlib;`) -- the two object files are
    # linked together afterward.
    extern_sum := mathlib::add_numbers(3, 4);
    extern_point := mathlib::Point { x = 3; y = 4; };
    println$("extern sum: ", extern_sum, ", extern point magnitude_sq: ", extern_point.magnitude_sq());

    println$("cycle fixture: ", cycle_a_value(), " ", unrelated_b());

    # Compile-time slices: `&[...]` bakes the literal data straight into the
    # binary's data segment (see `Codegen::emit_const_slice`), rather than
    # building it on the stack the way a bare `[...]` array literal would --
    # an ordinary `Slice` value in every other respect (same `.length`/
    # indexing as a runtime slice).
    greetings := &["hello", "there"];
    println$("const slice: len=", greetings.length, " [0]=", greetings[0], " [1]=", greetings[1]);
    mut out : *str;
    greetings.first(&mut out);
    println$("======== FIRST: ", out, "=========");

    # ...which is exactly what makes `&[...]` usable as an enum header
    # constant too: `CryptographicAlgorithm` above.
    aes := CryptographicAlgorithm::AES;
    rsa := CryptographicAlgorithm::RSA;
    println$("enum const slice: name=", aes.name, " variants=[", aes.variants[0], ", ", aes.variants[1], ", ", aes.variants[2], "]");
    println$("enum const slice 2: name=", rsa.name, " variants=[", rsa.variants[0], ", ", rsa.variants[1], ", ", rsa.variants[2], "]");

    # `MovieCategory`'s `top_movies` is a fixed-length array baked *inline*
    # into the header (no `&`, no separate rodata blob/relocation, unlike
    # `variants` above) -- indexes exactly like an ordinary `[3]*u8` would.
    action := MovieCategory::Action;
    horror := MovieCategory::Horror;
    println$("enum const array: ", action.description, " -> [", action.top_movies[0], ", ", action.top_movies[1], ", ", action.top_movies[2], "]");
    println$("enum const array 2: ", horror.description, " -> [", horror.top_movies[0], ", ", horror.top_movies[1], ", ", horror.top_movies[2], "]");

    # Specs: declarations, overrides, dependencies, aliases, and `Self`.
    dog := Dog { id = 1; };
    dog2 := Dog { id = 2; };
    cat := Cat { id = 3; };
    wolf := Wolf { id = 4; };

    println$("dog.is_dog=", dog.is_dog(), " cat.is_dog=", cat.is_dog());
    println$("dog same_kind as dog2: ", dog.same_kind(&dog2));
    wolf.call_something_else();

    # Static dispatch: two independently monomorphized copies of the same
    # generic function body, one per concrete type.
    make_sound_with_static_dispatch(&dog);
    make_sound_with_static_dispatch(&cat);

    # Dynamic dispatch: one compiled function, called three times with
    # three different concrete types coerced to `spec *Animal` at each
    # call site -- the vtable picks the right `make_sound` at runtime.
    make_sound_with_dynamic_dispatch(&dog);
    make_sound_with_dynamic_dispatch(&cat);
    make_sound_with_dynamic_dispatch(&wolf);

    animal_var : spec *Animal = &dog;
    println$(animal_var.make_sound());

    accepts_myspec(&wolf);

    score := Score { value = 88; };
    println$("generic spec forwarding: score.get()=", score.get(), " score.describe()=", score.describe());

    c_like_packing : CLikePacking;
    regular_packing : Packed;
    packed_enum := EnumWithCLikePacking::First;

    mut offset := <usize>&c_like_packing.longthing - <usize>&c_like_packing;
    println$("type = CLikePacking, size = ", sizeof<CLikePacking>, ", offset of longthing: ", offset);

    offset = <usize>&regular_packing.longthing - <usize>&regular_packing;
    println$("type = Packed, size = ", sizeof<Packed>, ", offset of longthing: ", offset);
    offset = <usize>&packed_enum.longthing - <usize>&packed_enum;
    println$("type = EnumWithCLikePacking, size = ", sizeof<EnumWithCLikePacking>, ", offset of longthing: ", offset);

    ###
    my_vis_test := MyVisibilityTest {
        number = 123;
        text = "hello";
        hidden_number = 10; # should NOT WORK!!! this field is hidden!
    };
    println$("accessing hidden field: ", my_vis_test.hidden_number);
    ###
    my_vis_test := MyVisibilityTest::new();
    println$("accessing internal field: ", my_vis_test.text);

    mut my_optional := Optional<i32>::Some{ value = 10; };
    receives_any_optional(my_optional);

    # `for x in y` -- `y`'s type just needs to nominally declare `:
    # ToIterator<T>` (see `MyByteString` below); everything else is
    # ordinary. `to_iterator` returns its iterator *by value* (`spec
    # Iterator<T>`, static dispatch, no `*`) -- no heap allocation needed,
    # unlike a `spec *mut Iterator<T>` dynamic-dispatch handle would.
    my_bytes := MyByteString::new(b"omega");
    my_bytes_iter := my_bytes.to_iterator();
    for b in my_bytes_iter {
        print$(<i32>b, " ");
    }
    println$();

    # Compile-time evaluation (`comp`) -- see
    # docs/19-compile-time-evaluation.md. `comp` is a prefix on either an
    # *expression* (`comp <expr>`, evaluate this now) or a *binding*
    # (`comp ident := ...`, this identifier carries no storage of its own).
    #
    # `COMP_SUM` is a `comp` binding: `comp_add(10, 20)` runs at compile
    # time, and every reference to `COMP_SUM` below is substituted with the
    # already-known result `30` -- there is no runtime local backing it at
    # all, exactly like a literal.
    comp COMP_SUM := comp comp_add(10, 20);
    println$("comp binding (no storage): ", COMP_SUM);

    # `comp_point` is an *ordinary* local (no `comp` on the binding) --
    # only its *initializer* is compile-time evaluated: `Point { x = 3; y
    # = 4; }` is built once, ahead of time, and its bytes are baked
    # directly into the binary as `comp_point`'s starting value. Unlike
    # `COMP_SUM` above, `comp_point` is a real runtime place -- calling an
    # ordinary method on it (`magnitude_sq`) works exactly as it would on
    # any other struct value.
    comp_point := comp Point { x = 3; y = 4; };
    println$("comp-constructed struct: (", comp_point.x, ", ", comp_point.y, "), magnitude_sq=", comp_point.magnitude_sq());

    # `GLOBAL_COMP_VALUE` (declared at module scope, near `comp_add` below)
    # is read here directly *and* from `uses_global_comp_value`, an
    # entirely separate function -- the same no-storage substitution as
    # `COMP_SUM` above, just visible module-wide instead of only within
    # `main`.
    println$("global comp binding: ", GLOBAL_COMP_VALUE, ", from another function: ", uses_global_comp_value());


    zst := MyZst {};
    next_to_zst := 123;
    put_addr("&zst = ", <u64>&zst);
    put_addr("&next_to_zst = ", <u64>&next_to_zst);
    println$("&zst == &next_to_zst ? ", if &zst == &next_to_zst { "YES" } else { "NO" });

    allocation := GlobalAllocator::alloc(1024);
    put_addr("My allocation: ", <u64>allocation);
    GlobalAllocator::free(allocation);

    return 69;
}

# `Iterator<u8>`'s cursor: owns the mutable position state `to_iterator`
# below can't (it only ever receives `*self`, immutable).
struct MyByteStringIterator : Iterator<u8> {
    exposed ptr: *[?]u8;
    exposed index: usize;

    exposed new(orig: *[?]u8) => Self {
        Self { ptr = orig; index = 0; }
    }

    exposed next(*mut self) => Option<u8> {
        current_index := self.index;
        if current_index < <usize>self.ptr.length {
            self.index += 1;
            Option<u8>::Some{ value = self.ptr[current_index]; }
        } else {
            Option<u8>::None
        }
    }
}

# `to_iterator(*self) => spec Iterator<T>` (see `core::iterator`) is
# satisfied by any concrete return type that itself implements
# `Iterator<T>` -- checked against that bound, not matched by exact
# signature. This is what lets `to_iterator` return `MyByteStringIterator`
# by value directly, the same way Rust's `IntoIterator::into_iter` does --
# no `spec *mut Iterator<T>` fat pointer, no heap allocation.
struct MyByteString : ToIterator<u8> {
    exposed ptr: *[?]u8;

    exposed new(bytestr: *[?]u8) => Self {
        Self { ptr = bytestr; }
    }

    exposed to_iterator(*self) => MyByteStringIterator {
        MyByteStringIterator::new(self.ptr)
    }
}

# A duck-typed generic struct: `T` is substituted with a concrete type at
# each instantiation site (`GenericPair<i32>` above), and only then
# type-checked, exactly as if `GenericPair` had been written by hand for
# that one concrete type.
#
# `sum` demonstrates a method on a generic struct: `*self` resolves to
# `Self`, which every method's own analysis substitution already binds to
# the concrete owner (`GenericPair<i32>` here) -- no independent lookup of
# `GenericPair` itself is ever needed to type `self`.
struct GenericPair<T> {
    exposed a: T;
    exposed b: T;

    exposed sum(*self) => T { self.a + self.b }

    # A static (`self`-less) constructor -- `T` is deduced from `new`'s own
    # argument types the same way a bare generic function's is, composed
    # across the owner/function boundary: `GenericPair::new(7, 8)` (no
    # `<i32>` anywhere) infers `GenericPair<i32>` from `a`/`b`'s own types.
    exposed new(a: T, b: T) => Self { Self { a = a; b = b; } }
}

# A duck-typed generic function: `T` is never written at the call site --
# it's deduced from the call's own argument types (`i32` for `gp.a`/`gp.b`
# above, `f64` for the literal call below), each producing its own
# independently compiled instantiation.
sum_generic<T>(a: T, b: T) => T {
    a + b
}

# `T` deduced from a *generic-struct-typed* argument (`gp: GenericPair<i32>`
# below) -- unifies `p`'s declared `GenericPair<T>` against the call's own
# already-resolved `GenericPair<i32>`, positionally against the owner's own
# `type_args`, the same way a plain `*T`/`[T]` parameter's `T` already was.
sum_pair<T>(p: GenericPair<T>) => T { p.a + p.b }

# Same deduction, from a generic-*enum*-typed argument this time
# (`*Optional<T>`, called with `&opt`/`&none` below).
describe_some<T>(o: *Optional<T>) => bool { o.is_some() }

# A self-referential generic struct: `next` points back to `GenericNode<T>`
# itself (for whatever `T` this instantiation was substituted with), the
# same pointer-indirection cycle-guard fast path `Node`'s self-reference
# above already relies on, just keyed by the substituted instantiation
# rather than the raw template.
struct GenericNode<T> {
    exposed value: T;
    exposed next: *GenericNode<T>;
}

# A default type argument (`T = i32`): a use site may omit `T` entirely,
# not just its *value* -- `DefaultList::new()` below has no argument to
# deduce `T` from at all (unlike `GenericPair::new` above), so the default
# is the only thing that makes it resolvable in the first place.
struct DefaultList<T = i32> {
    exposed value: T;

    exposed new() => Self { Self { value = 0; } }
}

# A later default may reference an earlier parameter in the same list
# (`B = A`) -- resolved under whatever `A` concretely ends up being at each
# instantiation, not fixed once for the whole declaration. `A` itself has
# no default, so it must always be written or otherwise deduced; `B` may
# be omitted to fall back to matching `A`, or given its own separate type.
struct DefaultPair<A, B = A> {
    exposed a: A;
    exposed b: B;

    exposed new(a: A, b: B) => Self { Self { a = a; b = b; } }
}

# `T`'s own default participates in ordinary call-argument inference with
# a fixed precedence: an argument's *explicit* type always wins first, the
# declared default is used next (before falling back to inference's own
# untyped-literal default), and inference alone is the last resort. See
# `main`, below, for what each of the three calls actually deduces.
add_defaulted<T = u64>(a: T, b: T) => T {
    a + b
}

# Called by `main` above despite being declared after it -- proves a
# same-module forward reference resolves.
forward_declared_fn() => i32 {
    42
}

# An ordinary function -- nothing about its own declaration marks it as
# usable at compile time. `comp comp_add(10, 20)` (in `main`, above) still
# interprets this exact body: `comp` is never a function-level color (see
# docs/19-compile-time-evaluation.md) -- any function can be *attempted* at
# compile time, on demand, at the call site.
comp_add(a: i32, b: i32) => i32 {
    a + b
}

# A top-level `comp` binding -- unlike `COMP_SUM` in `main` above, this one
# is visible to *every* item in the module (or anything that imports it),
# not just the function it's declared in. Still no storage of its own:
# every reference substitutes `60`, the already-known value.
comp GLOBAL_COMP_VALUE := comp comp_add(40, 20);

# Reads `GLOBAL_COMP_VALUE` from a function entirely separate from the one
# that (transitively) triggered its evaluation -- proving the substitution
# genuinely works cross-item, not just within the declaring scope.
uses_global_comp_value() => i32 {
    GLOBAL_COMP_VALUE + 9
}

# `defer` schedules a piece of code to run when *this* function exits --
# every `return`, including the early one below, not just falling off the
# end -- in FILO order relative to any other defers in the same function.
# No hidden sugar (no destructors): the deferred statement/block is spelled
# out right where it's scheduled, and runs exactly once per call.
defer_demo(flag: bool) => i32 {
    println$("defer_demo: start");
    defer { println$("defer_demo: cleanup ran"); }
    if flag {
        println$("defer_demo: early return");
        return 1;
    }
    println$("defer_demo: normal end");
    return 0;
}

# A compile-time macro used in expression position: its body is only ever type-checked
# once fully substituted at a call site (duck typed, like generics) -- never
# on its own. `sum_macro$(3, 4)` above expands to `(3) + (4)` and is
# re-parsed/re-analyzed exactly as if that had been hand-written there.
macro sum_macro($a: expr, $b: expr) => {
    ($a) + ($b)
}

# A compile-time macro used in item position: expands to zero or more top-level
# items (here, one `struct`). Macros are expanded before HIR lowering ever
# runs, so `Point` below is an entirely ordinary struct by the time analysis
# sees it -- no different from `Node`/`Interface` elsewhere in this file.
macro make_point_type($name: type) => {
    struct $name {
        exposed x: i32;
        exposed y: i32;
        exposed magnitude_sq(*self) => i32 {
            self.x * self.x + self.y * self.y
        }
    }
}

make_point_type$(Point);

# Variadic macros use a single trailing `...` parameter. Repetition splices
# one statement per argument, or joins arguments with a separator.
macro call_each($f: ident, $args: expr...) => {
    $...(){ $f($args); }
}

macro call_with_args($f: ident, $args: expr...) => {
    $f($...(,){ $args })
}

# Self-referencing struct: `next` points back to `Node` itself, which is
# only resolvable because the struct's own placeholder is registered before
# its fields are analyzed.
struct Node {
    exposed value: i32;
    exposed next: *Node;
}
