# The other half: an executable that prints *and* links a library that
# prints. See `printlib.omg` for what this is actually asserting.
import extern::printlib::announce;
import extern::std::io::println;
import extern::std::io::BufWriter;
import extern::std::io::Stdout;
import extern::std::io::Write;
import extern::std::fmt::Display;

main() => i32 {
    announce();
    println$("app says hello");
    0
}
