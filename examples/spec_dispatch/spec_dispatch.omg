# End-to-end proof of the spec-composition end state: inline conjunctions,
# aliases, blanket derivations, bound-subset precedence, `(spec, name)`
# identity, sectioned conjunction vtables and narrowing casts. Exits
# non-zero (with a distinct code per case) so `just test-spec-dispatch` is a
# real assertion -- every check here is a *runtime* fact about which body
# actually ran, which compilation alone cannot observe.

import extern::core::cmp::Eq;
import extern::core::cmp::Ord;
import extern::core::cmp::Ordering;
import extern::core::option::Option;

# --- identity: two specs declaring the same name + signature --------------

exposed spec A { tag(*self) => i32; a_only(*self) => i32; }
exposed spec B { tag(*self) => i32; b_only(*self) => i32; }
spec AB = A + B;

struct Thing {
    exposed a: i32;
    exposed b: i32;
}
conform Thing to A {
    tag(*self) => i32 { self.a }
    a_only(*self) => i32 { self.a }
}
conform Thing to B {
    tag(*self) => i32 { self.b }
    b_only(*self) => i32 { self.b }
}

# Static dispatch through each bound reaches that spec's own body, never the
# other's same-named one.
via_a<T: A>(x: *T) => i32 { x.tag() }
via_b<T: B>(x: *T) => i32 { x.tag() }

# The alias is satisfied by the two separate conform blocks above; nothing
# is conformed to `AB` itself, and only the non-colliding methods are
# callable through it (a `tag()` here would be ambiguous -- both members
# declare it).
via_ab<T: AB>(x: *T) => i32 { x.a_only() + x.b_only() }

# Dynamic dispatch over the conjunction: a colliding name is rejected unless
# narrowed, and the narrowing cast selects that member's own section.
narrow_a(x: spec *AB) => i32 { (<spec *A>x).tag() }
narrow_b(x: spec *AB) => i32 { (<spec *B>x).tag() }

# --- the old `Eq::equals` link failure, pinned by execution ---------------

# `equals` is declared on `Eq`; under `T: Ord` it is reachable only through
# the blanket `conform<T: Ord> T to Eq` in `core::cmp` -- which used to be
# impossible (the call compiled, then failed to link against an `Ord`-mangled
# symbol). This program running at all is the assertion.
same<T: Ord>(a: T, b: T) => bool { a.equals(b) }

# --- blanket precedence, pinned by which body actually ran -----------------

exposed spec X { rank(*self) => i32; }
exposed spec P { p(*self) => i32; }
exposed spec Q { q(*self) => i32; }

struct Ranked {
    exposed v: i32;
}
conform Ranked to P { p(*self) => i32 { self.v } }
conform Ranked to Q { q(*self) => i32 { self.v } }

conform<T: P> T to X { rank(*self) => i32 { 1 } }
conform<T: P + Q> T to X { rank(*self) => i32 { 2 } }

struct Special {
    exposed v: i32;
}
conform Special to P { p(*self) => i32 { self.v } }
conform Special to Q { q(*self) => i32 { self.v } }
conform Special to X { rank(*self) => i32 { 99 } }

rank_of<T: X>(x: *T) => i32 { x.rank() }

# An unbounded blanket loses to a bounded one -- same subset rule, at its
# empty-set degenerate case.
exposed spec Y { rank2(*self) => i32; }
conform<T> T to Y { rank2(*self) => i32 { 1 } }
conform<T: P> T to Y { rank2(*self) => i32 { 2 } }
rank2_of<T: Y>(x: *T) => i32 { x.rank2() }

# --- the blanket chain, pinned by which body actually ran -----------------

# `Thing: A2 -> B2 -> C2`: two blanket derivations in a row, which used to
# be misreported as a conformance cycle in one declaration order only. The
# derived bodies actually run: `a2() = 1`, `b2() = a2() + 10`,
# `c2() = b2() + 100`.
exposed spec A2 { a2(*self) => i32; }
exposed spec B2 { b2(*self) => i32; }
exposed spec C2 { c2(*self) => i32; }
conform Thing to A2 { a2(*self) => i32 { 1 } }
conform<T: A2> T to B2 { b2(*self) => i32 { self.a2() + 10 } }
conform<T: B2> T to C2 { c2(*self) => i32 { self.b2() + 100 } }
chain_of<T: C2>(x: *T) => i32 { x.c2() }

# The identical chain with its two blankets in the opposite declaration
# order -- order-independence is the property goal-directed solving
# restored, and it is asserted by execution, not just by compilation.
exposed spec A3 { a3(*self) => i32; }
exposed spec B3 { b3(*self) => i32; }
exposed spec C3 { c3(*self) => i32; }
conform Thing to A3 { a3(*self) => i32 { 1 } }
conform<T: B3> T to C3 { c3(*self) => i32 { self.b3() + 100 } }
conform<T: A3> T to B3 { b3(*self) => i32 { self.a3() + 10 } }
chain_reversed<T: C3>(x: *T) => i32 { x.c3() }

main() => i32 {
    t := Thing { a = 10; b = 20; };

    # Identity through static bounds.
    if via_a(&t) != 10 { return 1; }
    if via_b(&t) != 20 { return 2; }

    # An alias bound is satisfied by the members' separate conforms.
    if via_ab(&t) != 30 { return 3; }

    # Narrowing casts onto each section of the conjunction vtable.
    if narrow_a(&t) != 10 { return 4; }
    if narrow_b(&t) != 20 { return 5; }

    # The blanket-derived `Eq` under an `Ord` bound (the old link failure).
    if same(3, 3) { } else { return 6; }
    if same(3, 4) { return 7; }

    ranked := Ranked { v = 0; };
    # The `P + Q`-bounded blanket is a strict superset of the `P`-bounded
    # one, so it must be the body that ran.
    if rank_of(&ranked) != 2 { return 8; }

    special := Special { v = 0; };
    # A concrete conform beats every blanket.
    if rank_of(&special) != 99 { return 9; }

    # A bounded blanket beats an unbounded one.
    if rank2_of(&ranked) != 2 { return 10; }

    # The two-link blanket chain, in both declaration orders.
    if chain_of(&t) != 111 { return 11; }
    if chain_reversed(&t) != 111 { return 12; }

    0
}
