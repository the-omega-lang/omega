# The headline split test: this program uses only inherent core primitives.
# It registers and links `core` alone; no allocator or console glue exists.

main() => i32 {
    value := -7i32;
    absolute := value.abs();
    clamped := absolute.clamp(0i32, 5i32);
    mut bytes: [1]u8;
    view := &mut bytes[0..];
    if clamped == 5i32 {
        if view.is_empty() { 1 } else { 0 }
    } else {
        1
    }
}
