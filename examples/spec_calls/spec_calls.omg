# End-to-end proof of the three-tier spec-function call ladder --
# `S::fn()` / `P::fn(...)` / `<S : P>::fn(...)`. Exits non-zero (with a
# distinct code per case) so `just test-spec-calls` is a real assertion:
# every check here is a runtime fact about which body actually ran, which
# compilation alone cannot observe.

import extern::core::range::Bounded;
import extern::std::default::Default;

# --- rung 3: both halves written -----------------------------------------

exposed spec P { make() => Self; label(*self) => i32; }
exposed spec Q { make() => Self; label(*self) => i32; }

struct S {
    exposed v: i32;
}
conform S to P {
    make() => Self { S { v = 1; } }
    label(*self) => i32 { 100 + self.v }
}
conform S to Q {
    make() => Self { S { v = 2; } }
    label(*self) => i32 { 200 + self.v }
}

# The same shape at a generic spec, exercising the `>>` close-angle split
# (`<S : G<i32>>::make()`).
exposed spec G<T> { make() => Self; }
conform S to G<i32> { make() => Self { S { v = 3; } } }

# --- a spec default, overridable per implementor --------------------------

exposed spec WithDefault {
    default() => Self { S { v = 1; } }
    make() => Self { S { v = 2; } }
}
conform S to WithDefault {
    default() => Self { S { v = 99; } }
}

takes_char(c: char) => i32 { <i32>c }

main() => i32 {
    # Rung 2, receiverless: `Self` from the expected type
    # (`x : char = Bounded::min();`), at the domain limits.
    lo : char = Bounded::min();
    hi : char = Bounded::max();
    if <u32>lo != 0u32 { return 1; }
    if <u32>hi != 0x10FFFFu32 { return 2; }

    # ...in argument position, inferred from the parameter type.
    if takes_char(Bounded::min()) != 0 { return 3; }

    # `std::default::Default` -- the form it exists to be used with.
    n : i32 = Default::default();
    if n != 0 { return 4; }

    # Rung 3, statics: each qualified spelling selects its own conform's
    # body, for a type conforming to both P and Q.
    a := <S : P>::make();
    b := <S : Q>::make();
    if a.v != 1 { return 5; }
    if b.v != 2 { return 6; }

    # Rung 3, instance: the receiver is still the first argument, and the
    # written target picks the body -- matching the rung-2 spelling of the
    # same call.
    if <S : P>::label(&a) != P::label(&a) { return 7; }
    if <S : Q>::label(&b) != 200 + b.v { return 8; }

    # A generic spec through the qualified form (`>>` split exercised).
    if (<S : G<i32>>::make()).v != 3 { return 9; }

    # The same receiverless call via rung 1 works when unambiguous
    # (`i32::min()`: exactly one conform provides it).
    if <i32 : Bounded>::min() != i32::min() { return 10; }
    if <i32 : Bounded>::max() != 2147483647 { return 11; }

    # A conform-supplied override still beats a spec default through the
    # expected-type path.
    d : S = WithDefault::default();
    m : S = WithDefault::make();
    if d.v != 99 { return 12; }
    if m.v != 2 { return 13; }

    0
}
