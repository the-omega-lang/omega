#!/usr/bin/env ruby

require "fileutils"
require "open3"
require "pathname"

ROOT_DIR = Pathname.new(__dir__).join("..").expand_path
TESTS_DIR = ROOT_DIR.join("tests")

# Directories
BIN_DIR = ROOT_DIR.join("bin")
ARTIFACTS_DIR = if ENV["OMEGA_ARTIFACTS_DIR"]
  Pathname.new(ENV["OMEGA_ARTIFACTS_DIR"]).expand_path
else
  ROOT_DIR.join("target")
end
TEST_ARTIFACTS_DIR = ARTIFACTS_DIR.join("tests")

# Dependencies
RUNTIME_PACKAGES = {
  "core" => ROOT_DIR.join("runtime", "core"),
  "std"  => ROOT_DIR.join("runtime", "std"),
  "plat" => ROOT_DIR.join("runtime", "plat", "libc")
}.freeze
RUNTIME_OBJECTS = RUNTIME_PACKAGES.keys.map{ |x| ARTIFACTS_DIR.join("#{x}.o") }.freeze

# omgc
OMGC = BIN_DIR.join("omgc-debug")
OMGC_IMPORTS = RUNTIME_PACKAGES.map do |name, path|
  "--import=#{name}:#{path}"
end.freeze

module Color
  extend self

  ENABLED = $stdout.tty? && ENV["NO_COLOR"].nil?

  CODES = {
    reset: 0, bold: 1, dim: 2,
    red: 31, green: 32, yellow: 33, blue: 34, magenta: 35, cyan: 36, white: 37,
    gray: 90
  }.freeze

  def paint(text, *styles)
    return text.to_s unless ENABLED

    codes = styles.map { |style| CODES.fetch(style) }.join(";")
    "\e[#{codes}m#{text}\e[0m"
  end

  CODES.each_key do |name|
    define_method(name) do |text|
      paint(text, name)
    end
  end
end

class CommandResult
  attr_reader :stdout, :stderr, :status

  def initialize(stdout, stderr, status)
    @stdout = stdout
    @stderr = stderr
    @status = status
  end

  def success?
    @status.success?
  end
end

class TestModule
  attr_reader :name, :path

  def initialize(path)
    @path = Pathname.new(path)
    @name = @path.basename.to_s
  end

  def expected_stdout_path
    @path.join("expected.stdout")
  end

  def expected_stderr_path
    @path.join("expected.stderr")
  end
end

class TestResult
  attr_reader :test, :failures, :duration

  def initialize(test, failures, duration)
    @test = test
    @failures = failures
    @duration = duration
  end

  def passed?
    @failures.empty?
  end
end

class TestRunner
  PASS_ICON = "✓"
  FAIL_ICON = "✗"
  RUN_ICON  = "•"

  def initialize(tests)
    @tests = tests
    @name_width = tests.map { |test| test.name.length }.max || 0
  end

  def run
    FileUtils.mkdir_p(TEST_ARTIFACTS_DIR)

    suite_start = now
    results = @tests.map { |test| run_and_report(test) }
    suite_duration = now - suite_start

    print_summary(results, suite_duration)

    results.all?(&:passed?)
  end

  private

  def run_and_report(test)
    live = Color::ENABLED
    print "  #{Color.gray(RUN_ICON)} #{test.name.ljust(@name_width)}" if live
    $stdout.flush if live

    result = run_test(test)

    print "\r\e[2K" if live
    print_result_line(result)

    unless result.passed?
      result.failures.each { |failure| puts failure }
      puts
    end

    result
  end

  def print_result_line(result)
    time_str = Color.gray(format_duration(result.duration))

    if result.passed?
      icon = Color.paint(PASS_ICON, :bold, :green)
      status = Color.green("PASS")
    else
      icon = Color.paint(FAIL_ICON, :bold, :red)
      status = Color.red("FAIL")
    end

    puts "  #{icon} #{status}  #{result.test.name.ljust(@name_width)}  #{time_str}"
  end

  def print_summary(results, suite_duration)
    failed = results.reject(&:passed?)
    passed_count = results.length - failed.length

    puts
    puts Color.paint("─" * 40, :gray)

    bar = progress_bar(passed_count, results.length)
    counts = if failed.empty?
      Color.bold(Color.green("#{passed_count}/#{results.length} passed"))
    else
      "#{Color.bold(Color.green("#{passed_count} passed"))}, " \
        "#{Color.bold(Color.red("#{failed.length} failed"))} " \
        "#{Color.gray("(#{results.length} total)")}"
    end

    puts "  #{bar}  #{counts}"
    puts "  #{Color.gray("finished in #{format_duration(suite_duration)}")}"

    unless failed.empty?
      puts
      puts "  #{Color.red("Failed:")}"
      failed.each { |result| puts "    #{Color.red(TestRunner::FAIL_ICON)} #{result.test.name}" }
    end

    puts
  end

  def progress_bar(passed, total, width: 20)
    return Color.gray("─" * width) if total.zero?

    filled = (passed.to_f / total * width).round
    filled = width if passed == total
    bar_color = passed == total ? :green : :yellow

    Color.paint("█" * filled, bar_color) + Color.gray("░" * (width - filled))
  end

  def format_duration(seconds)
    ms = seconds * 1000.0

    if ms < 1000
      "%4dms" % ms.round
    else
      "%5.2fs" % seconds
    end
  end

  def now
    Process.clock_gettime(Process::CLOCK_MONOTONIC)
  end

  def run_test(test)
    start = now
    target_dir = TEST_ARTIFACTS_DIR.join(test.name)

    FileUtils.rm_rf(target_dir)
    FileUtils.mkdir_p(target_dir)

    object = target_dir.join("#{test.name}.o")
    executable = target_dir.join(test.name)

    compile = capture(
      OMGC.to_s,
      test.path.relative_path_from(ROOT_DIR).to_s,
      *OMGC_IMPORTS,
      "-o", object.to_s
    )

    unless compile.success?
      failures = compare_expected_output(
        test,
        compile.stdout,
        compile.stderr
      )

      unless test.expected_stderr_path.file?
        failures.unshift(indent_message("compilation failed unexpectedly"))
      end

      return TestResult.new(test, failures, now - start)
    end

    link = capture(
      "cc",
      object.to_s,
      *RUNTIME_OBJECTS.map(&:to_s),
      "-o", executable.to_s
    )

    unless link.success?
      return TestResult.new(test, [
        indent_message("linking failed"),
        format_command_output(link)
      ], now - start)
    end

    execution = capture(executable.to_s)

    failures = compare_expected_output(
      test,
      execution.stdout,
      execution.stderr
    )

    unless execution.success?
      failures.unshift(
        indent_message("program exited with status #{execution.status.exitstatus}")
      )
    end

    TestResult.new(test, failures, now - start)
  end

  def indent_message(text)
    "    #{Color.yellow(text)}"
  end

  def compare_expected_output(test, stdout, stderr)
    failures = []

    compare_stream(
      test.expected_stdout_path,
      stdout,
      "stdout",
      failures
    )

    compare_stream(
      test.expected_stderr_path,
      stderr,
      "stderr",
      failures
    )

    failures
  end

  def compare_stream(expected_path, actual, name, failures)
    return unless expected_path.file?

    expected = File.binread(expected_path)
    actual = actual.b

    return if expected == actual

    line, column = first_difference_location(expected, actual)

    failures << <<~MESSAGE.chomp
        #{Color.yellow("#{name} did not match #{expected_path.basename}")}

        #{code_frame(expected_path.basename.to_s, line, column, line_at(expected, line))}
        #{code_frame("actual #{name}", line, column, line_at(actual, line))}

        #{Color.gray("expected:")}
        #{indent(expected, :green, line_numbers: true)}

        #{Color.gray("actual:")}
        #{indent(actual, :red, line_numbers: true)}
    MESSAGE
  end

  # Finds the first byte at which the two streams diverge and reports it as a
  # 1-indexed (line, column) pair, matching the compiler's own diagnostic
  # coordinates. Column is counted in characters (decoding the line as UTF-8)
  # rather than bytes, so it points at the right spot even past multibyte text.
  def first_difference_location(expected, actual)
    limit = [expected.bytesize, actual.bytesize].min

    index = 0
    index += 1 while index < limit && expected.getbyte(index) == actual.getbyte(index)

    prefix = expected.byteslice(0, index)
    last_newline = prefix.rindex("\n")
    line_start = last_newline ? last_newline + 1 : 0

    line = prefix.count("\n") + 1
    column = expected.byteslice(line_start, index - line_start)
      .force_encoding(Encoding::UTF_8)
      .length + 1

    [line, column]
  end

  def line_at(text, line_no)
    text.split("\n", -1)[line_no - 1]
  end

  def code_frame(label, line_no, column, source_line)
    gutter = line_no.to_s
    pad = " " * gutter.length
    content = source_line.nil? ? Color.gray("<no such line>") : source_line
    caret = "#{" " * [column - 1, 0].max}#{Color.paint("^", :bold, :red)}"

    <<~FRAME.chomp
      #{pad}#{Color.gray("-->")} #{Color.bold("#{label}:#{line_no}:#{column}")}
      #{pad} #{Color.gray("|")}
      #{Color.gray(gutter)} #{Color.gray("|")} #{content}
      #{pad} #{Color.gray("|")} #{caret}
    FRAME
  end

  def capture(*command)
    stdout, stderr, status = Open3.capture3(
      *command,
      chdir: ROOT_DIR.to_s,
      binmode: true
    )

    CommandResult.new(stdout, stderr, status)
  end

  def format_command_output(result)
    <<~OUTPUT.chomp
      #{Color.gray("stdout:")}
      #{indent(result.stdout)}

      #{Color.gray("stderr:")}
      #{indent(result.stderr)}
    OUTPUT
  end

  def indent(text, color = nil, line_numbers: false)
    return "    #{Color.gray("<empty>")}" if text.empty?

    lines = text.lines(chomp: false)

    unless line_numbers
      return lines
        .map { |line| "    #{color ? Color.paint(line, color) : line}" }
        .join
        .chomp
    end

    width = lines.length.to_s.length

    lines
      .each_with_index
      .map do |line, idx|
        gutter = Color.gray((idx + 1).to_s.rjust(width))
        painted = color ? Color.paint(line, color) : line
        "    #{gutter} #{Color.gray("|")} #{painted}"
      end
      .join
      .chomp
  end
end

def get_available_test_modules
  return [] unless TESTS_DIR.directory?

  TESTS_DIR
    .children
    .select(&:directory?)
    .sort
    .map { |path| TestModule.new(path) }
end

available_tests = get_available_test_modules
tests_by_name = available_tests.to_h { |test| [test.name, test] }

tests_to_run =
  if ARGV.empty?
    available_tests
  else
    unknown = ARGV.reject { |name| tests_by_name.key?(name) }

    abort "Unknown test(s): #{unknown.join(", ")}" unless unknown.empty?

    ARGV.map { |name| tests_by_name.fetch(name) }
  end

abort "No tests found in #{TESTS_DIR}" if tests_to_run.empty?

puts Color.bold(Color.cyan("Omega Test Runner"))
puts Color.gray("#{tests_to_run.length} test(s): #{tests_to_run.map(&:name).join(", ")}")
puts

exit(TestRunner.new(tests_to_run).run ? 0 : 1)
