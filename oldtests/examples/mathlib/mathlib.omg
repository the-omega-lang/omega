# A small standalone project, meant to be compiled on its own
# (`omgc examples/mathlib/ -o target/mathlib.o`) and linked
# into another project that references it via `import extern::mathlib;`
# (see `examples/dev/dev.omg`, compiled with
# `--extern=mathlib:examples/mathlib/`). Nothing here is aware it's
# being used this way -- it's an entirely ordinary module.

exposed add_numbers(a: i32, b: i32) => i32 {
    a + b
}

exposed struct Point {
    exposed x: i32;
    exposed y: i32;
    exposed magnitude_sq(*self) => i32 {
        self.x * self.x + self.y * self.y
    }
}
