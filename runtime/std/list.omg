# `std::list` -- `List<T>`, a growable heap-backed array (Rust's `Vec<T>`).
# No RAII in this language (`defer` is the only structured cleanup, see
# docs/language/control-flow-and-operators.md), so every owning method has a real, explicit
# `free`; the intended idiom:
#
#   list := List<i32>::new();
#   defer list.free();
#
# Fallible, possibly-out-of-bounds access follows `core::primitives::slices`'
# out-pointer/`bool` convention (`get`/`pop`/`set`) rather than `Option<T>`,
# so it feels like a drop-in extension of plain-slice methods.

# `core` is a full ambient prelude, so no imports needed for
# `Iterator`/`ToIterator`/`Option<T>`. `alloc`/`free`/`realloc` come from
# `std::alloc`, not `core::platform::GlobalAllocator` directly -- see that
# file's own comment for why.
import super::alloc::alloc;
import super::alloc::free;
import super::alloc::realloc;

exposed struct List<T> {
    shared data: *mut T;
    # Named `count`, not `len` -- a field and method can't share a name,
    # and the public accessor (`list.len()`) gets the idiomatic one.
    shared count: usize;
    shared cap: usize;

    exposed new() => Self {
        Self { data = <*mut T>0; count = 0; cap = 0; }
    }

    exposed with_capacity(capacity: usize) => Self {
        mut list := Self::new();
        if capacity > 0 {
            list.reserve(capacity);
        }
        list
    }

    exposed len(*self) => usize { self.count }
    exposed capacity(*self) => usize { self.cap }
    exposed is_empty(*self) => bool { self.count == 0 }

    # `index`'s element address -- explicit byte math, since pointer
    # arithmetic here doesn't scale by `sizeof<T>` like C's does (see
    # docs/language/types-and-primitives.md), and `ptr[i]` only works on a slice/array,
    # never a raw pointer.
    elem_ptr(*self, index: usize) => *mut T {
        <*mut T>(<usize>self.data + index * sizeof<T>)
    }

    # Grows to at least `min_capacity`, doubling from 4 (Rust `Vec`'s
    # amortized-O(1)-push factor). Branches `alloc` vs `realloc` explicitly
    # rather than relying on `realloc(null, size)` acting like `alloc` --
    # that's a libc property, not one `GlobalAllocator` itself promises.
    reserve(*mut self, min_capacity: usize) => void {
        if self.cap < min_capacity {
            mut new_cap : usize = if self.cap == 0 { 4 } else { self.cap * 2 };
            while new_cap < min_capacity {
                new_cap = new_cap * 2;
            }
            new_size := new_cap * sizeof<T>;
            new_data := if self.cap == 0 {
                alloc(new_size)
            } else {
                realloc(<*u8>self.data, new_size)
            };
            self.data = <*mut T>new_data;
            self.cap = new_cap;
        }
    }

    exposed push(*mut self, value: T) => void {
        if self.count >= self.cap {
            self.reserve(self.count + 1);
        }
        *self.elem_ptr(self.count) = value;
        self.count += 1;
    }

    exposed pop(*mut self, out: *mut T) => bool {
        if self.count == 0 {
            return false;
        }
        self.count -= 1;
        *out = *self.elem_ptr(self.count);
        true
    }

    exposed get(*self, index: usize, out: *mut T) => bool {
        if index >= self.count {
            return false;
        }
        *out = *self.elem_ptr(index);
        true
    }

    exposed set(*mut self, index: usize, value: T) => bool {
        if index >= self.count {
            return false;
        }
        *self.elem_ptr(index) = value;
        true
    }

    exposed clear(*mut self) => void {
        self.count = 0;
    }

    # `self.data` is a bare `*T` with no indexing/slicing of its own; cast
    # to `*mut [?]T` (Pointer <-> Array reinterpret) then range-slice to
    # get a real runtime-length `*[]T`; see docs/language/strings-casts-arrays-and-slices.md.
    exposed as_slice(*self) => *[]T {
        count := <i32>self.count;
        &(<*mut [?]T>self.data)[0..<count]
    }

    exposed free(*mut self) => void {
        if self.cap > 0 {
            free(<*u8>self.data);
            self.data = <*mut T>0;
            self.cap = 0;
            self.count = 0;
        }
    }

}

meet<T> ToIterator<T> for List<T> {
    to_iterator(*self) => ListIterator<T> {
        ListIterator<T> { data = self.data; index = 0; remaining = self.count; }
    }
}

# `shared`, not hidden: `List<T>::to_iterator` builds one by struct
# literal from a different type's method, and hidden fields are settable
# only within their own type's methods.
exposed struct ListIterator<T> {
    shared data: *mut T;
    shared index: usize;
    shared remaining: usize;

}

meet<T> Iterator<T> for ListIterator<T> {
    next(*mut self) => Option<T> {
        if self.remaining == 0 {
            return Option<T>::None;
        }
        value := *<*mut T>(<usize>self.data + self.index * sizeof<T>);
        self.index += 1;
        self.remaining -= 1;
        Option<T>::Some { value = value; }
    }
}
