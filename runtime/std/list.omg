# `std::list` -- `List<T>`, a growable, heap-backed array (Rust's `Vec<T>`,
# under a name that doesn't collide with "this is actually a vector" the
# way "Vec" does for a general-purpose audience).
#
# Built directly on `core::platform::GlobalAllocator` -- the only capability
# this type needs, so it works on any platform that's supplied *a* glue
# for it, embedded included. No RAII in this language (no `Drop`
# equivalent -- `defer` is the only structured cleanup mechanism, see
# `docs/03-control-flow.md`), so every owning method here has a real,
# explicit `free`; the intended idiom is:
#
#   list := List<i32>::new();
#   defer list.free();
#
# Fallible, possibly-out-of-bounds access follows `core::slices::
# SliceImpl<T>`'s own out-pointer/`bool` convention (`get`/`pop`/`set`)
# rather than `Option<T>` -- `List<T>` is the growable version of the same
# hot-path, no-allocation-on-read concept `*[?]T` already is, and should
# feel like a drop-in extension of the methods a caller already knows from
# plain slices.

# No imports needed for `Iterator`/`ToIterator`/`Option<T>` -- `core` is a
# full ambient prelude for every other package (see
# `docs/10-modules-and-linkage.md`), exactly like `examples/dev/dev.omg`'s
# own bare `Option::None` usage. `alloc`/`free`/`realloc` come from
# `std::alloc` instead of calling `core::platform::GlobalAllocator` directly --
# see that file's own doc comment for why that indirection is required,
# not stylistic.
import alloc::alloc;
import alloc::free;
import alloc::realloc;

exposed struct List<T> {
    internal data: *mut T;
    # Named `count`, not `len` -- a field and a method can't share one name
    # on the same type, and the public accessor is what should get the
    # short, idiomatic name (`list.len()`, matching `*[?]T`'s own `.length`
    # in spirit).
    internal count: usize;
    internal cap: usize;

    exposed new() => Self {
        Self { data = <*mut T>0; count = 0; cap = 0; }
    }

    exposed with_capacity(capacity: usize) => Self {
        mut list := Self::new();
        if capacity > 0 {
            list.reserve(capacity);
        }
        list
    }

    exposed len(*self) => usize { self.count }
    exposed capacity(*self) => usize { self.cap }
    exposed is_empty(*self) => bool { self.count == 0 }

    # `index`'s own element address -- explicit byte math, since pointer
    # arithmetic in this language coerces to `usize` and does *not*
    # implicitly scale by `sizeof<T>` the way C's does (see
    # `docs/01-primitives.md`'s "char, bool, and pointer arithmetic"), and
    # indexing syntax (`ptr[i]`) only works on a real slice/array, never a
    # raw pointer. Centralized here once rather than repeated per method.
    elem_ptr(*self, index: usize) => *mut T {
        <*mut T>(<usize>self.data + index * sizeof<T>)
    }

    # Grows `data` to hold at least `min_capacity` elements, doubling
    # (starting from 4) until it does -- the same amortized-O(1)-push
    # growth factor Rust's own `Vec` uses. Explicitly branches `alloc`
    # (first allocation) vs. `realloc` (every later growth) rather than
    # always calling `realloc` and relying on `realloc(null, size)`
    # behaving like `alloc` -- that's a real property of libc's own
    # `realloc`, but not a contract `core::platform::GlobalAllocator` itself
    # promises, and this type is meant to work with any future glue,
    # including ones that don't happen to share that behavior.
    reserve(*mut self, min_capacity: usize) => void {
        if self.cap < min_capacity {
            mut new_cap : usize = if self.cap == 0 { 4 } else { self.cap * 2 };
            while new_cap < min_capacity {
                new_cap = new_cap * 2;
            }
            new_size := new_cap * sizeof<T>;
            new_data := if self.cap == 0 {
                alloc(new_size)
            } else {
                realloc(<*u8>self.data, new_size)
            };
            self.data = <*mut T>new_data;
            self.cap = new_cap;
        }
    }

    exposed push(*mut self, value: T) => void {
        if self.count >= self.cap {
            self.reserve(self.count + 1);
        }
        *self.elem_ptr(self.count) = value;
        self.count += 1;
    }

    exposed pop(*mut self, out: *mut T) => bool {
        if self.count == 0 {
            return false;
        }
        self.count -= 1;
        *out = *self.elem_ptr(self.count);
        true
    }

    exposed get(*self, index: usize, out: *mut T) => bool {
        if index >= self.count {
            return false;
        }
        *out = *self.elem_ptr(index);
        true
    }

    exposed set(*mut self, index: usize, value: T) => bool {
        if index >= self.count {
            return false;
        }
        *self.elem_ptr(index) = value;
        true
    }

    exposed clear(*mut self) => void {
        self.count = 0;
    }

    # A real, borrowed view of this list's current contents -- `self.data`
    # is a bare `*T`, which no longer supports indexing or slicing on its
    # own; casting it to `*mut []T` first (an ordinary `Pointer <-> Array`
    # reinterpret cast) gets back an unsized-array pointer, which range-
    # slicing with an explicit end (`self.count`, cast to `i32` to match a
    # slice's own `.length` leaf type) then turns into a real, runtime-
    # length `*[?]T`; see docs/11-strings-casting-and-slices.md.
    exposed as_slice(*self) => *[?]T {
        count := <i32>self.count;
        &(<*mut []T>self.data)[0..<count]
    }

    exposed free(*mut self) => void {
        if self.cap > 0 {
            free(<*u8>self.data);
            self.data = <*mut T>0;
            self.cap = 0;
            self.count = 0;
        }
    }

}

compose<T> List<T> : ToIterator<T> {
    to_iterator(*self) => ListIterator<T> {
        ListIterator<T> { data = self.data; index = 0; remaining = self.count; }
    }
}

# `internal`, not hidden, on every field: `List<T>::to_iterator` (a
# different type's method, though the same package) has to build one by
# struct literal, and a hidden field is only settable from within its own
# type's own methods -- `internal` (package-wide) is exactly the
# permission this needs without making these fields part of `std`'s real
# public surface.
exposed struct ListIterator<T> {
    internal data: *mut T;
    internal index: usize;
    internal remaining: usize;

}

compose<T> ListIterator<T> : Iterator<T> {
    next(*mut self) => Option<T> {
        if self.remaining == 0 {
            return Option<T>::None;
        }
        value := *<*mut T>(<usize>self.data + self.index * sizeof<T>);
        self.index += 1;
        self.remaining -= 1;
        Option<T>::Some { value = value; }
    }
}
