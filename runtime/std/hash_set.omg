# `std::hash_set` -- `HashSet<T>`, a thin wrapper around
# `HashMap<T, Unit>` (`Unit` a zero-sized `marker` payload, free in both
# storage and codegen -- see docs/language/marker-types.md), the same trick
# Rust's `HashSet<T> = HashMap<T, ()>` uses.
#
# `insert`/`remove`/`contains` return plain `bool`, not `Option<T>` --
# there's no payload beyond presence itself. Same allocator/cleanup story
# as every other owning type here:
#
#   set := HashSet<i32>::new();
#   defer set.free();

import super::hash_map::HashMap;
import super::hash_map::HashMapIterator;
import super::hash::Hash;

marker Unit {}

exposed struct HashSet<T: Hash> {
    shared inner: HashMap<T, Unit>;

    exposed new() => Self {
        Self { inner = HashMap<T, Unit>::new(); }
    }

    exposed len(*self) => usize { self.inner.len() }
    exposed is_empty(*self) => bool { self.inner.is_empty() }

    exposed insert(*mut self, value: T) => bool {
        old := self.inner.insert(value, Unit {});
        match old {
            Option::None => {
                true
            },
            Option::Some => {
                false
            },
        }
    }

    exposed contains(*self, value: T) => bool {
        self.inner.contains_key(value)
    }

    exposed remove(*mut self, value: T) => bool {
        old := self.inner.remove(value);
        match old {
            Option::Some => {
                true
            },
            Option::None => {
                false
            },
        }
    }

    exposed clear(*mut self) => void {
        self.inner.clear();
    }

    exposed free(*mut self) => void {
        self.inner.free();
    }

}

meet<T: Hash> ToIterator<T> for HashSet<T> {
    to_iterator(*self) => HashSetIterator<T> {
        HashSetIterator<T> { inner = self.inner.to_iterator(); }
    }
}

exposed struct HashSetIterator<T> {
    shared inner: HashMapIterator<T, Unit>;

}

meet<T> Iterator<T> for HashSetIterator<T> {
    next(*mut self) => Option<T> {
        kv := self.inner.next();
        match kv {
            Option::Some => {
                Option<T>::Some { value = kv.value.key; }
            },
            Option::None => {
                Option<T>::None
            },
        }
    }
}
