# `std::linked_list` -- `LinkedList<T>`, a doubly linked list. Each element is
# its own individual heap allocation (`Node<T>`), unlike `List<T>`'s one
# contiguous buffer. Same allocator/no-RAII/explicit-`free` story as
# `std::list::List<T>`:
#
#   list := LinkedList<i32>::new();
#   defer list.free();

import super::alloc::alloc;
import super::alloc::free;

# `Node<T>` is hidden (module-scoped); its fields are `shared` rather than
# hidden since `LinkedList<T>`/`LinkedListIterator<T>` (both in this file)
# need to read/write them directly, and a hidden field is visible only
# within its own type's methods.
struct Node<T> {
    shared value: T;
    shared prev: ^Node<T>;
    shared next: ^Node<T>;
}

exposed struct LinkedList<T> {
    shared head: ^Node<T>;
    shared tail: ^Node<T>;
    shared count: usize;

    exposed new() => Self {
        Self { head = <^Node<T>>0; tail = <^Node<T>>0; count = 0; }
    }

    exposed len(*self) => usize { self.count }
    exposed is_empty(*self) => bool { self.count == 0 }

    exposed push_back(^self, value: T) => void {
        new_node := <^Node<T>>alloc(sizeof<Node<T>>, alignof<Node<T>>);
        old_tail := self.tail;
        new_node.* = Node<T> { value = value; prev = old_tail; next = <^Node<T>>0; };
        if old_tail == <^Node<T>>0 {
            self.head = new_node;
        } else {
            old_tail.*.next = new_node;
        }
        self.tail = new_node;
        self.count += 1;
    }

    exposed push_front(^self, value: T) => void {
        new_node := <^Node<T>>alloc(sizeof<Node<T>>, alignof<Node<T>>);
        old_head := self.head;
        new_node.* = Node<T> { value = value; prev = <^Node<T>>0; next = old_head; };
        if old_head == <^Node<T>>0 {
            self.tail = new_node;
        } else {
            old_head.*.prev = new_node;
        }
        self.head = new_node;
        self.count += 1;
    }

    exposed pop_back(^self) => Option<T> {
        if self.tail == <^Node<T>>0 {
            return Option<T>::None;
        }
        old_tail := self.tail;
        value := old_tail.*.value;
        new_tail := old_tail.*.prev;
        if new_tail == <^Node<T>>0 {
            self.head = <^Node<T>>0;
        } else {
            new_tail.*.next = <^Node<T>>0;
        }
        self.tail = new_tail;
        self.count -= 1;
        free(<*u8>old_tail);
        Option<T>::Some { value = value; }
    }

    exposed pop_front(^self) => Option<T> {
        if self.head == <^Node<T>>0 {
            return Option<T>::None;
        }
        old_head := self.head;
        value := old_head.*.value;
        new_head := old_head.*.next;
        if new_head == <^Node<T>>0 {
            self.tail = <^Node<T>>0;
        } else {
            new_head.*.prev = <^Node<T>>0;
        }
        self.head = new_head;
        self.count -= 1;
        free(<*u8>old_head);
        Option<T>::Some { value = value; }
    }

    exposed clear(^self) => void {
        ^current := self.head;
        while current != <^Node<T>>0 {
            next := current.*.next;
            free(<*u8>current);
            current = next;
        }
        self.head = <^Node<T>>0;
        self.tail = <^Node<T>>0;
        self.count = 0;
    }

    exposed free(^self) => void {
        self.clear();
    }

}

meet<T> ToIterator<T> for LinkedList<T> {
    to_iterator(*self) => LinkedListIterator<T> {
        LinkedListIterator<T> { current = self.head; }
    }
}

exposed struct LinkedListIterator<T> {
    shared current: ^Node<T>;

}

meet<T> Iterator<T> for LinkedListIterator<T> {
    next(^self) => Option<T> {
        if self.current == <^Node<T>>0 {
            return Option<T>::None;
        }
        value := self.current.*.value;
        self.current = self.current.*.next;
        Option<T>::Some { value = value; }
    }
}
