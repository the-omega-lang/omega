# `std::alloc` -- a thin, deliberately non-generic wrapper around
# `core::platform::GlobalAllocator`, used by every generic collection here
# instead of calling the gap directly. Originally a workaround for a
# codegen bug (now fixed, see docs/architecture/module-driver-and-linkage.md); kept because
# calling the gap directly from each generic method empirically made gap
# reachability worse, not better (more distinct symbol references baked
# into `std.o`). Do not inline this back into the generic methods.

internal alloc(size: usize) => *mut u8 {
    GlobalAllocator::alloc(size)
}

internal free(ptr: *u8) => void {
    GlobalAllocator::free(ptr);
}

internal realloc(ptr: *u8, size: usize) => *mut u8 {
    GlobalAllocator::realloc(ptr, size)
}
