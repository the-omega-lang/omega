# `std::hash` -- a value's own contribution to a hash-based collection's
# bucket index. Contract: values equal under `cmp::Eq::equals` must produce
# the same hash (the reverse isn't required).
#
# `HashMap<K: Hash, V>`/`HashSet<T: Hash>` bound only on `Hash`, not a
# combined `Hash`-and-`Eq` spec -- a generic parameter carries only one
# formal bound, so `HashMap` calls `Eq::equals` directly at its concrete key
# instantiation; a `K` without `Eq` fails there instead of at a second bound.

exposed spec Hash {
    hash(*self) => u64;
}
