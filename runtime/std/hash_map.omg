# `std::hash_map` -- `HashMap<K, V>`, separate-chaining hash map. Bound
# only on `K: Hash` (a generic parameter carries one formal bound); `Eq`
# is selected explicitly at each use below.
#
# Separate chaining, not open addressing -- simpler to get correct (no
# tombstones, no probe-sequence resize dance). Same allocator/no-RAII/
# explicit-`free` story as every other owning type here:
#
#   map := HashMap<i32, *str>::new();
#   defer map.free();
#
# `insert`/`get`/`remove` return `Option<V>`, following Rust's `HashMap`
# shape (no existing Omega precedent to match here).

import alloc::alloc;
import alloc::free;
import extern::core::cmp::Eq;
import hash::Hash;

# Hidden (module-scoped), `internal` fields -- see `std::linked_list::Node<T>`.
struct Entry<K, V> {
    internal key: K;
    internal value: V;
    internal next: *mut Entry<K, V>;
}

# The iteration output shape -- decoupled from `Entry<K, V>`'s own
# internal chaining representation on purpose, so `HashMap`'s own storage
# strategy could change later without changing what iterating it produces.
exposed struct KeyValue<K, V> {
    exposed key: K;
    exposed value: V;
}

exposed struct HashMap<K: Hash, V> {
    internal buckets: *mut *mut Entry<K, V>;
    internal bucket_count: usize;
    internal count: usize;

    # `idx`'s slot address within an arbitrary bucket array (not necessarily
    # `self.buckets` -- `resize` needs this for both old and new arrays at
    # once). Static since it's needed before `Self` exists, in `new`.
    bucket_slot_in(buckets: *mut *mut Entry<K, V>, idx: usize) => *mut *mut Entry<K, V> {
        <*mut *mut Entry<K, V>>(<usize>buckets + idx * sizeof<*mut Entry<K, V>>)
    }

    # Allocates `n` bucket slots, all zeroed (null) -- allocation is never
    # guaranteed zeroed, so each slot is written explicitly. Shared by
    # `new`/`resize`.
    alloc_buckets(n: usize) => *mut *mut Entry<K, V> {
        buckets := <*mut *mut Entry<K, V>>alloc(n * sizeof<*mut Entry<K, V>>);
        mut i : usize = 0;
        while i < n {
            *Self::bucket_slot_in(buckets, i) = <*mut Entry<K, V>>0;
            i += 1;
        }
        buckets
    }

    bucket_slot(*self, idx: usize) => *mut *mut Entry<K, V> {
        Self::bucket_slot_in(self.buckets, idx)
    }

    bucket_index(*self, key: K) => usize {
        <usize>(Hash::hash(key) % <u64>self.bucket_count)
    }

    exposed new() => Self {
        Self { buckets = Self::alloc_buckets(16); bucket_count = 16; count = 0; }
    }

    exposed len(*self) => usize { self.count }
    exposed is_empty(*self) => bool { self.count == 0 }

    # Doubles `bucket_count` and relinks every existing entry into the new
    # array in place -- no entry itself is reallocated, only its `next`
    # pointer and whichever bucket slot holds it change.
    resize(*mut self, new_bucket_count: usize) => void {
        old_buckets := self.buckets;
        old_bucket_count := self.bucket_count;
        new_buckets := Self::alloc_buckets(new_bucket_count);
        self.buckets = new_buckets;
        self.bucket_count = new_bucket_count;

        mut b : usize = 0;
        while b < old_bucket_count {
            mut current := *Self::bucket_slot_in(old_buckets, b);
            while current != <*mut Entry<K, V>>0 {
                next := (*current).next;
                idx := self.bucket_index((*current).key);
                (*current).next = *self.bucket_slot(idx);
                *self.bucket_slot(idx) = current;
                current = next;
            }
            b += 1;
        }
        free(<*u8>old_buckets);
    }

    exposed insert(*mut self, key: K, value: V) => Option<V> {
        if (self.count + 1) * 4 > self.bucket_count * 3 {
            self.resize(self.bucket_count * 2);
        }
        idx := self.bucket_index(key);
        mut current := *self.bucket_slot(idx);
        while current != <*mut Entry<K, V>>0 {
            if Eq::equals((*current).key, key) {
                old_value := (*current).value;
                (*current).value = value;
                return Option<V>::Some { value = old_value; };
            }
            current = (*current).next;
        }
        new_entry := <*mut Entry<K, V>>alloc(sizeof<Entry<K, V>>);
        *new_entry = Entry<K, V> { key = key; value = value; next = *self.bucket_slot(idx); };
        *self.bucket_slot(idx) = new_entry;
        self.count += 1;
        Option<V>::None
    }

    exposed get(*self, key: K) => Option<V> {
        idx := self.bucket_index(key);
        mut current := *self.bucket_slot(idx);
        while current != <*mut Entry<K, V>>0 {
            if Eq::equals((*current).key, key) {
                return Option<V>::Some { value = (*current).value; };
            }
            current = (*current).next;
        }
        Option<V>::None
    }

    exposed contains_key(*self, key: K) => bool {
        idx := self.bucket_index(key);
        mut current := *self.bucket_slot(idx);
        while current != <*mut Entry<K, V>>0 {
            if Eq::equals((*current).key, key) {
                return true;
            }
            current = (*current).next;
        }
        false
    }

    exposed remove(*mut self, key: K) => Option<V> {
        idx := self.bucket_index(key);
        mut current := *self.bucket_slot(idx);
        mut prev := <*mut Entry<K, V>>0;
        while current != <*mut Entry<K, V>>0 {
            if Eq::equals((*current).key, key) {
                if prev == <*mut Entry<K, V>>0 {
                    *self.bucket_slot(idx) = (*current).next;
                } else {
                    (*prev).next = (*current).next;
                }
                value := (*current).value;
                free(<*u8>current);
                self.count -= 1;
                return Option<V>::Some { value = value; };
            }
            prev = current;
            current = (*current).next;
        }
        Option<V>::None
    }

    exposed clear(*mut self) => void {
        mut b : usize = 0;
        while b < self.bucket_count {
            mut current := *self.bucket_slot(b);
            while current != <*mut Entry<K, V>>0 {
                next := (*current).next;
                free(<*u8>current);
                current = next;
            }
            *self.bucket_slot(b) = <*mut Entry<K, V>>0;
            b += 1;
        }
        self.count = 0;
    }

    exposed free(*mut self) => void {
        self.clear();
        free(<*u8>self.buckets);
    }

}

conform<K: Hash, V> HashMap<K, V> to ToIterator<KeyValue<K, V>> {
    to_iterator(*self) => HashMapIterator<K, V> {
        HashMapIterator<K, V> {
            buckets = self.buckets;
            bucket_count = self.bucket_count;
            bucket_index = 0;
            current = <*mut Entry<K, V>>0;
        }
    }
}

exposed struct HashMapIterator<K, V> {
    internal buckets: *mut *mut Entry<K, V>;
    internal bucket_count: usize;
    internal bucket_index: usize;
    internal current: *mut Entry<K, V>;

}

conform<K, V> HashMapIterator<K, V> to Iterator<KeyValue<K, V>> {
    next(*mut self) => Option<KeyValue<K, V>> {
        while self.current == <*mut Entry<K, V>>0 {
            if self.bucket_index >= self.bucket_count {
                return Option<KeyValue<K, V>>::None;
            }
            self.current = *<*mut *mut Entry<K, V>>(<usize>self.buckets + self.bucket_index * sizeof<*mut Entry<K, V>>);
            self.bucket_index += 1;
        }
        entry := self.current;
        self.current = (*entry).next;
        Option<KeyValue<K, V>>::Some { value = KeyValue<K, V> { key = (*entry).key; value = (*entry).value; }; }
    }
}
