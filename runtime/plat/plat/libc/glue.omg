# `plat`'s `libc` platform: the default, OS-agnostic `@glue` for
# `core::glue::GlobalAllocator`, backed directly by libc's own
# `malloc`/`free`/`realloc` (see `sys.omg`). No page-level allocation, no
# alignment beyond whatever libc's own `malloc` already guarantees, and no
# error handling beyond a straight pass-through -- the gap's own signature
# has no failure channel (no `Option`/`Result`) to put anything else in.

import sys;

@glue
exposed marker LibcAllocator : core::glue::GlobalAllocator {
    exposed alloc(size: usize) => *u8 {
        return sys::malloc(size);
    }

    exposed free(ptr: *u8) => void {
        sys::free(ptr);
    }

    exposed realloc(ptr: *u8, size: usize) => *u8 {
        return sys::realloc(ptr, size);
    }
}
