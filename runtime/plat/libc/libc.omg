# `plat`'s `libc` platform: the default, OS-agnostic `@glue` for
# `core::glue::GlobalAllocator`, backed directly by libc's own
# `malloc`/`free`/`realloc`. No page-level allocation, no alignment beyond
# whatever libc's own `malloc` already guarantees, and no error handling
# beyond a straight pass-through -- the gap's own signature has no failure
# channel (no `Option`/`Result`) to put anything else in.
#
# This directory is honestly named `libc` -- it's compiled and registered
# as the package `plat` purely via `--name=plat`/`--extern=plat:...`
# (see `docs/22-platform-glue.md`), never by renaming this file. The two
# `free`s below (the raw extern and this marker's own required method)
# are a real, intentional name collision, confirmed safe: a bare call
# inside a method's own body always resolves through ordinary module-level
# resolution, never implicitly back to the enclosing method itself.

internal extern malloc : (size: usize) => *mut u8;
internal extern free : (ptr: *u8) => void;
internal extern realloc : (ptr: *u8, size: usize) => *mut u8;
internal extern write : (fd: i32, buf: *u8, count: usize) => isize;
internal extern read : (fd: i32, buf: *mut u8, count: usize) => isize;

@glue
exposed marker LibcAllocator : core::glue::GlobalAllocator {
    exposed alloc(size: usize) => *mut u8 {
        return malloc(size);
    }

    exposed free(ptr: *u8) => void {
        free(ptr);
    }

    exposed realloc(ptr: *u8, size: usize) => *mut u8 {
        return realloc(ptr, size);
    }
}

# `StandardOutput::write` and `StandardError::write` deliberately have the
# same method signature. Current glue lowering exports one symbol per marker
# method, so each stream needs its own marker to preserve both gap symbols.
@glue
exposed marker LibcStandardOutput : core::glue::StandardOutput {
    exposed write(bytes: *[?]u8, written: *mut usize) => bool {
        count := write(1, <*u8>bytes, <usize>bytes.length);
        if count < 0isize { false } else {
            *written = <usize>count;
            true
        }
    }
}

@glue
exposed marker LibcStandardError : core::glue::StandardError {
    exposed write(bytes: *[?]u8, written: *mut usize) => bool {
        count := write(2, <*u8>bytes, <usize>bytes.length);
        if count < 0isize { false } else {
            *written = <usize>count;
            true
        }
    }
}

@glue
exposed marker LibcStandardInput : core::glue::StandardInput {
    exposed read(into: *mut [?]u8, count: *mut usize) => bool {
        read_count := read(0, <*mut u8>into, <usize>into.length);
        if read_count < 0isize { false } else {
            *count = <usize>read_count;
            true
        }
    }
}
