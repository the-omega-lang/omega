# `plat`'s `libc` platform: default OS-agnostic `glue` for
# `core::platform::GlobalAllocator`, backed directly by libc's
# `malloc`/`free`/`realloc`. No page-level allocation or alignment beyond
# what `malloc` guarantees; no error handling beyond pass-through, since the
# gap's signature has no failure channel.
#
# This directory is named `libc` but registers as package `plat` via
# `--name=plat`/`--import=plat:...` (see docs/guide/platform-glue.md), not by
# renaming the file. The two `free`s below (raw foreign declaration and glue
# function) are an intentional, confirmed-safe name collision.

shared foreign(c) malloc(size: usize) => *mut u8;
shared foreign(c) free(ptr: *u8) => void;
shared foreign(c) realloc(ptr: *u8, size: usize) => *mut u8;
shared foreign(c) write(fd: i32, buf: *u8, count: usize) => isize;
shared foreign(c) read(fd: i32, buf: *mut u8, count: usize) => isize;

# Omega's root `main` is never itself the platform's native entry-point
# symbol (see docs/language/foreign-function-interface.md, "Program entry
# point"); it is emitted as the fixed internal symbol `_omg_main`, always
# Omega-convention. This adapter owns the real libc-facing `main` -- a
# `foreign(c)` definition with its forced C-facing symbol -- and hands off to
# it.
foreign _omg_main : () => void;

@mangling(force = "main")
foreign(c) platform_main() => i32 {
	_omg_main();
	return 0;
}

glue core::platform::GlobalAllocator {
    alloc(size: usize) => *mut u8 {
        return malloc(size);
    }

    free(ptr: *u8) => void {
        free(ptr);
    }

    realloc(ptr: *u8, size: usize) => *mut u8 {
        return realloc(ptr, size);
    }
}

glue core::platform::StandardOutput {
    write(bytes: *[]u8) => Option<usize> {
        count := write(1, <*u8>bytes, <usize>bytes.length);
        if count < 0isize { Option<usize>::None } else {
            Option<usize>::Some { value = <usize>count; }
        }
    }
}

glue core::platform::StandardError {
    write(bytes: *[]u8) => Option<usize> {
        count := write(2, <*u8>bytes, <usize>bytes.length);
        if count < 0isize { Option<usize>::None } else {
            Option<usize>::Some { value = <usize>count; }
        }
    }
}

glue core::platform::StandardInput {
    read(into: *mut []u8) => Option<usize> {
        read_count := read(0, <*mut u8>into, <usize>into.length);
        if read_count < 0isize { Option<usize>::None } else {
            Option<usize>::Some { value = <usize>read_count; }
        }
    }
}

# Panic policy for a hosted libc target: report the site on stderr, then
# `abort`. `abort` rather than `exit` because a panic means an invariant the
# program was built on no longer holds -- running `atexit` handlers and stdio
# flushes on top of that broken state is not cleanup, and the resulting
# SIGABRT leaves a core dump for the debugger. A freestanding target that
# wants a trap, a reset, or a status LED supplies its own glue instead.
shared foreign(c) abort() => never;

# Issued in pieces rather than assembled in one buffer: the message is an
# arbitrary `*str`, and truncating it would lose exactly what the panic
# exists to report. A handler that is already terminating has nowhere to
# report a failed write, so it stops instead of retrying forever.
panic_write(bytes: *[]u8) => void {
    mut written: i32 = 0;
    while written < bytes.length {
        rest := &bytes[written..];
        count := write(2, <*u8>rest, <usize>rest.length);
        if count <= 0isize { break; }
        written = written + <i32>count;
    }
}

# Digits are produced least-significant first, so they are filled in from the
# end of the buffer and sliced from there. `plat` sits below `std` and cannot
# reach `std::fmt`, and a `u32` needs at most ten decimal digits.
panic_write_u32(value: u32) => void {
    mut digits: [10]u8;
    mut start: i32 = 10;
    mut current := value;
    loop {
        start = start - 1;
        digits[start] = 48u8 + <u8>(current % 10u32);
        current = current / 10u32;
        if current == 0u32 { break; }
    }
    panic_write(&digits[start..]);
}

glue core::panic::PanicHandler {
    panic(info: *PanicInfo) => never {
        panic_write(b"panicked at ");
        panic_write(info.source_file.as_bytes());
        panic_write(b":");
        panic_write_u32(info.line);
        panic_write(b":");
        panic_write_u32(info.column);
        if !info.message.is_empty() {
            panic_write(b": ");
            panic_write(info.message.as_bytes());
        }
        panic_write(b"\n");
        abort()
    }
}
