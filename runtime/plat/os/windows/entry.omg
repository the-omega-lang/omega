# The executable entry point. Windows calls it like an ordinary function of
# the target's C convention, so unlike the ELF targets this needs no naked
# body -- the loader has already established a normal stack frame.
#
# The symbol is named for what it is. It is deliberately not `mainCRTStartup`
# or `WinMainCRTStartup`: naming it after the Microsoft C runtime would claim
# a CRT contract this platform does not implement. The link selects it with
# `/ENTRY:omg_start` (see docs/guide/platform-glue.md).
#
# Startup is the one platform facility a build can decline, with
# `omega_no_startup`. The import and the `_omg_main` binding below exist only
# for the entry point, so they share its condition.
@cond(not(def::omega_no_startup))
import root::os::api;

# The fixed symbol Omega emits for the root `main`
# (docs/language/foreign-function-interface.md).
@cond(not(def::omega_no_startup))
foreign _omg_main : () => void;

@cond(not(def::omega_no_startup))
@symbol(name = "omg_start")
foreign(c) process_entry() => never {
	_omg_main();
	api::ExitProcess(0u32)
}
