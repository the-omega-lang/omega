# `GlobalAllocator` over the process heap. The heap belongs to the process,
# not to a C runtime, so this needs no CRT initialization: `GetProcessHeap`
# is valid from the first instruction of the program.
import root::os::api;

glue core::platform::GlobalAllocator {
	alloc(size: usize) => *mut u8 {
		heap := api::GetProcessHeap();
		if api::usable(heap) {
			api::HeapAlloc(heap, 0u32, size)
		} else {
			<*mut u8>0usize
		}
	}

	free(ptr: *u8) => void {
		if <usize>ptr != 0usize {
			heap := api::GetProcessHeap();
			if api::usable(heap) {
				<void>api::HeapFree(heap, 0u32, ptr);
			}
		}
	}

	# `HeapReAlloc` already returns null and leaves the original block valid
	# when it cannot satisfy the request, which is exactly the contract.
	realloc(ptr: *u8, size: usize) => *mut u8 {
		if <usize>ptr == 0usize {
			GlobalAllocator::alloc(size)
		} else {
			heap := api::GetProcessHeap();
			if api::usable(heap) {
				api::HeapReAlloc(heap, 0u32, <*mut u8>(<usize>ptr), size)
			} else {
				<*mut u8>0usize
			}
		}
	}
}
