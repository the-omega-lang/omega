# `GlobalAllocator` directly over anonymous private mappings: no libc heap, no
# free-list, and no shared bookkeeping. Each allocation is its own mapping,
# which keeps the implementation small and makes `free` exact.
#
# The mapping length is recorded in a header immediately before the block the
# caller sees, because `free` receives only an address and `munmap` needs a
# length. `munmap` rounds a length up to the page size the same way `mmap`
# did, so the recorded byte count works on every Linux page size and this file
# never has to know which one the kernel uses.
import root::os::syscall;

# 16 bytes, not `sizeof<usize>`: a mapping starts page-aligned, so a 16-byte
# header keeps the returned block 16-byte aligned. That is a property of this
# raw byte allocator, not a promise covering every Omega value -- a stronger
# `@layout(align)` is satisfied by `std::alloc`, which over-allocates here and
# rounds the address up itself.
comp HEADER := 16usize;

length_of(block: *u8) => *mut usize {
	<*mut usize>(<usize>block - HEADER)
}

copy_bytes(destination: *mut u8, source: *u8, count: usize) => void {
	mut index: usize = 0;
	while index < count {
		*<*mut u8>(<usize>destination + index) = *<*u8>(<usize>source + index);
		index = index + 1;
	}
}

glue core::platform::GlobalAllocator {
	alloc(size: usize) => *mut u8 {
		total := size + HEADER;
		# A request large enough to wrap the header addition would otherwise
		# map far less memory than the caller asked for.
		if total < size { return <*mut u8>0usize; }

		base := syscall::map_anonymous(total);
		if <usize>base == 0usize { return <*mut u8>0usize; }

		*<*mut usize>base = total;
		<*mut u8>(<usize>base + HEADER)
	}

	free(ptr: *u8) => void {
		if <usize>ptr != 0usize {
			total := *length_of(ptr);
			syscall::unmap(<*u8>(<usize>ptr - HEADER), total);
		}
	}

	# The replacement is allocated before the original is released, so a
	# failed `realloc` returns null with the old block still valid.
	realloc(ptr: *u8, size: usize) => *mut u8 {
		if <usize>ptr == 0usize { return GlobalAllocator::alloc(size); }

		replacement := GlobalAllocator::alloc(size);
		if <usize>replacement == 0usize { return <*mut u8>0usize; }

		previous_size := *length_of(ptr) - HEADER;
		kept := if previous_size < size { previous_size } else { size };
		copy_bytes(replacement, ptr, kept);
		GlobalAllocator::free(ptr);
		replacement
	}
}
