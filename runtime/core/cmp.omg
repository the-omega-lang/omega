# `core::cmp` -- allocation-free comparison interfaces (`Eq`, `Ord`), plus
# the three-way result `Ord::compare` reports through. `Eq` and `Ord` are
# kept separate (unlike Rust's Partial/total split, collapsed here since
# there's no partial/total distinction) so a type like `f32`/`f64` can be
# equality-comparable without claiming a total order `NaN` breaks.

exposed enum Ordering {
    Less,
    Equal,
    Greater;

    exposed is_lt(*self) => bool {
        match self {
            Ordering::Less => {
                true
            }
        } else {
            false
        }
    }

    exposed is_eq(*self) => bool {
        match self {
            Ordering::Equal => {
                true
            }
        } else {
            false
        }
    }

    exposed is_gt(*self) => bool {
        match self {
            Ordering::Greater => {
                true
            }
        } else {
            false
        }
    }

    exposed reverse(*self) => Ordering {
        match self {
            Ordering::Less => {
                Ordering::Greater
            }
        } else {
            match self {
                Ordering::Greater => {
                    Ordering::Less
                }
            } else {
                Ordering::Equal
            }
        }
    }
}

exposed spec Eq {
    equals(*self, other: Self) => bool;

    not_equals(*self, other: Self) => bool {
        if self.equals(other) { false } else { true }
    }
}

# `Ord` declares only its own ordering requirement -- no `: Eq`, since specs
# don't provision other specs here. The `Ord`-implies-`Eq` convenience comes
# from the blanket `conform` below instead. `less_than`/`greater_than`/
# `min`/`max` all derive from `compare` alone; implementors may override any
# for speed (see `core::primitives::numerics`).
exposed spec Ord {
    compare(*self, other: Self) => Ordering;

    less_than(*self, other: Self) => bool {
        self.compare(other).is_lt()
    }

    greater_than(*self, other: Self) => bool {
        self.compare(other).is_gt()
    }

    less_or_equal(*self, other: Self) => bool {
        if self.greater_than(other) { false } else { true }
    }

    greater_or_equal(*self, other: Self) => bool {
        if self.less_than(other) { false } else { true }
    }

    min(*self, other: Self) => Self {
        if self.less_or_equal(other) { *self } else { other }
    }

    max(*self, other: Self) => Self {
        if self.greater_or_equal(other) { *self } else { other }
    }
}

# Anything with a total order can be checked for equality via
# `compare(a, b).is_eq()`. A concrete `conform T to Eq` beats this blanket.
conform<T: Ord> T to Eq {
    equals(*self, other: Self) => bool { self.compare(other).is_eq() }
}
