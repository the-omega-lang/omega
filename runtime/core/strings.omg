# `core::strings` -- `str`'s own inherent methods, plus its `Eq` conformance.
# `str` is already a sized (byte count, not character count -- see `.size`
# below) fat pointer (`Context::resolve_pointer_type`'s `*str`), never
# null-terminated, so everything here works off `.size` and byte comparisons
# rather than any terminator scan. The inherent methods are `exposed`, so they
# are callable public API on their own, with no spec involved.
#
# The `Eq` conformance lives here rather than in `std::primitives` only
# because `core::cmp` owns `Eq`: `str` has no declaring package of its own, so
# under the orphan rule the package that owns the *spec* is the only one that
# may conform it. Hashing and formatting conformances for `str` stay in `std`
# for exactly the same reason, since `std` still owns those specs.

import cmp::Eq;

conform str to Eq {
    equals(*self, other: Self) => bool {
        if self.size != other.size { return false; }
        a := <*[]u8>self;
        b := <*[]u8>other;
        mut i : i32 = 0;
        while i < self.size {
            if a[i] != b[i] { return false; }
            i = i + 1;
        }
        true
    }
}

primitive str {
    exposed is_empty(*self) => bool {
        self.size == 0
    }

    # A plain reinterpretation, not a copy -- `*str` and `*[]u8` share the
    # exact same fat-pointer leaf layout (data pointer + byte count --
    # `*str`'s `.size` and `*[]u8`'s `.length` read the identical leaf).
    exposed as_bytes(*self) => *[]u8 {
        <*[]u8>self
    }

    exposed starts_with(*self, prefix: Self) => bool {
        if prefix.size > self.size {
            return false;
        }
        a := <*[]u8>self;
        b := <*[]u8>prefix;
        mut i : i32 = 0;
        while i < prefix.size {
            if a[i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    exposed ends_with(*self, suffix: Self) => bool {
        if suffix.size > self.size {
            return false;
        }
        offset := self.size - suffix.size;
        a := <*[]u8>self;
        b := <*[]u8>suffix;
        mut i : i32 = 0;
        while i < suffix.size {
            if a[offset + i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    # Naive (no Boyer-Moore/KMP skip table) substring search -- `O(n*m)`,
    # deliberately: a skip table needs working memory proportional to the
    # needle, which is exactly the kind of hidden allocation this layer
    # never does. Fine for the short, mostly-literal needles this is
    # actually used with; a caller with real throughput needs is expected
    # to bring their own algorithm, not lean on this one.
    exposed contains(*self, needle: Self) => bool {
        if needle.size == 0 {
            return true;
        }
        if needle.size > self.size {
            return false;
        }
        a := <*[]u8>self;
        b := <*[]u8>needle;
        mut start : i32 = 0;
        while start <= self.size - needle.size {
            mut matched := true;
            mut i : i32 = 0;
            while i < needle.size {
                if a[start + i] != b[i] {
                    matched = false;
                }
                i = i + 1;
            }
            if matched {
                return true;
            }
            start = start + 1;
        }
        false
    }

}
