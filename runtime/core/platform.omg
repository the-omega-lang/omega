# Platform-capability gaps: functionality with no single portable answer --
# the target platform or final application supplies one via a `glue` block.
# See docs/21-gaps-and-glue.md. This file only adds gaps, never their glue.

import option::Option;

# The global heap allocator: every function required (no default body, see
# docs/21-gaps-and-glue.md), self-less (called via
# `core::platform::GlobalAllocator::alloc(...)`, never through an instance).
#
# `alloc`/`realloc` return `*mut u8` since freshly allocated memory must be
# writable, and a plain `*u8` can't cast to `*mut T`. `free` takes a plain
# `*u8` -- freeing needs only an address, and `*mut u8` widens to it anyway.
gap GlobalAllocator {
    alloc(size: usize) => *mut u8;
    free(ptr: *u8) => void;
    realloc(ptr: *u8, size: usize) => *mut u8;
}

# Console capabilities stay separate: a platform can provide output without
# input. `None` is failure; `Some(0)` remains a valid short write or EOF.
gap StandardOutput {
    write(bytes: *[]u8) => Option<usize>;
}

gap StandardError {
    write(bytes: *[]u8) => Option<usize>;
}

gap StandardInput {
    read(into: *mut []u8) => Option<usize>;
}
