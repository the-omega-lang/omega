# `core::primitives::strings` -- `str`'s own inherent methods, plus `Eq`.
# `str` is a sized (byte count, not character count) fat pointer, never
# null-terminated, so everything here works off `.size` and byte comparisons
# rather than a terminator scan.
#
# `Eq` conforms here rather than in `std::primitives` because `core::cmp`
# owns `Eq` and, under the orphan rule, only the spec's owning package may
# conform it -- hashing/formatting for `str` stay in `std` for the same reason.

import root::cmp::Eq;
import root::iterator::Iterator;
import root::iterator::ToIterator;
import root::option::Option;

meet Eq for str {
    equals(*self, other: Self) => bool {
        if self.size != other.size { return false; }
        a := <*[]u8>self;
        b := <*[]u8>other;
        ^i : i32 = 0;
        while i < self.size {
            if a[i] != b[i] { return false; }
            i = i + 1;
        }
        true
    }
}

primitive str {
    exposed is_empty(*self) => bool {
        self.size == 0
    }

    # Reinterpretation, not a copy -- `*str` and `*[]u8` share the same
    # fat-pointer leaf layout (data pointer + byte count).
    exposed as_bytes(*self) => *[]u8 {
        <*[]u8>self
    }

    exposed starts_with(*self, prefix: Self) => bool {
        if prefix.size > self.size {
            return false;
        }
        a := <*[]u8>self;
        b := <*[]u8>prefix;
        ^i : i32 = 0;
        while i < prefix.size {
            if a[i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    exposed ends_with(*self, suffix: Self) => bool {
        if suffix.size > self.size {
            return false;
        }
        offset := self.size - suffix.size;
        a := <*[]u8>self;
        b := <*[]u8>suffix;
        ^i : i32 = 0;
        while i < suffix.size {
            if a[offset + i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    # Naive `O(n*m)` search, deliberately -- a skip table (Boyer-Moore/KMP)
    # needs working memory proportional to the needle, which this
    # allocation-free layer never does.
    exposed contains(*self, needle: Self) => bool {
        if needle.size == 0 {
            return true;
        }
        if needle.size > self.size {
            return false;
        }
        a := <*[]u8>self;
        b := <*[]u8>needle;
        ^start : i32 = 0;
        while start <= self.size - needle.size {
            ^matched := true;
            ^i : i32 = 0;
            while i < needle.size {
                if a[start + i] != b[i] {
                    matched = false;
                }
                i = i + 1;
            }
            if matched {
                return true;
            }
            start = start + 1;
        }
        false
    }

}

# `for c in text` decodes UTF-8 one `char` at a time, without allocating.
# `*str` is not checked for validity on construction, so each maximal
# subpart of an ill-formed sequence yields one U+FFFD, as Unicode's
# "substitution of maximal subparts" (and Rust's lossy decoding) does.
exposed struct Chars {
    shared bytes: *[]u8;
    shared index: i32;
}

meet ToIterator<char> for str {
    to_iterator(*self) => Chars {
        Chars { bytes = <*[]u8>self; index = 0; }
    }
}

meet Iterator<char> for Chars {
    next(^self) => Option<char> {
        if self.index >= self.bytes.length {
            return Option<char>::None;
        }
        lead := <u32>self.bytes[self.index];
        self.index += 1;
        if lead < 0x80_u32 {
            return char::from_u32(lead);
        }
        # The continuation count, the leading bits, and the range the first
        # continuation must fall in -- narrower than 0x80..=0xBF exactly where
        # a wider one would admit an overlong form, a surrogate, or a value
        # past U+10FFFF.
        ^remaining := 0;
        ^scalar := 0_u32;
        ^low := 0x80_u32;
        ^high := 0xBF_u32;
        match lead {
            0xC2..=0xDF => { remaining = 1; scalar = lead & 0x1F_u32; },
            0xE0 => { remaining = 2; scalar = lead & 0x0F_u32; low = 0xA0_u32; },
            0xE1..=0xEC => { remaining = 2; scalar = lead & 0x0F_u32; },
            0xED => { remaining = 2; scalar = lead & 0x0F_u32; high = 0x9F_u32; },
            0xEE..=0xEF => { remaining = 2; scalar = lead & 0x0F_u32; },
            0xF0 => { remaining = 3; scalar = lead & 0x07_u32; low = 0x90_u32; },
            0xF1..=0xF3 => { remaining = 3; scalar = lead & 0x07_u32; },
            0xF4 => { remaining = 3; scalar = lead & 0x07_u32; high = 0x8F_u32; },
        } else {
            return char::from_u32(0xFFFD_u32);
        }
        while remaining > 0 {
            if self.index >= self.bytes.length {
                return char::from_u32(0xFFFD_u32);
            }
            next := <u32>self.bytes[self.index];
            if next < low || next > high {
                # The offending byte starts the next sequence.
                return char::from_u32(0xFFFD_u32);
            }
            scalar = (scalar << 6) | (next & 0x3F_u32);
            self.index += 1;
            low = 0x80_u32;
            high = 0xBF_u32;
            remaining -= 1;
        }
        char::from_u32(scalar)
    }
}
