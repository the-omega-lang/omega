# `core::primitives::chars` -- Unicode scalar values and their core behavior.
# `char::from_u32` is the supported checked path from a codepoint (rejects
# out-of-range values and UTF-16 surrogates); see docs/issues/known-issues.md
# for why it is not an enforcement boundary.

import root::cmp::Ord;
import root::cmp::Ordering;
import root::option::Option;
import root::range::Bounded;
import root::range::Successor;

primitive char {
    exposed from_u32(value: u32) => Option<char> {
        if value > 0x10FFFF_u32 {
            return Option<char>::None;
        }
        if value >= 0xD800_u32 {
            if value <= 0xDFFF_u32 {
                return Option<char>::None;
            }
        }
        # Pointer reinterpretation, safe here since the checks above already
        # established the bit pattern is a valid Unicode scalar.
        Option<char>::Some { value = *<*char>&value; }
    }

    exposed is_ascii(*self) => bool { <u32>*self <= 0x7F_u32 }
    exposed is_digit(*self) => bool {
        cp := <u32>*self;
        if cp < 0x30_u32 { false } else { cp <= 0x39_u32 }
    }
    # ASCII-only; see docs/issues/known-issues.md.
    exposed is_alphabetic(*self) => bool {
        cp := <u32>*self;
        if cp >= 0x41_u32 {
            if cp <= 0x5A_u32 { return true; }
        }
        if cp >= 0x61_u32 { cp <= 0x7A_u32 } else { false }
    }
    exposed is_whitespace(*self) => bool {
        cp := <u32>*self;
        if cp == 0x20_u32 { return true; }
        if cp >= 0x09_u32 { cp <= 0x0D_u32 } else { false }
    }
    exposed len_utf8(*self) => usize {
        cp := <u32>*self;
        if cp < 0x80_u32 { 1usize }
        else if cp < 0x800_u32 { 2usize }
        else if cp < 0x10000_u32 { 3usize }
        else { 4usize }
    }
    # Reinterpret directly rather than via `from_u32`: result is always
    # ASCII, so nothing a check could reject.
    exposed to_ascii_uppercase(*self) => char {
        mut cp := <u32>*self;
        if cp >= 0x61_u32 {
            if cp <= 0x7A_u32 {
                cp = cp - 0x20_u32;
                return *<*char>&cp;
            }
        }
        *self
    }
    exposed to_ascii_lowercase(*self) => char {
        mut cp := <u32>*self;
        if cp >= 0x41_u32 {
            if cp <= 0x5A_u32 {
                cp = cp + 0x20_u32;
                return *<*char>&cp;
            }
        }
        *self
    }
}

conform char to Ord {
    compare(*self, other: Self) => Ordering {
        if *self < other { Ordering::Less }
        else if *self > other { Ordering::Greater }
        else { Ordering::Equal }
    }
}

conform char to Successor {
    successor(*self) => Option<Self> {
        cp := <u32>*self;
        if cp == 0x10FFFF_u32 { return Option<char>::None; }
        if cp == 0xD7FF_u32 { return char::from_u32(0xE000_u32); }
        char::from_u32(cp + 1u32)
    }
}

conform char to Bounded {
    min() => Self { <char>0u8 }
    # `0x10FFFF` (char::MAX) is a known-valid scalar, so it skips `from_u32`
    # -- routing it through would need an unreachable `else` with no honest
    # value to return.
    max() => Self {
        cp := 0x10FFFF_u32;
        *<*char>&cp
    }
}
