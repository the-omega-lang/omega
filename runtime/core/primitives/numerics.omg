# `core::primitives::numerics` -- every scalar arithmetic type's primitive
# methods and spec conformances, generated by macro per type (identical
# bodies modulo `$T`), split into `signed_integer`/`unsigned_integer`/
# `float_ops` since each has a genuinely different member set.
#
# Every bare literal compared or combined with `*self` is cast to `Self`
# explicitly (`<Self>0`, not `0`) -- an untyped literal would otherwise
# default to `i32`, matching `Self` for only one of the twelve types here.
# `usize`/`isize` bounds derive from all-ones bit patterns rather than
# width-dependent literals, to stay correct on every target.

import root::cmp::Eq;
import root::cmp::Ord;
import root::cmp::Ordering;
import root::option::Option;
import root::range::Bounded;
import root::range::Successor;

macro signed_integer($T: type, $MAX: expr) => {
    conform $T to Ord {
        compare(*self, other: Self) => Ordering {
            if *self < other { Ordering::Less }
            else if *self > other { Ordering::Greater }
            else { Ordering::Equal }
        }
        min(*self, other: Self) => Self { if *self < other { *self } else { other } }
        max(*self, other: Self) => Self { if *self > other { *self } else { other } }
    }
    conform $T to Successor {
        successor(*self) => Option<Self> {
            if *self == $MAX { Option<Self>::None }
            else { Option<Self>::Some { value = *self + <Self>1; } }
        }
    }
    conform $T to Bounded {
        min() => Self { ~$MAX }
        max() => Self { $MAX }
    }
    primitive $T {
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        exposed is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        exposed is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        exposed abs(*self) => Self {
            if *self < <Self>0 { -*self } else { *self }
        }

        exposed signum(*self) => Self {
            if *self < <Self>0 { <Self>(-1) } else if *self > <Self>0 { <Self>1 } else { <Self>0 }
        }

        exposed is_negative(*self) => bool { *self < <Self>0 }
        exposed is_positive(*self) => bool { *self > <Self>0 }
    }
}

macro unsigned_integer($T: type, $MAX: expr) => {
    conform $T to Ord {
        compare(*self, other: Self) => Ordering {
            if *self < other { Ordering::Less }
            else if *self > other { Ordering::Greater }
            else { Ordering::Equal }
        }
        min(*self, other: Self) => Self { if *self < other { *self } else { other } }
        max(*self, other: Self) => Self { if *self > other { *self } else { other } }
    }
    conform $T to Successor {
        successor(*self) => Option<Self> {
            if *self == $MAX { Option<Self>::None }
            else { Option<Self>::Some { value = *self + <Self>1; } }
        }
    }
    conform $T to Bounded {
        min() => Self { <Self>0 }
        max() => Self { $MAX }
    }
    primitive $T {
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        exposed is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        exposed is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        # A power of two has exactly one bit set, so clearing its lowest set
        # bit (`self & (self - 1)`) leaves zero; `0` is excluded separately.
        exposed is_power_of_two(*self) => bool {
            if *self == <Self>0 { false } else { (*self & (*self - <Self>1)) == <Self>0 }
        }
    }
}

macro float_ops($T: type) => {
    # `Eq` but deliberately no `Ord`: `NaN` has no correct position in a
    # total order (see `core::cmp`).
    conform $T to Eq {
        equals(*self, other: Self) => bool { *self == other }
    }
    primitive $T {
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed abs(*self) => Self {
            if *self < <Self>0.0 { -*self } else { *self }
        }

        # `NaN` is the only IEEE 754 value unequal to itself -- a portable
        # test needing no bit-level trickery.
        exposed is_nan(*self) => bool { *self != *self }
    }
}

signed_integer$(i8, 127i8);
signed_integer$(i16, 32767i16);
signed_integer$(i32, 2147483647i32);
signed_integer$(i64, 9223372036854775807i64);
# `isize`/`usize` go through the same macro as every other width so they
# keep the identical method set. `$MAX` derives from an all-ones pattern
# (`~<usize>0`, shifted right one for the signed max) rather than a baked
# literal, so both stay correct on any target width.
signed_integer$(isize, <isize>((~<usize>0) >> 1usize));

unsigned_integer$(u8, 255u8);
unsigned_integer$(u16, 65535u16);
unsigned_integer$(u32, 4294967295u32);
unsigned_integer$(u64, 18446744073709551615u64);
unsigned_integer$(usize, ~<usize>0);

float_ops$(f32);
float_ops$(f64);
