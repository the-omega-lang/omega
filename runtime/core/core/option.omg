# `core::option` -- a real, generic "maybe a value" type. Variant order is
# load-bearing: `for <binding> in <iterator>` (see `core::iterator`) hand-
# builds its own desugared match against this exact enum, hardcoding
# `None` as variant 0 and `Some` as variant 1, rather than resolving them
# by name -- see `Analyzer::analyze_for_in`'s own doc comment for why.
# Don't reorder these without updating that code to match.

exposed enum Option<T> {
    None,
    Some { exposed value: T; };
}
