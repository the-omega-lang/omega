# `core::strings` -- `str`'s own methods. `str` is already a sized (byte
# count, not character count -- see `.size` below) fat pointer
# (`Context::resolve_pointer_type`'s `*str`), never null-terminated, so everything
# here works off `.size` and byte comparisons rather than any terminator
# scan. `StrOps` itself is `exposed` -- a spec function has no visibility
# modifier of its own (it always inherits whichever the declaring spec
# has), so this is what makes every method here ordinary, callable public
# API rather than an internal detail only reachable from within `core`.

import cmp::Eq;
import hash::Hash;
import fmt::Display;
import io::Writer;


exposed spec StrOps : Eq, Hash, Display for str {
    equals(*self, other: Self) => bool {
        if self.size != other.size {
            return false;
        }
        a := <*[?]u8>self;
        b := <*[?]u8>other;
        mut i : i32 = 0;
        while i < self.size {
            if a[i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    is_empty(*self) => bool {
        self.size == 0
    }

    # A plain reinterpretation, not a copy -- `*str` and `*[?]u8` share the
    # exact same fat-pointer leaf layout (data pointer + byte count --
    # `*str`'s `.size` and `*[?]u8`'s `.length` read the identical leaf).
    as_bytes(*self) => *[?]u8 {
        <*[?]u8>self
    }

    starts_with(*self, prefix: Self) => bool {
        if prefix.size > self.size {
            return false;
        }
        a := <*[?]u8>self;
        b := <*[?]u8>prefix;
        mut i : i32 = 0;
        while i < prefix.size {
            if a[i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    ends_with(*self, suffix: Self) => bool {
        if suffix.size > self.size {
            return false;
        }
        offset := self.size - suffix.size;
        a := <*[?]u8>self;
        b := <*[?]u8>suffix;
        mut i : i32 = 0;
        while i < suffix.size {
            if a[offset + i] != b[i] {
                return false;
            }
            i = i + 1;
        }
        true
    }

    # Naive (no Boyer-Moore/KMP skip table) substring search -- `O(n*m)`,
    # deliberately: a skip table needs working memory proportional to the
    # needle, which is exactly the kind of hidden allocation this layer
    # never does. Fine for the short, mostly-literal needles this is
    # actually used with; a caller with real throughput needs is expected
    # to bring their own algorithm, not lean on this one.
    contains(*self, needle: Self) => bool {
        if needle.size == 0 {
            return true;
        }
        if needle.size > self.size {
            return false;
        }
        a := <*[?]u8>self;
        b := <*[?]u8>needle;
        mut start : i32 = 0;
        while start <= self.size - needle.size {
            mut matched := true;
            mut i : i32 = 0;
            while i < needle.size {
                if a[start + i] != b[i] {
                    matched = false;
                }
                i = i + 1;
            }
            if matched {
                return true;
            }
            start = start + 1;
        }
        false
    }

    # FNV-1a -- simple, well-known, and (unlike `core::numerics`' own
    # `mix64`) a genuinely natural fit for a variable-length byte run: one
    # multiply-xor per byte, no separate finalization step needed.
    hash(*self) => u64 {
        mut h : u64 = 0xcbf29ce484222325u64;
        bytes := <*[?]u8>self;
        mut i : i32 = 0;
        while i < self.size {
            h = h ^ <u64>bytes[i];
            h = h * 0x100000001b3u64;
            i = i + 1;
        }
        h
    }

    fmt(*self, out: *mut Writer) => void {
        out.write_bytes(<*[?]u8>self);
    }
}
