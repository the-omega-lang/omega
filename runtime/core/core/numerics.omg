# `core::numerics` -- every scalar arithmetic type's `for`-attached
# methods. One `spec ... for $T` per type is generated by macro (the
# bodies are identical modulo `$T`), split into three families
# (`signed_integer`/`unsigned_integer`/`float_ops`) since each has a
# genuinely different member set -- not just three copies of one template.
#
# Each `for`-block spec itself is `exposed` -- a spec function has no
# visibility modifier of its own (it always inherits whichever the
# declaring spec has), so this is what makes every method here ordinary,
# callable public API (`5i32.abs()`, `x.clamp(lo, hi)`, ...) rather than
# an internal detail only reachable from within `core` itself.
#
# Every bare numeric literal compared or combined with `*self` is cast to
# `Self` explicitly (`<Self>0`, not `0`) -- an untyped literal here would
# otherwise default to `i32`, which only happens to already match `Self`
# for one of the twelve types this file instantiates.
#
# `isize`/`usize` deliberately get no `min_value`/`max_value`-style bounds
# anywhere in here: their width is target-dependent, so a literal bound
# baked in here would silently be wrong on a target this exact toolchain
# wasn't built assuming. Nothing below needs to know any type's width to
# be correct.

import cmp::Eq;
import cmp::Ord;
import cmp::Ordering;
import default::Default;
import hash::Hash;
import fmt::Display;
import fmt::write_float;
import fmt::write_int;
import fmt::write_uint;
import io::Writer;


# SplitMix64's own finalizer (public domain, widely used) -- a fixed-cost,
# well-mixed `u64 -> u64` step, shared by every integer/float `hash` below
# rather than reimplemented per type. Not itself part of `core::hash`'s own
# public surface -- purely an implementation detail of this file's own
# `for`-blocks, so it stays a plain, unmarked (module-hidden) function.
mix64(x: u64) => u64 {
    mut z := x + 0x9E3779B97F4A7C15u64;
    z = (z ^ (z >> 30u64)) * 0xBF58476D1CE4E5B9u64;
    z = (z ^ (z >> 27u64)) * 0x94D049BB133111EBu64;
    z ^ (z >> 31u64)
}

macro signed_integer($T: type) => {
    exposed spec SignedIntegerOps : Eq, Ord, Default, Hash, Display for $T {
        equals(*self, other: Self) => bool { *self == other }

        compare(*self, other: Self) => Ordering {
            if *self < other {
                Ordering::Less
            } else if *self > other {
                Ordering::Greater
            } else {
                Ordering::Equal
            }
        }

        default() => Self { 0 }

        # Overrides `Ord`'s default `min`/`max` (which would otherwise
        # route through `compare` and an `Ordering` match) with a direct
        # comparison -- same result, no detour through a 3-way enum for
        # what's a single machine instruction. `Ord` is still satisfied:
        # these match its required signature exactly.
        min(*self, other: Self) => Self {
            if *self < other { *self } else { other }
        }

        max(*self, other: Self) => Self {
            if *self > other { *self } else { other }
        }

        clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        abs(*self) => Self {
            if *self < <Self>0 { -*self } else { *self }
        }

        signum(*self) => Self {
            if *self < <Self>0 { <Self>(-1) } else if *self > <Self>0 { <Self>1 } else { <Self>0 }
        }

        is_negative(*self) => bool { *self < <Self>0 }
        is_positive(*self) => bool { *self > <Self>0 }

        # Sign-extends to `u64` (per this language's own "extend signedness
        # comes from the source" cast rule) before mixing -- an arbitrary,
        # but deterministic and type-local, bit pattern is all `Hash`
        # actually requires.
        hash(*self) => u64 { mix64(<u64>*self) }

        fmt(*self, out: *mut Writer) => void {
            write_int(out, <i64>*self, 10u32);
        }
    }
}

macro unsigned_integer($T: type) => {
    exposed spec UnsignedIntegerOps : Eq, Ord, Default, Hash, Display for $T {
        equals(*self, other: Self) => bool { *self == other }

        compare(*self, other: Self) => Ordering {
            if *self < other {
                Ordering::Less
            } else if *self > other {
                Ordering::Greater
            } else {
                Ordering::Equal
            }
        }

        default() => Self { 0 }

        min(*self, other: Self) => Self {
            if *self < other { *self } else { other }
        }

        max(*self, other: Self) => Self {
            if *self > other { *self } else { other }
        }

        clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        # A classic bit trick: a power of two has exactly one bit set, so
        # clearing its lowest set bit (`self & (self - 1)`) always leaves
        # zero. `0` itself is excluded (it has no set bit to begin with).
        is_power_of_two(*self) => bool {
            if *self == <Self>0 { false } else { (*self & (*self - <Self>1)) == <Self>0 }
        }

        # Zero-extends to `u64` before mixing -- see `SignedIntegerOps::hash`.
        hash(*self) => u64 { mix64(<u64>*self) }

        fmt(*self, out: *mut Writer) => void {
            write_uint(out, <u64>*self, 10u32);
        }
    }
}

macro float_ops($T: type) => {
    exposed spec FloatOps : Eq, Default, Hash, Display for $T {
        # IEEE 754 equality (`NaN != NaN`, `-0.0 == 0.0`) reflects the type
        # honestly rather than papering over it -- `Ord` is deliberately
        # *not* implemented here at all (see `core::cmp`'s own doc comment
        # on why: `NaN` has no correct position in a total order).
        equals(*self, other: Self) => bool { *self == other }

        default() => Self { 0.0 }

        min(*self, other: Self) => Self {
            if *self < other { *self } else { other }
        }

        max(*self, other: Self) => Self {
            if *self > other { *self } else { other }
        }

        clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        abs(*self) => Self {
            if *self < <Self>0.0 { -*self } else { *self }
        }

        # The one reliable, portable `NaN` test that needs no bit-level
        # trickery or platform intrinsic: `NaN` is the only value IEEE 754
        # defines as unequal to itself.
        is_nan(*self) => bool { *self != *self }

        # Hashing needs the value's real *bit pattern*, not its (lossy,
        # rounding) integer value -- there's no direct float<->int bit
        # reinterpret cast in this language, so this reads it back out
        # through a pointer-to-pointer cast instead (`self` is already a
        # `*Self`; retargeting that pointer's own pointee type is always a
        # pure `Reinterpret`, unlike a float-to-int *value* cast -- see
        # `docs/11-strings-casting-and-slices.md`'s general pointer-cast
        # rule). `sizeof<Self> == 4` is a compile-time-constant condition
        # once `Self` is substituted (generics fully monomorphize), so only
        # the branch matching this instantiation's own real width is ever
        # actually reached at runtime -- the other arm's 4-vs-8-byte read
        # is unreachable code for that concrete type, not a real
        # out-of-bounds access. `-0.0`/`0.0` are normalized to the same bit
        # pattern first (`equals` already treats them as equal, per IEEE
        # 754), which `Hash`'s own "equal values hash equal" contract
        # requires; `NaN` needs no special handling at all -- it never
        # equals anything, including itself, so any hash value for it is
        # trivially consistent with that same contract.
        hash(*self) => u64 {
            bits := if *self == <Self>0.0 {
                0u64
            } else if sizeof<Self> == 4 {
                <u64>*<*u32>self
            } else {
                *<*u64>self
            };
            mix64(bits)
        }

        fmt(*self, out: *mut Writer) => void {
            write_float(out, <f64>*self);
        }
    }
}

signed_integer$(i8);
signed_integer$(i16);
signed_integer$(i32);
signed_integer$(i64);
signed_integer$(isize);

unsigned_integer$(u8);
unsigned_integer$(u16);
unsigned_integer$(u32);
unsigned_integer$(u64);
unsigned_integer$(usize);

float_ops$(f32);
float_ops$(f64);
