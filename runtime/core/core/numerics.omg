# `core::numerics` -- every scalar arithmetic type's primitive methods and
# spec compositions. One group per type is generated by macro (the bodies
# are identical modulo `$T`), split into three families
# (`signed_integer`/`unsigned_integer`/`float_ops`) since each has a
# genuinely different member set -- not just three copies of one template.
#
# Primitive functions carry ordinary visibility modifiers. The separate
# compose blocks below give each numeric type nominal conformance to the
# exposed comparison/default/hash/display specs.
#
# Every bare numeric literal compared or combined with `*self` is cast to
# `Self` explicitly (`<Self>0`, not `0`) -- an untyped literal here would
# otherwise default to `i32`, which only happens to already match `Self`
# for one of the twelve types this file instantiates.
#
# `isize`/`usize` deliberately get no `min_value`/`max_value`-style bounds
# anywhere in here: their width is target-dependent, so a literal bound
# baked in here would silently be wrong on a target this exact toolchain
# wasn't built assuming. Nothing below needs to know any type's width to
# be correct.

import cmp::Eq;
import cmp::Ord;
import cmp::Ordering;
import default::Default;
import hash::Hash;
import fmt::Display;
import fmt::write_float;
import fmt::write_int;
import fmt::write_uint;
import io::Writer;


# SplitMix64's own finalizer (public domain, widely used) -- a fixed-cost,
# well-mixed `u64 -> u64` step, shared by every integer/float `hash` below
# rather than reimplemented per type. Not itself part of `core::hash`'s own
# public surface -- purely an implementation detail of this file's own
# primitive blocks, so it stays a plain, unmarked (module-hidden) function.
mix64(x: u64) => u64 {
    mut z := x + 0x9E3779B97F4A7C15u64;
    z = (z ^ (z >> 30u64)) * 0xBF58476D1CE4E5B9u64;
    z = (z ^ (z >> 27u64)) * 0x94D049BB133111EBu64;
    z ^ (z >> 31u64)
}

macro signed_integer($T: type) => {
    primitive $T {
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        exposed is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        exposed is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        exposed abs(*self) => Self {
            if *self < <Self>0 { -*self } else { *self }
        }

        exposed signum(*self) => Self {
            if *self < <Self>0 { <Self>(-1) } else if *self > <Self>0 { <Self>1 } else { <Self>0 }
        }

        exposed is_negative(*self) => bool { *self < <Self>0 }
        exposed is_positive(*self) => bool { *self > <Self>0 }

    }
    compose $T : Ord {
        equals(*self, other: Self) => bool { *self == other }
        compare(*self, other: Self) => Ordering {
            if *self < other { Ordering::Less }
            else if *self > other { Ordering::Greater }
            else { Ordering::Equal }
        }
        # Overrides `Ord`'s default `min`/`max` with direct comparisons.
        min(*self, other: Self) => Self { if *self < other { *self } else { other } }
        max(*self, other: Self) => Self { if *self > other { *self } else { other } }
    }
    compose $T : Default { default() => Self { 0 } }
    compose $T : Hash {
        # Sign-extends to `u64` before mixing.
        hash(*self) => u64 { mix64(<u64>*self) }
    }
    compose $T : Display {
        fmt(*self, out: *mut Writer) => void { write_int(out, <i64>*self, 10u32); }
    }
}

macro unsigned_integer($T: type) => {
    primitive $T {
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed pow(*self, exponent: u32) => Self {
            mut result : Self = <Self>1;
            mut i : u32 = 0u32;
            while i < exponent {
                result = result * *self;
                i = i + 1u32;
            }
            result
        }

        exposed is_even(*self) => bool { *self % <Self>2 == <Self>0 }
        exposed is_odd(*self) => bool { *self % <Self>2 != <Self>0 }

        # A classic bit trick: a power of two has exactly one bit set, so
        # clearing its lowest set bit (`self & (self - 1)`) always leaves
        # zero. `0` itself is excluded (it has no set bit to begin with).
        exposed is_power_of_two(*self) => bool {
            if *self == <Self>0 { false } else { (*self & (*self - <Self>1)) == <Self>0 }
        }

    }
    compose $T : Ord {
        equals(*self, other: Self) => bool { *self == other }
        compare(*self, other: Self) => Ordering {
            if *self < other { Ordering::Less }
            else if *self > other { Ordering::Greater }
            else { Ordering::Equal }
        }
        min(*self, other: Self) => Self { if *self < other { *self } else { other } }
        max(*self, other: Self) => Self { if *self > other { *self } else { other } }
    }
    compose $T : Default { default() => Self { 0 } }
    compose $T : Hash {
        # Zero-extends to `u64` before mixing.
        hash(*self) => u64 { mix64(<u64>*self) }
    }
    compose $T : Display {
        fmt(*self, out: *mut Writer) => void { write_uint(out, <u64>*self, 10u32); }
    }
}

macro float_ops($T: type) => {
    primitive $T {
        # IEEE 754 equality (`NaN != NaN`, `-0.0 == 0.0`) reflects the type
        # honestly rather than papering over it -- `Ord` is deliberately
        # *not* implemented here at all (see `core::cmp`'s own doc comment
        # on why: `NaN` has no correct position in a total order).
        exposed clamp(*self, lo: Self, hi: Self) => Self {
            if *self < lo { lo } else if *self > hi { hi } else { *self }
        }

        exposed abs(*self) => Self {
            if *self < <Self>0.0 { -*self } else { *self }
        }

        # The one reliable, portable `NaN` test that needs no bit-level
        # trickery or platform intrinsic: `NaN` is the only value IEEE 754
        # defines as unequal to itself.
        exposed is_nan(*self) => bool { *self != *self }

    }
    compose $T : Eq {
        equals(*self, other: Self) => bool { *self == other }
    }
    compose $T : Default { default() => Self { 0.0 } }
    compose $T : Hash {
        # Hash the normalized IEEE bit pattern through a pointer reinterpret.
        hash(*self) => u64 {
            bits := if *self == <Self>0.0 { 0u64 }
            else if sizeof<Self> == 4 { <u64>*<*u32>self }
            else { *<*u64>self };
            mix64(bits)
        }
    }
    compose $T : Display {
        fmt(*self, out: *mut Writer) => void { write_float(out, <f64>*self); }
    }
}

signed_integer$(i8);
signed_integer$(i16);
signed_integer$(i32);
signed_integer$(i64);
signed_integer$(isize);

unsigned_integer$(u8);
unsigned_integer$(u16);
unsigned_integer$(u32);
unsigned_integer$(u64);
unsigned_integer$(usize);

float_ops$(f32);
float_ops$(f64);
