# `core::io` -- explicit, allocation-free console I/O. Writers are unbuffered
# unless the caller supplies a buffer; buffered writers must be flushed by the
# caller. The console gaps are the only platform-dependent layer.

import platform::StandardInput;

import platform::StandardError;
import platform::StandardOutput;

stdout_sink(ctx: usize, data: *[?]u8) => usize {
    mut written: usize = 0;
    if StandardOutput::write(data, &mut written) { written } else { 0 }
}

stderr_sink(ctx: usize, data: *[?]u8) => usize {
    mut written: usize = 0;
    if StandardError::write(data, &mut written) { written } else { 0 }
}


buffer_sink(ctx: usize, data: *[?]u8) => usize { 0 }

stdin_source(ctx: usize, into: *mut [?]u8) => usize {
    mut count: usize = 0;
    if StandardInput::read(into, &mut count) { count } else { 0 }
}
exposed struct Writer {
    sink: (ctx: usize, data: *[?]u8) => usize;
    ctx: usize;
    buf: *mut u8;
    cap: usize;
    len: usize;
    failed: bool;
    memory_only: bool;

    new(sink: (ctx: usize, data: *[?]u8) => usize, ctx: usize, buffer: *mut [?]u8) => Self {
        # An empty buffer means "unbuffered", so hold no pointer into storage
        # the caller may not own past this call -- `std::io::string_writer`
        # legitimately hands in a zero-length slice of one of its own locals.
        storage := if buffer.length == 0 { <*mut u8>0 } else { <*mut u8>buffer };
        Self { sink = sink; ctx = ctx; buf = storage; cap = <usize>buffer.length; len = 0; failed = false; memory_only = false; }
    }

    new_unbuffered(sink: (ctx: usize, data: *[?]u8) => usize, ctx: usize) => Self {
        Self { sink = sink; ctx = ctx; buf = <*mut u8>0; cap = 0; len = 0; failed = false; memory_only = false; }
    }

    exposed to_sink(sink: (ctx: usize, data: *[?]u8) => usize, ctx: usize, buffer: *mut [?]u8) => Self {
        Self::new(sink, ctx, buffer)
    }

    exposed to_buffer(buffer: *mut [?]u8) => Self {
        Self { sink = buffer_sink; ctx = 0; buf = <*mut u8>buffer; cap = <usize>buffer.length; len = 0; failed = false; memory_only = true; }
    }

    exposed stdout() => Self {
        Self::new_unbuffered(stdout_sink, 0)
    }

    exposed stderr() => Self {
        Self::new_unbuffered(stderr_sink, 0)
    }

    exposed stdout_buffered(buffer: *mut [?]u8) => Self {
        Self::new(stdout_sink, 0, buffer)
    }

    exposed stderr_buffered(buffer: *mut [?]u8) => Self {
        Self::new(stderr_sink, 0, buffer)
    }

    exposed had_error(*self) => bool { self.failed }

    buffer_slice(*self, start: usize, end: usize) => *[?]u8 {
        start_i32 := <i32>start;
        end_i32 := <i32>end;
        &(<*mut []u8>self.buf)[start_i32..<end_i32]
    }

    exposed flush(*mut self) => void {
        if self.failed == false {
            if self.len > 0 {
                if self.memory_only {
                    self.failed = true;
                    self.len = 0;
                } else {
                    mut offset: usize = 0;
                    while offset < self.len {
                        written := self.sink(self.ctx, self.buffer_slice(offset, self.len));
                        if written == 0 {
                            self.failed = true;
                            self.len = 0;
                        } else {
                            offset = offset + written;
                        }
                    }
                    self.len = 0;
                }
            }
        }
    }

    exposed write_byte(*mut self, byte: u8) => void {
        if self.failed == false {
            if self.cap == 0 {
                mut one: [1]u8;
                one[0] = byte;
                if self.sink(self.ctx, &one[0..]) == 0 { self.failed = true; }
            } else {
                if self.len == self.cap { self.flush(); }
                if self.failed == false {
                    *<*mut u8>(<usize>self.buf + self.len) = byte;
                    self.len = self.len + 1;
                }
            }
        }
    }

    exposed write_bytes(*mut self, data: *[?]u8) => void {
        if self.cap == 0 {
            # Unbuffered: the whole run reaches the sink in one call, and a
            # short write resumes from the remainder -- never one call (and,
            # for a console sink, never one syscall) per byte.
            mut offset: i32 = 0;
            mut running := self.failed == false;
            while running {
                if offset >= data.length {
                    running = false;
                } else {
                    end := data.length;
                    written := self.sink(self.ctx, &data[offset..<end]);
                    if written == 0 {
                        self.failed = true;
                        running = false;
                    } else {
                        offset = offset + <i32>written;
                    }
                }
            }
        } else {
            mut i: i32 = 0;
            while i < data.length {
                self.write_byte(data[i]);
                i = i + 1;
            }
        }
    }

    exposed write_str(*mut self, text: *str) => void {
        self.write_bytes(<*[?]u8>text);
    }

    exposed newline(*mut self) => void { self.write_byte(10u8); }
}

exposed struct Reader {
    source: (ctx: usize, into: *mut [?]u8) => usize;
    ctx: usize;
    buf: *mut u8;
    cap: usize;
    len: usize;
    pos: usize;
    eof: bool;
    failed: bool;

    new(source: (ctx: usize, into: *mut [?]u8) => usize, ctx: usize, buffer: *mut [?]u8) => Self {
        Self { source = source; ctx = ctx; buf = <*mut u8>buffer; cap = <usize>buffer.length; len = 0; pos = 0; eof = false; failed = false; }
    }

    new_unbuffered(source: (ctx: usize, into: *mut [?]u8) => usize, ctx: usize) => Self {
        Self { source = source; ctx = ctx; buf = <*mut u8>0; cap = 0; len = 0; pos = 0; eof = false; failed = false; }
    }

    exposed from_source(source: (ctx: usize, into: *mut [?]u8) => usize, ctx: usize, buffer: *mut [?]u8) => Self {
        Self::new(source, ctx, buffer)
    }

    exposed stdin() => Self { Self::new_unbuffered(stdin_source, 0) }
    exposed stdin_buffered(buffer: *mut [?]u8) => Self { Self::new(stdin_source, 0, buffer) }
    exposed had_error(*self) => bool { self.failed }

    buffer_slice(*self, start: usize, end: usize) => *mut [?]u8 {
        start_i32 := <i32>start;
        end_i32 := <i32>end;
        &mut (<*mut []u8>self.buf)[start_i32..<end_i32]
    }

    exposed read_byte(*mut self, out: *mut u8) => bool {
        if self.failed { return false; }
        if self.eof { return false; }
        if self.pos == self.len {
            if self.cap == 0 {
                mut one: [1]u8;
                count := self.source(self.ctx, &mut one[0..]);
                if count == 0 {
                    self.eof = true;
                    return false;
                }
                *out = one[0];
                true
            } else {
                self.len = self.source(self.ctx, self.buffer_slice(0, self.cap));
                self.pos = 0;
                if self.len == 0 {
                    self.eof = true;
                    return false;
                }
                *out = *<*u8>self.buf;
                self.pos = 1;
                true
            }
        } else {
            *out = *<*u8>(<usize>self.buf + self.pos);
            self.pos = self.pos + 1;
            true
        }
    }

    exposed read(*mut self, into: *mut [?]u8, out: *mut usize) => bool {
        mut count: usize = 0;
        while count < <usize>into.length {
            mut byte: u8 = 0;
            if self.read_byte(&mut byte) == false {
                *out = count;
                return true;
            }
            into[<i32>count] = byte;
            count = count + 1;
        }
        *out = count;
        true
    }

    exposed read_line(*mut self, into: *mut [?]u8, out: *mut usize) => bool {
        mut count: usize = 0;
        while count < <usize>into.length {
            mut byte: u8 = 0;
            if self.read_byte(&mut byte) == false {
                *out = count;
                return true;
            }
            if byte == 10u8 {
                *out = count;
                return true;
            }
            into[<i32>count] = byte;
            count = count + 1;
        }
        mut extra: u8 = 0;
        if self.read_byte(&mut extra) {
            if extra == 10u8 {
                *out = count;
                true
            } else {
                false
            }
        } else {
            false
        }
    }
}

# The four print macros. Omega has no macro hygiene, and a statement-position
# expansion is spliced into the caller's own block, so these locals carry a
# deliberately unlikely `omega_print_` prefix: a plainer name like `out` would
# be *captured* by an argument expression that happens to reference a caller
# variable of the same name. The surrounding `{ }` keeps them from leaking out
# again. Buffering here is an explicit, visible optimisation -- one syscall per
# print statement instead of one per argument -- and it is flushed before the
# statement ends, so nothing is ever left pending.
exposed macro print($args: expr...) => {
    {
        mut omega_print_buf: [256]u8;
        mut omega_print_out := Writer::stdout_buffered(&mut omega_print_buf[0..]);
        $...(){ Display::fmt($args, &mut omega_print_out); }
        omega_print_out.flush();
    }
}

exposed macro println($args: expr...) => {
    {
        mut omega_print_buf: [256]u8;
        mut omega_print_out := Writer::stdout_buffered(&mut omega_print_buf[0..]);
        $...(){ Display::fmt($args, &mut omega_print_out); }
        omega_print_out.newline();
        omega_print_out.flush();
    }
}

exposed macro eprint($args: expr...) => {
    {
        mut omega_print_buf: [256]u8;
        mut omega_print_out := Writer::stderr_buffered(&mut omega_print_buf[0..]);
        $...(){ Display::fmt($args, &mut omega_print_out); }
        omega_print_out.flush();
    }
}

exposed macro eprintln($args: expr...) => {
    {
        mut omega_print_buf: [256]u8;
        mut omega_print_out := Writer::stderr_buffered(&mut omega_print_buf[0..]);
        $...(){ Display::fmt($args, &mut omega_print_out); }
        omega_print_out.newline();
        omega_print_out.flush();
    }
}
