# `core::range` -- tangible, inert range values and their independent
# iteration cursor.
#
# The compiler lowers expression-position range syntax to `Range<T>` by this
# exact path (`Analyzer::core_range_path`), and builds the struct literal by
# *field index*. So `Range`'s own field order below -- `start`, `end`,
# `inclusive` -- is load-bearing exactly the way `core::option::Option`'s
# variant order is: renaming either type, or reordering these three fields,
# silently miscompiles every range in the language unless that lowering is
# updated to match. Adding a field after `inclusive` is safe.
#
# A range is never its own cursor. Omega values copy, so a `Range` that
# carried iteration state would lose its progress on assignment with nothing
# to catch it -- Rust can afford `Range: Iterator` only because its move
# checker makes the copy impossible, and even there it cost `RangeInclusive`
# its `Copy` and left an `exhausted` flag contaminating equality. Splitting
# the value from the cursor avoids the whole class of problem.

import cmp::Ord;
# `Ord` brings `compare` into scope at every `Steppable` instantiation, and
# its return type has to be nameable here even though this file never spells
# it: `Ordering` is part of the bound's own surface.
import cmp::Ordering;
import iterator::Iterator;
import iterator::ToIterator;
import option::Option;

exposed struct Range<T> {
    exposed start: T;
    exposed end: T;
    exposed inclusive: bool;
}

exposed struct RangeIterator<T> {
    internal current: T;
    internal end: T;
    internal inclusive: bool;
    internal done: bool;
}

# Stepping, and nothing else. `successor` returns `None` at the type's upper
# bound, which is what lets an inclusive full-domain range terminate without
# ever computing MAX + 1 -- the same job the old `$more` desugaring flag did,
# now expressed in the type.
#
# This deliberately declares no comparison of its own. A range cursor does
# need ordering -- to recognize an inverted (empty) range, and to recognize
# the final element -- but that is `Ord`'s job, and a `Successor` that
# redeclared `greater_than`/`equals` would be a second, independent ordering
# that could silently disagree with the type's real one. The cursor asks for
# both capabilities through `Steppable` below instead.
exposed spec Successor {
    successor(*self) => Option<Self>;
}

# What iterating a range actually requires: stepping *and* ordering. Written
# as an alias because a bound names exactly one spec (`T: Ord + Successor` is
# not syntax today), and because the alternative -- `spec Successor : Ord` --
# would force every element type to restate its whole ordering inside its
# `Successor` block, since conforming to a dependent spec must supply the
# flattened chain. An alias bound has neither problem: `conform T to Ord` and
# `conform T to Successor` stay separate, ordinary declarations.
exposed spec Steppable = Successor | Ord;

# The element type's own domain limits, needed only when a bound is left to
# be inferred (`1..`, `..<10`). Separate from `Successor` on purpose: a type
# can be perfectly steppable without having a representable first or last
# value, and such a type should still be usable in a fully-written range.
# Static (receiverless), like `Default::default` -- there is no value to ask.
exposed spec Bounded {
    min() => Self;
    max() => Self;
}

conform<T: Steppable> Range<T> to ToIterator<T> {
    to_iterator(*self) => RangeIterator<T> {
        RangeIterator {
            current = self.start;
            end = self.end;
            inclusive = self.inclusive;
            done = self.start.greater_than(self.end);
        }
    }
}

conform<T: Steppable> RangeIterator<T> to Iterator<T> {
    next(*mut self) => Option<T> {
        if self.done {
            return Option<T>::None;
        }
        value := self.current;
        # `compare(...).is_eq()` rather than `==` or `equals`. Not `==`: the
        # built-in operator is numeric-only, so it would quietly restrict
        # ranges to primitives and defeat the point of bounding on a spec.
        # Not `equals` either, though that reads better: `equals` is declared
        # on `Eq` and reaching it through an `Ord` bound compiles but fails to
        # *link* -- a conform block supplying it inline registers it under
        # `Ord` while the call site mangles it as `Eq`. See
        # docs/14-known-issues.md; `compare` is `Ord`'s own method and is
        # unaffected.
        if self.current.compare(self.end).is_eq() {
            self.done = true;
            if self.inclusive {
                return Option<T>::Some { value = value; };
            }
            return Option<T>::None;
        } else {
            next := self.current.successor();
            match next {
                Option::None => { self.done = true; },
                Option::Some => { self.current = next.value; },
            }
        }
        Option<T>::Some { value = value; }
    }
}
