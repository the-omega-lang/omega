# `core::range` -- tangible, inert range values and their independent
# iteration cursor.
#
# `Range`'s field order (`start`, `end`, `inclusive`) is load-bearing:
# `Analyzer::core_range_path` builds the struct literal by field index.
# Reordering these three (adding one after `inclusive` is safe) silently
# miscompiles every range in the language.
#
# A range is never its own cursor: Omega values copy, so a `Range` carrying
# iteration state would lose progress on assignment with nothing to catch
# it. Splitting the value from the cursor avoids that class of problem.

import super::cmp::Ord;
import super::iterator::Iterator;
import super::iterator::ToIterator;
import super::option::Option;

exposed struct Range<T> {
    exposed start: T;
    exposed end: T;
    exposed inclusive: bool;
}

exposed struct RangeIterator<T> {
    shared current: T;
    shared end: T;
    shared inclusive: bool;
    shared done: bool;
}

# Stepping, and nothing else. `successor` returns `None` at the type's upper
# bound, letting an inclusive full-domain range terminate without ever
# computing MAX + 1.
#
# Declares no comparison of its own -- ordering (to recognize an inverted or
# final-element range) is `Ord`'s job; a redeclared `greater_than`/`equals`
# here could silently disagree with the type's real one. Conformances below
# ask for both via the inline bound `T: Successor + Ord`.
exposed spec Successor {
    successor(*self) => Option<Self>;
}

# The element type's own domain limits, needed only when a bound is
# inferred (`1..`, `..<10`). Separate from `Successor`: a type can be
# steppable without a representable first/last value. Static (receiverless)
# since there is no value to ask.
exposed spec Bounded {
    min() => Self;
    max() => Self;
}

conform<T: Successor + Ord> Range<T> to ToIterator<T> {
    to_iterator(*self) => RangeIterator<T> {
        RangeIterator {
            current = self.start;
            end = self.end;
            inclusive = self.inclusive;
            done = self.start.greater_than(self.end);
        }
    }
}

conform<T: Successor + Ord> RangeIterator<T> to Iterator<T> {
    next(*mut self) => Option<T> {
        if self.done {
            return Option<T>::None;
        }
        value := self.current;
        if self.current.equals(self.end) {
            self.done = true;
            if self.inclusive {
                return Option<T>::Some { value = value; };
            }
            return Option<T>::None;
        } else {
            next := self.current.successor();
            match next {
                Option::None => { self.done = true; },
                Option::Some => { self.current = next.value; },
            }
        }
        Option<T>::Some { value = value; }
    }
}
