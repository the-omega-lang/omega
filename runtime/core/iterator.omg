# `core::iterator` -- the protocol `for <binding> in <iterator>` is built on
# (see `Analyzer::analyze_for_in`). Split in two like Rust's `Iterator`/
# `IntoIterator`: `Iterator<T>` is the cursor itself, `ToIterator<T>` is
# what a collection implements to produce one.

import super::option::Option;

# `to_iterator` returns `spec Iterator<T>` (static dispatch): each
# implementor returns its own concrete iterator type, checked against the
# bound rather than an exact signature -- see docs/language/specs-and-conformance.md. This makes
# `ToIterator<T>` not object-safe, a deliberate tradeoff (docs/language/specs-and-conformance.md's
# object-safety caveat).
exposed spec Iterator<T> {
    next(*mut self) => Option<T>;
}

exposed spec ToIterator<T> {
    to_iterator(*self) => spec Iterator<T>;
}
