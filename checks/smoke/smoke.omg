# The native x86-64 Linux platform, exercised through the four hosted
# capabilities at once: standard output, standard input, the heap allocator
# (including the growth path that goes through `realloc`), and standard error.
#
# Driven by `bin/check-platform`, which links it without a C runtime and then
# proves the executable has no libc dependency of any kind.
import std::io::println;
import std::io::eprintln;
import std::io::read_line;
import std::io::Stdin;
import std::list::List;
import std::string::String;
import std::atomic::AtomicU32;
import std::alloc::alloc;
import std::alloc::free;
import core::atomic::AtomicLoadOrdering;
import core::atomic::AtomicStoreOrdering;
import core::atomic::AtomicRmwOrdering;

# Neither declaration asks for alignment, so the wrapper's own
# `@layout(align)` is the only thing keeping `counter` naturally aligned once
# it is nested this deep and reached through the heap.
struct Slot {
	exposed pad: u8;
	exposed counter: AtomicU32;
}

struct Outer {
	exposed lead: u8;
	exposed slot: Slot;
}

main() => void {
	println$("smoke-stdout: platform console reached");

	# Enough pushes to outgrow the initial capacity several times, so the
	# allocator's `realloc` path -- allocate, copy, release -- really runs.
	mut numbers := List<i32>::new();
	defer numbers.free();
	for mut i := 0; i < 64; ++i {
		numbers.push(i * i);
	}
	mut last: i32 = 0;
	numbers.get(63, &mut last);
	println$("smoke-alloc: ", numbers.len(), " ", last);

	mut line := String::new();
	defer line.free();
	mut source := Stdin {};
	saw := read_line(&mut source, &mut line);
	println$("smoke-stdin: ", saw, " ", line.as_str());

	# Reached through the `std` wrapper rather than the raw gap: the wrapper's
	# own `@layout(align)` is what makes the location naturally aligned, which
	# docs/language/atomics.md requires of every caller.
	mut counter := AtomicU32::new(0u32);
	counter.store(7u32, AtomicStoreOrdering::SeqConsistent);
	loaded := counter.load(AtomicLoadOrdering::SeqConsistent);
	previous := counter.fetch_add(5u32, AtomicRmwOrdering::SeqConsistent);
	println$("smoke-atomic: ", loaded, " ", previous, " ", counter.load(AtomicLoadOrdering::SeqConsistent));

	block := <*mut Outer>alloc(sizeof<Outer>, alignof<Outer>);
	*block = Outer { lead = 1u8; slot = Slot { pad = 2u8; counter = AtomicU32::new(3u32); }; };
	aligned := <usize>&(*block).slot.counter % sizeof<u32> == 0;
	(*block).slot.counter.fetch_add(4u32, AtomicRmwOrdering::SeqConsistent);
	println$("smoke-aligned: ", aligned, " ", (*block).slot.counter.load(AtomicLoadOrdering::SeqConsistent));
	free(<*u8>block);

	eprintln$("smoke-stderr: reached");
}
