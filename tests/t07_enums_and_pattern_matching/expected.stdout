enum-basic-match: less less greater
enum-default-tag: 0
enum-header-fields: 0 ok 1 error 7
enum-shared-body-fields: info 100 error 200 42
match-refinement: 42
enum-widening: all good failed
value-match: less than a hundred a hundred more than a hundred
char-range-match: 1 2 3 0
catch-all-match: not equal
