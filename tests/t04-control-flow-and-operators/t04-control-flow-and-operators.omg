import extern::std::io::println;

struct Point {
	exposed x: i32;
}

mut side_effect_calls: i32 = 0;

record_call() => bool {
	side_effect_calls += 1;
	true
}

classify(n: i32) => *str {
	match n {
		0..=9 => "single digit",
		10..<100 => "double digit",
	} else {
		"large or negative"
	}
}

# `defer` runs at function exit, FILO, after the return value is fixed.
defer_demo() => i32 {
	mut result := 10;
	defer { println$("defer-a"); result = 999; }
	defer { println$("defer-b"); }
	result
}

main() => i32 {
	# --- if as an expression, with else-if chaining ------------------------
	label := if 0 > 0 { "positive" } else if 0 < 0 { "negative" } else { "zero" };
	println$(label);

	# A `{` right after a condition starts the control-flow body, not a
	# struct literal; parenthesize the literal to use it as the condition.
	tag := if (Point { x = 1; }).x > 0 { "has-x" } else { "no-x" };
	println$(tag);

	# --- match as an expression, with a fallback `else` ---------------------
	println$(classify(4), classify(42), classify(-1));

	# --- the four loop forms -------------------------------------------------
	mut total := 0;
	mut i := 0;
	while i < 5 {
		total += i;
		i += 1;
	}

	mut stop_at := 0;
	loop {
		if stop_at == 3 { break; }
		stop_at += 1;
	}

	mut classic_sum := 0;
	for mut k := 0; k < 4; k += 1 {
		classic_sum += k;
	}

	mut range_count := 0;
	for v in 0..<3 {
		range_count += 1;
	}

	println$(total, stop_at, classic_sum, range_count);

	# --- break / continue -----------------------------------------------------
	mut odds_below_eight := 0;
	for m in 0..<10 {
		if m % 2 == 0 { continue; }
		if m > 7 { break; }
		odds_below_eight += m;
	}
	println$(odds_below_eight);

	# --- defer: FILO order, return value fixed before defers run --------------
	returned := defer_demo();
	println$(returned);

	# --- short-circuit vs eager evaluation -------------------------------------
	side_effect_calls = 0;
	r1 := false && record_call();
	println$(side_effect_calls, r1);

	r2 := true || record_call();
	println$(side_effect_calls, r2);

	r3 := true && record_call();
	println$(side_effect_calls, r3);

	r4 := false || record_call();
	println$(side_effect_calls, r4);

	# --- operator precedence ----------------------------------------------------
	additive_first := 2 + 3 * 4;          # multiplicative tighter than additive
	grouped := (2 + 3) * 4;               # explicit grouping overrides
	bitwise_vs_cmp := 6 & 3 == 2;         # (6 & 3) == 2
	range_check := 5 >= 1 && 5 <= 10;     # comparison tighter than `&&`
	shift_vs_additive := 1 + 2 << 3;      # (1 + 2) << 3
	shift_vs_mul := 2 << 1 * 3;           # 2 << (1 * 3)
	unary_vs_additive := -2 + 5;          # (-2) + 5

	println$(
		additive_first, grouped, bitwise_vs_cmp, range_check,
		shift_vs_additive, shift_vs_mul, unary_vs_additive
	);

	# `&` is address-of in prefix position and `*` is dereference in prefix
	# position, but bitwise-and / multiply in infix position; the same
	# tokens mean different things purely by where they appear.
	x := 5;
	y := 3;
	product := x * y;
	p: *i32 = &x;
	dereferenced := *p;
	println$(product, dereferenced);

	# --- binary-operand literal inference: expected type flows to the RHS ----
	mut counter: u32 = 0;
	counter = counter + 1;
	println$(counter);

	return 0;
}
