struct Failure {
	exposed code: i32;
}

struct Other {
	exposed value: i32;
}

spec Named {
	name(*self) => *str;
}

alias Errors = enum Failure | *str;

# A member must be a value type, under the same rules an aggregate field obeys.
alias SpecMember = enum Failure | Named;

alias NeverMember = enum Failure | never;

member_restrictions() => void {
	spec_member: SpecMember;
	never_member: NeverMember;
}

# Injecting a value that is not a member of the shape.
non_member() => Errors {
	Other { value = 1; }
}

alias Wider = enum Failure | Other | *str;

# Widening is allowed, but narrowing is not: `Wider` can hold an `Other`, and
# the destination has nowhere to put it.
narrow(value: Wider) => Errors {
	value
}

# A cast establishes the destination explicitly, but it does not relax the
# rule -- narrowing stays a cast that does not exist.
narrow_cast(value: Wider) => Errors {
	<Errors>value
}

# Partial overlap is not a subset either: the source can hold a `*str`.
partial_overlap_cast(value: Errors) => enum Failure | Other {
	<enum Failure | Other>value
}

# The source must itself be a destination member, with no conversion chain
# invented to get there.
non_member_cast() => Errors {
	<Errors>Other { value = 1; }
}

# Conversion is exact, not a search: `i16` casts to `i32`, but that does not
# make it reach an `i32`-holding anonymous enum through a hidden chain.
chained_cast(n: i16) => enum i32 | *str {
	<enum i32 | *str>n
}

# An anonymous enum is not extracted by casting: a member is reached by
# matching.
extract_cast(value: Errors) => *str {
	<*str>value
}

# A match arm must name a member of the scrutinee.
not_a_member(value: Errors) => i32 {
	match value {
		Failure => 0,
		Other => 1,
	}
}

# The same member may not be covered twice.
duplicate_arm(value: Errors) => i32 {
	match value {
		Failure => 0,
		*str => 1,
		Failure => 2,
	}
}

# Coverage must be complete.
non_exhaustive(value: Errors) => i32 {
	match value {
		Failure => 0,
	}
}

# An anonymous enum's arms are types, not values.
value_pattern(value: Errors) => i32 {
	match value {
		0 => 0,
		.. => 1,
	}
}

# A catch-all with nothing left to cover is an error, as is a second one.
redundant_catch_all(value: Errors) => i32 {
	match value {
		Failure => 0,
		*str => 1,
		.. => 2,
	}
}

multiple_catch_alls(value: Errors) => i32 {
	match value {
		Failure => 0,
		.. => 1,
		.. => 2,
	}
}

# The type has no fields, elements, or methods of its own.
no_members(value: Errors) => i32 {
	value.code
}

alias Wide = enum Other | Errors;

# `Errors` is flattened into `Wide`'s leaves, so it is not a member of its own
# and cannot group several leaves into one arm.
flattened_alias_arm(value: Wide) => i32 {
	match value {
		Other => 0,
		Errors => 1,
	}
}

# Branches of unrelated types are a plain mismatch: no `enum Failure | Other`
# is invented to make an untyped `if` type-check.
untyped_if(flag: bool) => void {
	joined := if flag { Failure { code = 1; } } else { Other { value = 2; } };
}

# The same holds for `match` arms.
untyped_match(n: i32) => void {
	joined := match n {
		0 => Failure { code = 1; },
	} else {
		Other { value = 2; }
	};
}

main() => void {
}
