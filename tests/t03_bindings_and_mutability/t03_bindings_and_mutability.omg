import std::io::println;
import self::helper::shadowed_import;

# Module-scope names a local binding hides below.
shadowed_global: i32 = 100;

shadowed_function() => i32 { 200 }

struct Counter {
	exposed value: i32;

	exposed new(start: i32) => Self {
		Self { value = start; }
	}

	# By-value receiver: mutating a local copy leaves the caller's value alone.
	exposed bumped_copy(self) => i32 {
		^copy := self;
		copy.value += 1;
		copy.value
	}

	# By-value receiver, read-only: proves auto-deref-and-copy on a pointer.
	exposed value_of(self) => i32 {
		self.value
	}

	# Pointer receiver, immutable pointee: read-only.
	exposed peek(*self) => i32 {
		self.value
	}

	# Pointer receiver, mutable pointee: mutates the caller's value.
	exposed bump(^self) => void {
		self.value += 1;
	}
}

main() => void {
	# --- binding forms ----------------------------------------------------
	^a: i32;
	a = 10;
	b: i32 = 20;
	c := 30;
	^d: i32 = 40;
	^e := 50;
	d += 1;
	e += 1;
	println$("binding-forms: ", a, " ", b, " ", c, " ", d, " ", e);

	# `mut` is an ordinary identifier.
	^mut := 5;
	mut += 1;
	println$("mut-identifier: ", mut);

	# --- receiver forms and their mutation scope ---------------------------
	^counter := Counter::new(0);

	# A by-value receiver's local copy leaves the caller's value alone.
	copy_result := counter.bumped_copy();
	println$("bumped-copy: ", copy_result, " ", counter.value);

	# A pointer-receiver method called on a plain value takes the
	# reference automatically.
	println$("peek-auto-ref: ", counter.peek());

	# `^self` mutates the caller's value through the receiver pointer.
	counter.bump();
	counter.bump();
	println$("bump-mut-self: ", counter.value);

	# A by-value-receiver method called through a pointer dereferences
	# and copies automatically.
	ptr := *counter;
	println$("value-of-deref: ", ptr.value_of());

	# --- mutable places: *place vs ^place -----------------------------------
	value: i32 = 100;
	immutable_ptr: *i32 = *value;

	^other: i32 = 200;
	mutable_ptr: ^i32 = ^other;
	mutable_ptr.* += 1;
	println$("mutable-places: ", immutable_ptr.*, " ", mutable_ptr.*);

	# --- compound assignment and increment/decrement ------------------------
	^n: i32 = 10;
	n += 5;   # 15
	n -= 2;   # 13
	n *= 3;   # 39
	n /= 2;   # 19
	n %= 4;   # 3
	n &= 6;   # 2
	n |= 1;   # 3
	n ^= 3;   # 0
	n += 20;  # 20
	n <<= 2;  # 80
	n >>= 1;  # 40
	++n;      # 41
	--n;      # 40
	println$("compound-assign: ", n);

	# --- shadowing ----------------------------------------------------------
	# A declaration is a fresh binding whose initializer is analyzed before
	# the new binding exists, so this reads the previous `s` and drops `^`.
	^s := 1;
	s += 1;
	s := s + 10;
	println$("shadow-privilege-drop: ", s);

	# The fresh binding carries its own type.
	s := "twelve";
	println$("shadow-type-change: ", s);

	comp SHADOW := 2;
	comp SHADOW := SHADOW * 3;
	println$("shadow-comp: ", SHADOW);

	# An inner scope's binding disappears with the scope; the same-block
	# shadow above does not come back.
	scoped := 1;
	{
		scoped := scoped + 1;
		println$("shadow-inner-scope: ", scoped);
	}
	println$("shadow-outer-restored: ", scoped);

	# A local binding hides a module-scope global, a function name, and an
	# imported name in the value namespace.
	println$("module-names: ", shadowed_global, " ", shadowed_function(), " ", shadowed_import);
	shadowed_global := 1;
	shadowed_function := 2;
	shadowed_import := 3;
	println$(
		"local-over-module-names: ",
		shadowed_global, " ", shadowed_function, " ", shadowed_import
	);
}
