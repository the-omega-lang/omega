# Generic bounds, uncalled references, explicit arguments, and ambiguous
# generic overloads are checked under functions.md and generics.md.
# Equally specific templates remain ambiguous at equal adaptation cost.
exposed spec Describable {
	describe(*self) => *str;
}

struct Widget {
	exposed name: *str;
}

struct Holder {
	exposed value: i32;

	exposed need<T: Describable>(*self, item: T) => *str { item.describe() }
	exposed plain(*self, n: i32) => i32 { n }
	exposed alone<T>(*self, thing: T) => T { thing }

	exposed twin<T>(*self, thing: T) => T { thing }
	exposed twin<T>(*self, thing: *T) => *T { thing }
}

main() => void {
	holder := Holder { value = 1; };
	widget := Widget { name = "widget"; };

	unbounded := holder.need(widget);
	uninstantiated := Holder::self::alone;
	not_generic := holder.plain<i32>(1);
	ambiguous := holder.twin(&holder.value);
}
