import std::io::println;

marker NullSink {
	exposed write(*self, tag: i32) => i32 { tag * 2 }
}

marker Tagged<T> {
	exposed identify(*self) => *str { "tagged-marker" }
}

exposed spec Pingable {
	ping(*self) => *str;
	echo(*self) => Beacon;
}

marker Beacon {}

meet Pingable for Beacon {
	ping(*self) => *str { "pong" }
	echo(*self) => Beacon { Beacon {} }
}

struct HasMarkerField {
	exposed m: NullSink;
	exposed x: i32;
}

# Passing a marker by value transfers no payload bytes but otherwise
# follows ordinary by-value call semantics.
take_marker(sink: NullSink) => i32 {
	sink.write(21)
}

# Returning a marker transfers no payload bytes either, so the result is a
# real value of a zero-sized type rather than a `void` result.
make_marker() => NullSink {
	NullSink {}
}

forward<T>(value: T) => T {
	value
}

main() => void {
	# A marker's value size is exactly zero.
	println$("marker-zero-size: ", sizeof<NullSink>);

	x := NullSink {};
	sink := x;
	println$("marker-method-call: ", sink.write(10));
	println$("marker-by-value: ", take_marker(x));

	tagged := Tagged<i32> {};
	println$("generic-marker: ", tagged.identify());

	# A marker may conform to a spec and dispatch statically or dynamically.
	beacon := Beacon {};
	println$("marker-static-dispatch: ", Pingable::ping(&beacon));
	obj := <*spec Pingable>&beacon;
	println$("marker-dynamic-dispatch: ", obj.ping());

	# A marker in return position: direct, generic and dynamically dispatched.
	returned := make_marker();
	println$("marker-return: ", returned.write(3));
	println$("marker-return-generic: ", forward<NullSink>(make_marker()).write(4));
	echoed := obj.echo();
	println$("marker-return-dynamic: ", Pingable::ping(&echoed));

	# A zero-sized field does not advance the containing object's offset,
	# so an adjacent zero-sized and non-zero-sized field may share an
	# address even though each has its own real place.
	hv := HasMarkerField { m = NullSink {}; x = 5; };
	same_address := <usize>&hv.m == <usize>&hv.x;
	println$("zero-sized-offset: ", same_address, " ", hv.x);
}
