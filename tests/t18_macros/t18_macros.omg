import std::io::println;
import self::defs::read_secret;
import self::defs::make_doubler;
import self::defs::re_export;

make_doubler$(i32, double_i32);

# `$path` captures the anchored path `self::defs` as one argument and
# `$ident` supplies both the alias's own name and the re-exported item's
# final segment, producing `alias magic = self::defs::magic;`.
re_export$(self::defs, magic);

# Statement-position macro: splices zero or more statements.
macro log_two($a: expr, $b: expr) => {
	println$("log-two-a: ", $a);
	println$("log-two-b: ", $b);
}

# Expression-position macro: the expansion must parse as one expression.
macro sum_macro($a: expr, $b: expr) => {
	($a) + ($b)
}

# Variadic repetition with no separator: one statement per argument.
macro print_each($args: expr...) => {
	$...(){ println$("print-each: ", $args); }
}

sum_all(a: i32, b: i32, c: i32) => i32 { a + b + c }

# Variadic repetition with a separator: builds one comma-separated call.
macro call_with_args($f: ident, $args: expr...) => {
	$f($...(,){ $args })
}

main() => void {
	println$("double-i32: ", double_i32(21));

	log_two$("first", "second");

	value := sum_macro$(10, 20);
	println$("sum-macro: ", value);

	print_each$(1, 2, 3);

	total := call_with_args$(sum_all, 1, 2, 3);
	println$("call-with-args: ", total);

	# `secret` cannot be named directly here, yet the imported macro still
	# reaches it: names written in a macro body resolve in the macro's own
	# definition environment, not the caller's.
	println$("read-secret: ", read_secret$());

	# `magic` was never imported; the `re_export$` alias above is what
	# makes it nameable here, proving path capture, substitution, reparse,
	# and downstream resolution work together.
	println$("magic: ", magic());
}
