import std::io::println;
foreign(c) terminate_now() => never;
before() => i32 { println$("before"); 1 }
after() => i32 { println$("after"); 3 }
consume(a: i32, b: i32, c: i32) => void { println$("outer-call"); }
struct Triple { exposed a: i32; exposed b: i32; exposed c: i32; }
main() => void {
    value := Triple { a = before(); b = terminate_now(); c = after(); };
    println$("after-expression");
}
