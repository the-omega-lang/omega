early(flag: bool, value: ^i32) => void {
    if flag { return; }
    value.* += 1;
}
with_defer(flag: bool, value: ^i32) => void {
    defer { value.* += 10; }
    if flag { return; }
    value.* += 100;
}
main() => void {
    ^value: i32 = 0;
    early(true, ^value);
    early(false, ^value);
    with_defer(true, ^value);
    with_defer(false, ^value);
    if value != 121 { panic$("incorrect return/defer order"); }
}
