import std::io::println;
import self::helper;

# A direct `foreign(c)` declaration gives a name a C-convention function type
# with no Omega body; calls use ordinary Omega call syntax.
shared foreign(c) malloc(size: usize) => *mut u8;
shared foreign(c) free(ptr: *u8) => void;

# `...` exists only for foreign conventions that support variadic arguments.
shared foreign(c) printf(format: *u8, ...) => i32;
shared foreign(c) fflush(stream: *mut u8) => i32;

# A variadic `sysv64` declaration: unlike `foreign(c)`, the tail is passed
# using its actual lowered Omega types with no C default-argument promotion.
shared foreign(sysv64) snprintf(buf: *mut u8, size: usize, format: *u8, ...) => i32;

# A `foreign(c)` block: direct entries inherit `c` without repeating it.
foreign(c) {
	shared abs(x: i32) => i32;
}

@mangling(disabled)
raw_add(a: i32, b: i32) => i32 { a + b }

# --- Omega-convention foreign items ---------------------------------------
# `foreign` selects symbol/linkage behavior, not ABI. Without `(cc)` the type
# is an ordinary Omega function type, so it uses the same `AbiSignature` as
# any internal Omega call and transports composites by value normally.

struct Quad {
	exposed a: i32;
	exposed b: i32;
	exposed c: i32;
	exposed d: i32;
}

# Four leaves, so the result also travels the Omega indirect-return (`sret`)
# path while the parameter is flattened.
foreign quad_rotate(value: Quad) => Quad {
	Quad { a = value.d; b = value.a; c = value.b; d = value.c; }
}

# Compile/link-only: an external data symbol has no calling convention at all,
# so its aggregate type is never a function-ABI question.
shared foreign external_quad : Quad;

# Compile/link-only: an Omega-convention function type named by a foreign
# binding keeps aggregates by value.
shared foreign omega_quad_fp : (value: Quad) => Quad;

# A `foreign(c)` block applies `c` only to direct signature entries. A typed
# entry's own type is authoritative, so this stays Omega-convention and
# therefore still accepts `Quad` by value.
foreign(c) {
	shared typed_quad_fp : (value: Quad) => Quad;
}

# A mangled `foreign(c)` definition: a C-convention function Omega itself
# defines and exports under its normal mangled symbol, callable both
# directly and through a `foreign(c)` function-pointer type.
@mangling(enabled)
foreign(c) c_callback(a: i32, b: i32) => i32 {
	a * b + 1
}

# A `sysv64` definition on the default x86-64 target: a distinct convention
# from `c`, even though both currently lower to the same machine ABI there.
@mangling(enabled)
foreign(sysv64) sysv_add(a: i32, b: i32) => i32 {
	a + b
}

main() => void {
	# --- foreign(c) declarations: scalars/pointers are the practical
	# interop boundary --------------------------------------------------------
	block := malloc(4usize);
	as_i32: *mut i32 = <*mut i32>block;
	*as_i32 = 77;
	println$("malloc-deref: ", *as_i32);
	free(<*u8>block);

	println$("abs(-5): ", abs(-5));

	# --- C-style variadic call: trailing arguments use the FFI ABI ------------
	# `fflush(NULL)` forces C stdio's own buffer out immediately, so this
	# output is not left racing Omega's independently-flushed `println$`.
	printf(<*u8>b"fixed text, no variadic arguments\n\0");
	fflush(<*mut u8>0usize);
	printf(<*u8>b"sum = %d\n\0", raw_add(2, 3));
	fflush(<*mut u8>0usize);

	# A floating-point variadic argument exercises the SysV `%al` vector-count
	# convention that a C variadic call depends on; see docs/issues history
	# for why this specifically needed a real LLVM-emitted regression.
	printf(<*u8>b"pi = %.2f\n\0", 3.14159f64);
	fflush(<*mut u8>0usize);

	# --- direct call and function-pointer call to a mangled foreign(c)
	# definition, and a distinct sysv64 definition -----------------------------
	println$("c_callback direct: ", c_callback(3, 4));
	c_fp: foreign(c) (a: i32, b: i32) => i32 = c_callback;
	println$("c_callback via pointer: ", c_fp(3, 4));
	println$("sysv_add: ", sysv_add(10, 20));

	# --- variadic sysv64 call: reuse the printf/fflush read-back pattern above
	# to observe exactly what the sysv64 tail delivered ------------------------
	mut sysv_buf: [32]u8;
	sysv_n := snprintf(&mut sysv_buf[0], 32usize, <*u8>b"sysv64 sum = %d\n\0", raw_add(10, 15));
	printf(<*u8>b"%s", <*u8>&mut sysv_buf[0]);
	fflush(<*mut u8>0usize);
	println$("sysv64 snprintf n: ", sysv_n);

	# --- bare `foreign` uses the Omega ABI: an aggregate crosses it by value
	# in both directions -----------------------------------------------------
	rotated := quad_rotate(Quad { a = 1; b = 2; c = 3; d = 4; });
	println$("quad_rotate: ", rotated.a, rotated.b, rotated.c, rotated.d);

	# --- program entry point: only root-module `main` is the C entry ---------
	println$("helper-main: ", helper::main());
}
