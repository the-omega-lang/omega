import extern::std::io::println;

# Type-check helpers: a call only compiles if the argument already has the
# exact expected type, so a passing compile is itself part of the assertion.
expect_i32(v: i32) => i32 { v }
expect_u8(v: u8) => u8 { v }
expect_f32(v: f32) => f32 { v }
expect_bool(v: bool) => bool { v }

mut side_effect_calls: i32 = 0;

record_call() => bool {
	side_effect_calls += 1;
	true
}

mut probe_calls: i32 = 0;

# Used to prove a compound-assignment target place is evaluated exactly once.
next_index() => i32 {
	probe_calls += 1;
	1
}

main() => i32 {
	# --- arithmetic: +, -, *, /, %, unary - -----------------------------------
	a := 17;
	b := 5;
	println$(
		"arith-int: ", expect_i32(a + b), " ", expect_i32(a - b), " ", expect_i32(a * b), " ",
		expect_i32(a / b), " ", expect_i32(a % b), " ", expect_i32(-a)
	);

	fa := 17.5f32;
	fb := 5.0f32;
	println$(
		"arith-float: ", expect_f32(fa + fb), " ", expect_f32(fa - fb), " ", expect_f32(fa * fb), " ",
		expect_f32(fa / fb), " ", expect_f32(-fa)
	);

	# --- logical: !, &&, ||, and short-circuit evaluation order ---------------
	t := true;
	f := false;
	println$("logical-basic: ", expect_bool(!t), " ", expect_bool(t && f), " ", expect_bool(t || f));

	side_effect_calls = 0;
	r1 := false && record_call();          # right side not evaluated
	println$("and-short-circuit: ", side_effect_calls, " ", r1);

	r2 := true || record_call();           # right side not evaluated
	println$("or-short-circuit: ", side_effect_calls, " ", r2);

	r3 := true && record_call();           # right side evaluated
	println$("and-evaluated: ", side_effect_calls, " ", r3);

	r4 := false || record_call();          # right side evaluated
	println$("or-evaluated: ", side_effect_calls, " ", r4);

	# --- bitwise: ~, &, |, ^, <<, >> -------------------------------------------
	bx: u8 = 0b00001100u8;   # 12
	by: u8 = 0b00001010u8;   # 10
	println$(
		"bitwise-ops: ", expect_u8(bx & by), " ", expect_u8(bx | by), " ", expect_u8(bx ^ by), " ",
		expect_u8(~bx), " ", expect_u8(bx << 2u8), " ", expect_u8(bx >> 2u8)
	);

	# Two's complement identity: `~x` equals `-x - 1`.
	println$("twos-complement: ", expect_i32(~5), " ", expect_i32(-5 - 1));

	# --- dereference: `*<ident>` reads through a pointer, prefix position -----
	value: i32 = 55;
	p: *i32 = &value;
	println$("deref-prefix: ", expect_i32(*p), " ", expect_i32(*p * 2));

	# --- operate-and-assign: same result as `x = x op y` ----------------------
	mut add_op := 23; add_op += 7;             mut add_plain := 23; add_plain = add_plain + 7;
	mut sub_op := 23; sub_op -= 7;             mut sub_plain := 23; sub_plain = sub_plain - 7;
	mut mul_op := 23; mul_op *= 7;             mut mul_plain := 23; mul_plain = mul_plain * 7;
	mut div_op := 23; div_op /= 7;             mut div_plain := 23; div_plain = div_plain / 7;
	mut rem_op := 23; rem_op %= 7;             mut rem_plain := 23; rem_plain = rem_plain % 7;
	mut and_op := 23; and_op &= 7;             mut and_plain := 23; and_plain = and_plain & 7;
	mut or_op := 23; or_op |= 7;               mut or_plain := 23; or_plain = or_plain | 7;
	mut xor_op := 23; xor_op ^= 7;             mut xor_plain := 23; xor_plain = xor_plain ^ 7;
	mut shl_op := 23; shl_op <<= 2;            mut shl_plain := 23; shl_plain = shl_plain << 2;
	mut shr_op := 23; shr_op >>= 2;            mut shr_plain := 23; shr_plain = shr_plain >> 2;

	println$(
		"compound-assign-eq: ", add_op == add_plain, " ", sub_op == sub_plain, " ", mul_op == mul_plain, " ",
		div_op == div_plain, " ", rem_op == rem_plain, " ", and_op == and_plain, " ",
		or_op == or_plain, " ", xor_op == xor_plain, " ", shl_op == shl_plain, " ",
		shr_op == shr_plain
	);
	println$(
		"compound-assign-vals: ", add_op, " ", sub_op, " ", mul_op, " ", div_op, " ", rem_op, " ",
		and_op, " ", or_op, " ", xor_op, " ", shl_op, " ", shr_op
	);

	# `x op= y` must evaluate its target place exactly once (see
	# docs/language/bindings-and-mutability.md). Known current deviation for
	# an indexed place: docs/issues/known-issues.md.
	mut counted: [4]i32 = [1, 2, 3, 4];
	probe_calls = 0;
	counted[next_index()] += 100;
	println$("indexed-place-eval: ", probe_calls, " ", counted[1]);

	# --- operator precedence: enough spot checks to catch an obviously wrong
	# reordering, not an exhaustive combinatorial sweep -------------------------
	additive_first := 2 + 3 * 4;          # multiplicative tighter than additive
	grouped := (2 + 3) * 4;               # explicit grouping overrides
	bitwise_vs_cmp := 6 & 3 == 2;         # (6 & 3) == 2
	or_vs_additive := 1 | 2 + 4;          # 1 | (2 + 4)
	range_check := 5 >= 1 && 5 <= 10;     # comparison tighter than `&&`
	shift_vs_additive := 1 + 2 << 3;      # (1 + 2) << 3
	shift_vs_mul := 2 << 1 * 3;           # 2 << (1 * 3)
	unary_vs_additive := -2 + 5;          # (-2) + 5
	not_vs_and := ~0 & 3;                 # (~0) & 3
	and_vs_shift := 12 & 4 << 1;          # 12 & (4 << 1)

	println$(
		"precedence: ", additive_first, " ", grouped, " ", bitwise_vs_cmp, " ", or_vs_additive, " ", range_check, " ",
		shift_vs_additive, " ", shift_vs_mul, " ", unary_vs_additive, " ", not_vs_and, " ", and_vs_shift
	);

	# `&` is address-of in prefix position and `*` is dereference in prefix
	# position, but bitwise-and / multiply in infix position; the same
	# tokens mean different things purely by where they appear.
	product := a * b;
	println$("prefix-vs-infix: ", product);

	# --- binary-operand literal inference: expected type flows to the RHS ----
	mut counter: u32 = 0;
	counter = counter + 1;
	println$("literal-inference: ", counter);

	return 0;
}
