# Inference holes: every `_` is solved by the inference its position already
# has (generics.md "Inference holes"). Each line prints values or sizes that
# only come out right when the hole was solved as specified.
import std::io::println;
import core::option::Option;
import core::iterator::{ Iterator, ToIterator };

exposed spec SpecThree { three(*self) => i32; }
meet SpecThree for i32 { three(*self) => i32 { 3 } }

# --- function generic arguments ------------------------------------------
@suppress(unused_parameter)
some_fn(value: i32) => *str { "concrete" }
@suppress(unused_parameter)
some_fn<T>(value: T) => *str { "generic" }

@suppress(unused_parameter)
f<T, U>(a: T, b: U) => usize { sizeof<U> }
@suppress(unused_parameter)
f<T, U, V>(a: T, b: U, c: V) => usize { sizeof<U> + sizeof<V> }

@suppress(unused_parameter)
thing<T, U: SpecThree>(a: T, b: U) => i32 { 1 }
@suppress(unused_parameter)
thing<T, U>(a: T, b: U) => i32 { 2 }

@suppress(unused_parameter)
count<comp N: usize, T>(values: [N]T) => usize { N }

@suppress(unused_parameter)
defaulted<T, U = u64>(a: T) => usize { sizeof<U> }

@suppress(unused_parameter)
rank<T>(value: T) => i32 { 33 }
@suppress(unused_parameter)
rank<T: SpecThree>(value: T) => i32 { 44 }

# --- aggregates and owner paths --------------------------------------------
struct Pair<T, U> {
    exposed a: T;
    exposed b: U;

    exposed new(a: T, b: U) => Pair<T, U> { Pair<T, U> { a = a; b = b; } }
}

struct Buffer<comp N: usize, T> {
    exposed data: [N]T;
}

make<T, U>(a: T, b: U) => Pair<T, U> { Pair<T, U> { a = a; b = b; } }
pair_of<T>(v: T) => Pair<T, T> { Pair<T, T> { a = v; b = v; } }

global : [_]u8 = [1, 2];

# Overloaded siblings of a different arity: selection sees the annotation's
# known parts through the overload engine, and only the winner is emitted.
hole_make<T, U>(a: T, b: U) => Pair<T, U> { Pair<T, U> { a = a; b = b; } }
@suppress(unused_parameter)
hole_make<T>(a: T) => Pair<T, T> { Pair<T, T> { a = a; b = a; } }

hole_pair_of<T>(v: T) => Pair<T, T> { Pair<T, T> { a = v; b = v; } }
@suppress(unused_parameter)
hole_pair_of<T>(v: T, w: T) => Pair<T, T> { Pair<T, T> { a = v; b = w; } }

struct Tagged<comp N: usize, T> {
    exposed v: T;
}
tagged<comp N: usize, T>(v: T) => Tagged<N, T> { Tagged<N, T> { v = v; } }
@suppress(unused_parameter)
tagged<comp N: usize, T>(v: T, w: T) => Tagged<N, T> { Tagged<N, T> { v = v; } }

alias Bytes = [2]u8;

struct Defaulted<T, U = [2]u8> {
    exposed a: T;
    exposed b: U;
}

struct Dependent<A, B, C = Pair<B, [2]B>> {
    exposed a: A;
    exposed b: B;
    exposed c: C;
}

@suppress(unused_parameter)
pick(v: u8) => u8 { 8 }
@suppress(unused_parameter)
pick(v: i32) => i32 { 32 }

# --- fully qualified spec calls --------------------------------------------
exposed spec Make { make() => Self; }
exposed spec Animal { make_sound(*self) => i32; }

struct Widget { exposed id: i32; }
meet Make for Widget { make() => Self { Self { id = 9; } } }

exposed spec Build<T> { build() => Self; }
meet Build<u8> for Widget { build() => Self { Self { id = 8; } } }

struct Dog { exposed id: i32; }
meet Animal for Dog { make_sound(*self) => i32 { 42 } }

# --- for-in: a source offering two element types ---------------------------
struct Twice { exposed n: i32; }

struct Wide { left: i32; }
meet Iterator<Pair<i32, u8>> for Wide {
    next(*mut self) => Option<Pair<i32, u8>> {
        if self.left == 0 { return Option<Pair<i32, u8>>::None; }
        self.left -= 1;
        Option<Pair<i32, u8>>::Some { value = Pair<i32, u8> { a = self.left; b = 7; }; }
    }
}

struct Narrow { left: i32; }
meet Iterator<i64> for Narrow {
    next(*mut self) => Option<i64> {
        if self.left == 0 { return Option<i64>::None; }
        self.left -= 1;
        Option<i64>::Some { value = 100i64; }
    }
}

meet ToIterator<Pair<i32, u8>> for Twice {
    to_iterator(*self) => Wide { Wide { left = self.n; } }
}
meet ToIterator<i64> for Twice {
    to_iterator(*self) => Narrow { Narrow { left = self.n; } }
}

main() => void {
    # `x : _ = e` is `x := e`.
    x : _ = 123;
    mut y : _ = 1u8;
    y += 1;
    println$("whole: ", x, " ", y);

    # A `_` argument is written: it selects a generic declaration and keeps
    # its position, so later arguments still land on later parameters.
    f2 := f<_, u32>("hello", 123);
    f3 := f<_, u64, _>("hello", 123, 456u16);
    println$("arguments: ", some_fn<_>(10), " ", f2, " ", f3);

    t1 := thing<i32 : _, _ : SpecThree>(1, 2);
    t2 := thing<_, _ : SpecThree>(1, 2);
    t3 := thing<_, i32>(1, 2);
    println$("selectors: ", t1, " ", t2, " ", t3);

    values := [1, 2, 3, 4];
    c := count<_, i32>(values);
    d := defaulted<_, _>(1);
    println$("comp-and-default: ", c, " ", d);

    taken: (i32) => i32 = rank<_ : SpecThree>;
    println$("value: ", rank<i32>(1), " ", taken(1));

    p := Pair<_, u8> { a = 1; b = 2; };
    q := Pair<_, u8>::new(300, 4);
    p_check : Pair<i32, u8> = p;
    q_check : Pair<i32, u8> = q;
    n : Option<u16> = Option<_>::None;
    size_pair := sizeof<Pair<i32, u8>>;
    println$("aggregates: ", p_check.b, " ", q_check.a, " ", size_pair);

    # Annotation holes are solved top-down from the annotation's known parts.
    v := 7;
    ptr : *_ = &v;
    lit : Pair<_, u8> = Pair { a = 1; b = 2; };
    arr : [_]u8 = [1, 2, 3];
    buf : Buffer<_, i32> = Buffer { data = [4, 5, 6]; };
    made : Pair<_, u8> = make(1, 2);
    same : Pair<_, u8> = pair_of(1);
    lit_check : Pair<i32, u8> = lit;
    arr_check : [3]u8 = arr;
    buf_check : Buffer<3, i32> = buf;
    made_check : Pair<i32, u8> = made;
    same_check : Pair<u8, u8> = same;
    global_check : [2]u8 = global;
    size_same := sizeof<Pair<u8, u8>>;
    println$("annotations: ", *ptr, " ", lit_check.b, " ", arr_check[2], " ", buf_check.data[1], " ", made_check.b, " ", same_check.a, " ", size_same, " ", global_check[1]);

    # Known parts of a partial annotation are exact types, however they are
    # spelled: an array, a nominal type, a function type.
    known_arr : Pair<_, [2]u8> = Pair { a = 1; b = [2, 3]; };
    known_arr_check : Pair<i32, [2]u8> = known_arr;
    known_nom : Pair<_, Pair<u8, u16>> = Pair { a = 1; b = Pair { a = 2; b = 300; }; };
    known_nom_check : Pair<i32, Pair<u8, u16>> = known_nom;
    known_fn : Pair<_, (u8) => u8> = Pair { a = 1; b = pick; };
    known_fn_check : Pair<i32, (u8) => u8> = known_fn;
    known_alias : Pair<_, Bytes> = Pair { a = 1; b = [4, 5]; };
    known_alias_check : Pair<i32, [2]u8> = known_alias;
    known_default : Defaulted<_> = Defaulted { a = 1; b = [6, 7]; };
    known_default_check : Defaulted<i32, [2]u8> = known_default;
    known_dependent : Dependent<_, u16> = Dependent { a = 1; b = 2; c = Pair { a = 3; b = [8, 9]; }; };
    known_dependent_check : Dependent<i32, u16, Pair<u16, [2]u16>> = known_dependent;
    println$("known-parts: ", known_arr_check.b[1], " ", known_nom_check.b.b, " ", known_fn_check.b(1), " ", known_alias_check.b[1], " ", known_default_check.b[1], " ", known_dependent_check.c.b[1]);

    over : Pair<_, u8> = hole_make(1, 2);
    over_check : Pair<i32, u8> = over;
    over_same : Pair<_, u8> = hole_pair_of(1);
    over_same_check : Pair<u8, u8> = over_same;
    over_tag : Tagged<3, _> = tagged(7);
    over_tag_check : Tagged<3, i32> = over_tag;
    over_same_size := sizeof<Pair<u8, u8>>;
    println$("overloaded: ", over_check.b, " ", over_same_check.a, " ", over_tag_check.v, " ", over_same_size);

    # Every branch sees the annotation, whatever an earlier one did.
    first_diverges : Pair<_, u8> = if false { return; } else { hole_make(1, 3) };
    middle_diverges : Pair<_, u8> = if false { hole_make(1, 4) } else if false { return; } else { hole_make(2, 5) };
    neither : Pair<_, u8> = if true { hole_make(3, 6) } else { Pair { a = 4; b = 7; } };
    arms : Pair<_, u8> = match 1 {
        0 => hole_make(5, 8),
    } else {
        hole_make(6, 9)
    };
    first_check : Pair<i32, u8> = first_diverges;
    middle_check : Pair<i32, u8> = middle_diverges;
    neither_check : Pair<i32, u8> = neither;
    arms_check : Pair<i32, u8> = arms;
    println$("branches: ", first_check.b, " ", middle_check.b, " ", neither_check.b, " ", arms_check.b);

    t := Twice { n = 2; };
    for e : Pair<_, u8> in t {
        println$("for-pair: ", e.a, " ", e.b);
    }
    for r : _ in 0..<2 {
        println$("for-whole: ", r);
    }

    dog := Dog { id = 1; };
    via_self : Widget = <_ : Make>::make();
    via_spec := <Widget : _>::make();
    sound := <_ : Animal>::make_sound(&dog);
    via_generic := <Widget : _>::build();
    println$("qualified: ", via_self.id, " ", via_spec.id, " ", sound, " ", <Dog : _>::make_sound(&dog), " ", dog.id, " ", via_generic.id);
    <void>n;
}
