# `for ... in` walks a slice by value and a string by decoded `char`, each
# maximal ill-formed UTF-8 subpart yielding one U+FFFD
# (iteration-and-ranges.md).
import std::io::println;

struct Point {
    exposed x: i32;
    exposed y: i32;
}

main() => void {
    numbers := [3, 1, 4];
    ^total := 0;
    for n in *numbers[0..] {
        total += n;
    }
    println$("slice-sum: ", total);

    points := [Point { x = 1; y = 2; }, Point { x = 3; y = 4; }];
    for p in *points[0..] {
        println$("point: ", p.x, " ", p.y);
    }

    ^bytes : [_]u8 = [10, 20];
    for b in ^bytes[0..] {
        println$("mutable-slice: ", b);
    }

    empty := *numbers[0..<0];
    for n in empty {
        println$("never: ", n);
    }

    for c in "aé€😀" {
        println$("char: ", c, " ", <u32>c);
    }

    # 'a', a truncated 4-byte sequence, 'b', two invalid leads, a surrogate
    # encoding, and a truncated 3-byte sequence at the end.
    raw : [_]u8 = [0x61, 0xF0, 0x9F, 0x80, 0x62, 0xC0, 0x80, 0xED, 0xA0, 0x80, 0xE2, 0x82];
    ^decoded := 0;
    for c in <*str>*raw[0..] {
        println$("decoded: ", <u32>c);
        decoded += 1;
    }
    println$("decoded-count: ", decoded);
}
