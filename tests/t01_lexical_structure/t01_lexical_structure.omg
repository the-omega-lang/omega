import extern::std::io::println;

# A single hash starts a line comment.

##
A run of two or more hashes opens a multiline comment,
closed by a matching run of the same length.
##

#### An embedded ### run of a different length ### does not close this comment. ####

# Contextual keywords lex as ordinary identifiers outside the grammar
# positions that consume them contextually.
describe(to: i32, reveal: i32, ident: i32) => i32 {
	to + reveal + ident
}

main() => void {
	type := 7;
	root := 8;
	glue := 9;
	gap := 10;
	marker := 11;
	conform := 12;
	primitive := 13;
	internal := 14;
	exposed := 15;
	comp := 16;
	expr := 17;
	in := 18;

	sum := describe(1, 2, 3) + type + root + glue + gap + marker
		+ conform + primitive + internal + exposed + comp + expr + in;
	println$("sum: ", sum);

	# String escapes.
	println$("line one\nline two\ttabbed\\backslash \"quoted\" it\'s");

	# \0 terminates observable output at the write layer boundary, so keep
	# it away from the end of a printed string; here it just proves the
	# escape decodes without breaking the surrounding literal.
	with_nul := "before\0after";
	println$("nul-string-size: ", with_nul.size);

	# Unicode escapes and literal Unicode source text both work.
	println$("omega: \u{03A9}, cafe: caf\u{00E9}");

	# Multiline strings are raw/verbatim: escapes are not decoded.
	raw := """
first line, literal backslash-n next: \n
second line
""";
	println$(raw);

	# Byte strings share string escape decoding but produce *[]u8, not str.
	greeting := b"raw\tbytes";
	println$(<*str>greeting);

	# Character literals: plain ASCII, Unicode, and escaped.
	letter: char = 'A';
	accented: char = 'é';
	newline: char = '\n';
	omega: char = '\u{03A9}';
	println$("char-literals: ", letter, " ", accented, " ", omega);
	if newline == '\n' { println$("newline literal matches"); }

	# Boolean literals are keyword tokens, not identifiers.
	flag := true;
	other := false;
	println$("bool-literals: ", flag, " ", other);

	# Integer literal bases.
	dec := 123;
	hex := 0xFF;
	oct := 0o755;
	bin := 0b1010;
	println$("int-bases: ", dec, " ", hex, " ", oct, " ", bin);

	# Underscores inside a digit run do not change the value.
	million := 1_000_000;
	hex_grouped := 0xFF_FF;
	println$("underscore-digits: ", million, " ", hex_grouped);

	# A decimal point only starts a fractional part when a digit follows it,
	# which keeps `0..5` from being lexed as `0.` followed by `.5`.
	one := 1.0;
	small := 0.125f32;
	mut hits := 0;
	for i in 0..<5 { hits += 1; }
	println$("float-lex: ", one, " ", small, " ", hits);

	# Numeric suffixes: usize, isize, i<N>, u<N>, f<N>.
	byte_lit := 7u32;
	wide := 10i64;
	size_lit := 8usize;
	signed_size := 3isize;
	ratio := 3.5f32;
	println$("numeric-suffixes: ", byte_lit, " ", wide, " ", size_lit, " ", signed_size, " ", ratio);
}
