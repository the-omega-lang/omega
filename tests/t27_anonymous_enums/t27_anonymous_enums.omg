import std::io::println;
import self::helper;

struct Failure {
	exposed code: i32;

	exposed new(code: i32) => Self {
		Self { code = code; }
	}

	exposed describe(*self) => *str {
		"failure"
	}
}

enum Kind {
	Small,
	Large;
}

# An alias adds no identity: `Errors` *is* the anonymous enum, in any spelling.
alias Errors = enum Failure | *str;

# A reordered spelling of the same type: same canonical members, same tags,
# same layout, same symbol.
reordered(value: enum *str | Failure) => i32 {
	match value {
		Failure => value.code,
		*str => 0,
	}
}

# Duplicates collapse, and a single-member anonymous enum is legal.
one_member(value: enum i32 | i32) => i32 {
	match value {
		i32 => value,
	}
}

# An immediate anonymous-enum member is flattened away, so `Nested` has the
# three leaf members `Kind`, `Failure`, and `*str`. A named enum stays atomic.
alias Nested = enum Kind | Errors;

# Generic substitution re-enters the same canonicalization.
alias WithKind<T> = enum T | Kind;
alias Twice<T> = enum T | Errors;

pick(n: i32) => Errors {
	if n < 0 {
		# a struct value injects as the `Failure` member
		Failure::new(n)
	} else if n == 0 {
		# an unsuffixed literal keeps its default type, so this one is not a
		# member and needs the explicit member value instead
		"zero"
	} else {
		"positive"
	}
}

describe(value: Errors) => *str {
	match value {
		Failure => value.describe(),
		*str => value,
	}
}

# `..` covers what the explicit arms left.
only_str(value: Errors) => *str {
	match value {
		*str => value,
		.. => "not a string",
	}
}

# `else` completes coverage the same way.
tag_of(value: Errors) => i32 {
	match value {
		Failure => 1,
	} else {
		0
	}
}

# Refinement works through a pointer to the anonymous enum.
through_pointer(value: *Errors) => i32 {
	match value {
		Failure => value.code,
		*str => <i32>(*value).size,
	}
}

describe_nested(value: Nested) => *str {
	match value {
		Kind => "kind",
		Failure => value.describe(),
		*str => value,
	}
}

# The flat spelling is the same type, so it accepts a `Nested` value with no
# conversion at all.
flat_spelling(value: enum *str | Kind | Failure) => *str {
	describe_nested(value)
}

# The expected return type reaches every arm, so arms producing two different
# leaf types are checked -- and injected -- against it.
from_kind(kind: Kind) => Errors {
	match kind {
		Kind::Small => "small",
		Kind::Large => Failure::new(11),
	}
}

struct Holder {
	exposed slot: Errors;
}

# --- widening into an explicitly established anonymous enum ----------------

# `Bulk` sorts before both of `Narrow`'s members canonically, so widening
# shifts *every* source tag, and `Wide`'s payload is larger than `Narrow`'s.
# Nothing here can be a tag-preserving bit copy.
struct Bulk {
	exposed high: i64;
	exposed low: i64;
}

struct Tiny {
	exposed n: i32;
}

alias Narrow = enum Tiny | i32;
alias Wide = enum Bulk | Tiny | i32;

wide_payload(value: Wide) => i32 {
	match value {
		Bulk => <i32>value.low,
		Tiny => value.n,
		i32 => value,
	}
}

# Widening at a return: the declared type establishes the destination.
to_wide(value: Narrow) => Wide {
	value
}

struct WideHolder {
	exposed slot: Wide;
}

# Exact acceptance still outranks a candidate that has to widen.
rank(value: Narrow) => *str {
	"narrow"
}

rank(value: Wide) => *str {
	"wide"
}

as_narrow(n: i32) => Narrow {
	n
}

# A widened constant is still a constant, so it can initialize a global.
exposed GLOBAL_WIDE: Wide = comp as_narrow(41);

widen_at_comp(value: Narrow) => i32 {
	wide_payload(value)
}

cast_at_comp(value: Narrow) => i32 {
	wide_payload(<Wide>value)
}

# Widening and cast injection fold at compile time on the same remap the
# runtime uses.
comp COMP_WIDENED := comp widen_at_comp(Tiny { n = 21; });
comp COMP_CAST_WIDENED := comp cast_at_comp(Tiny { n = 22; });
comp COMP_RAW := 23;
comp COMP_CONST_CAST := comp wide_payload(<Wide>COMP_RAW);

struct Box<T> {
	exposed value: T;
}

wrap<T>(value: T) => Box<T> {
	Box<T> { value = value; }
}

# Exact acceptance outranks a candidate that has to pack the argument.
which(value: *str) => *str {
	"exact"
}

which(value: Errors) => *str {
	"injected"
}

exposed GLOBAL_ERROR: Errors = comp "global";

# Injection and matching are both compile-time evaluable: an anonymous value
# is an ordinary tagged enum constant.
classify(value: enum i32 | bool) => i32 {
	match value {
		i32 => value,
		bool => 100,
	}
}

comp COMP_INT := comp classify(7);
comp COMP_BOOL := comp classify(true);

main() => void {
	# --- injection at a local declaration, and matching by member type -----
	failure: Errors = Failure::new(3);
	text: Errors = "text";
	println$("inject-and-match: ", describe(failure), " ", describe(text));

	# --- the reordered spelling is the same type, with the same tags -------
	println$("reordered-identity: ", reordered(failure), " ", reordered(text));

	# --- duplicate members collapse; one member is enough -----------------
	println$("dedup: ", one_member(41) + 1);

	# --- injection at a return, a call argument, and a struct field -------
	held := Holder { slot = Failure::new(9); };
	println$("return-and-field: ", describe(pick(-5)), " ", describe(pick(1)), " ", describe(held.slot));

	# --- catch-all and `else` complete coverage ---------------------------
	println$("catch-all: ", only_str(text), " ", only_str(failure), " ", tag_of(failure), " ", tag_of(text));

	# --- a refined binding reaches the member's own fields and methods ----
	println$("member-access: ", describe(failure), " ", reordered(failure));

	# --- pointer scrutinee, refined through the pointer -------------------
	println$("pointer-match: ", through_pointer(&failure), " ", through_pointer(&text));

	# --- a nested anonymous member flattens into leaf members -------------
	kind: Nested = Kind::Large;
	inner: Nested = Failure::new(7);
	println$("nested: ", describe_nested(kind), " ", describe_nested(inner), " ", describe_nested("leaf"));

	# --- an array of the anonymous enum, injected element by element ------
	items: [2]Errors = ["first", Failure::new(2)];
	println$("array: ", describe(items[0]), " ", describe(items[1]));

	# --- a global initialized by injection --------------------------------
	println$("global: ", describe(GLOBAL_ERROR));

	# --- injection at a call argument, including from a bare literal ------
	println$("argument-injection: ", describe(Failure::new(4)), " ", describe("arg"));

	# --- exact acceptance beats injection ---------------------------------
	println$("overload-rank: ", which("s"), " ", which(Failure::new(5)));

	# --- an anonymous enum as a generic argument --------------------------
	boxed: Box<Errors> = Box<Errors> { value = Failure::new(6); };
	rewrapped := wrap(boxed.value);
	println$("generic-argument: ", describe(boxed.value), " ", reordered(rewrapped.value));

	# --- another module's reversed spelling is the same type --------------
	cross: enum i32 | *str = 5;
	println$("cross-module: ", helper::label(cross), " ", helper::label("cross-str"));

	# --- compile-time injection, matching, and size -----------------------
	println$("comp: ", COMP_INT, " ", COMP_BOOL, " ", sizeof<enum i32 | bool>);

	# --- identical spellings have identical size --------------------------
	println$("sizeof-identity: ", sizeof<Errors> == sizeof<enum *str | Failure>, " ", sizeof<enum i32 | i32> == sizeof<enum i32>);

	# --- the flat spelling is the very same type --------------------------
	println$("flatten-identity: ", flat_spelling(kind), " ", sizeof<Nested> == sizeof<enum *str | Kind | Failure>);

	# --- generic substitution flattens, and collapses the duplicates ------
	substituted: WithKind<Errors> = Failure::new(8);
	println$("generic-flatten: ", describe_nested(substituted), " ", sizeof<Twice<Errors>> == sizeof<Errors>);

	# --- an explicit type makes `if` branches and `match` arms inject -----
	n := 1;
	branch: Errors = if n > 0 { Failure::new(10) } else { "branch" };
	println$("expected-branches: ", describe(branch), " ", describe(from_kind(Kind::Small)), " ", describe(from_kind(Kind::Large)));

	# --- widening into an explicit destination, retagging as it goes ------
	narrow_small : Narrow = Tiny { n = 7; };
	narrow_int : Narrow = 3;
	widened : Wide = narrow_small;
	held_wide := WideHolder { slot = narrow_int; };
	println$("widen: ", wide_payload(widened), " ", wide_payload(to_wide(narrow_small)), " ", wide_payload(held_wide.slot));

	# --- a cast establishes the destination just as an expected type does -
	cast_widened := <Wide>narrow_small;
	cast_injected := <Wide>Tiny { n = 12; };
	raw_cast := <enum i32 | *str>10;
	println$("cast: ", wide_payload(cast_widened), " ", wide_payload(cast_injected), " ", helper::label(raw_cast));

	# --- a cast alone establishes the type, and exact acceptance still ---
	#     outranks the candidate that would have to widen ------------------
	standalone := <Narrow>Tiny { n = 31; };
	println$("cast-explicitness: ", rank(standalone), " ", rank(widened));

	# --- widening and casting are compile-time evaluable ------------------
	println$("comp-widen: ", COMP_WIDENED, " ", COMP_CAST_WIDENED, " ", COMP_CONST_CAST, " ", wide_payload(GLOBAL_WIDE));

	# --- a nested spelling across a module boundary is the same type ------
	cross_flat: enum bool | i32 | *str = 7;
	println$("cross-nested: ", helper::tag_of_nested(cross_flat), " ", helper::tag_of_nested(true), " ", helper::tag_of_nested("cn"));
}
