# Conformance for the `never` section of
# `docs/language/types-and-primitives.md`: a `foreign` declaration returning
# `never` is a contract with foreign code, and a call site that the callee
# returns to reports the broken contract there, at the call, rather than
# continuing into a program state the declaration said was impossible.
import std::io::println;

# Declared `never` here; its C definition is an ordinary `void` function in
# its own compilation, with no non-return annotation for a backend to believe.
foreign(c) terminate_now() => never;

before() => i32 {
    println$("argument-before");
    1
}

after() => i32 {
    println$("argument-after");
    3
}

consume(a: i32, b: i32, c: i32) => void {
    println$("outer-call");
}

invoke(flag: bool) => void {
    println$("before-call");
    consume(before(), if flag { terminate_now() } else { 0 }, after());
    println$("after-call");
}

main() => void {
    invoke(true);
}
