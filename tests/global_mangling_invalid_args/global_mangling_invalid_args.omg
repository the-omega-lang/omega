# Every global here is unused: an annotation is validated when the signature is
# resolved, not when something reads the storage.

@mangling(force = "")
empty_name : i32 = 1;

@mangling(nonsense)
unknown_mode : i32 = 2;

@mangling(force = 3)
non_string_name : i32 = 3;

@mangling
missing_mode := 4;

@mangling(disabled)
@mangling(disabled)
mut repeated : i32 = 5;

@unheard_of
unknown_annotation : i32 = 6;

main() => void {}
