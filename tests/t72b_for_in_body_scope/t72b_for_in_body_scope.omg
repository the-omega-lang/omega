# A loop reaches its cursor's `next` through the conformance without putting
# that conformance in scope, so the body cannot call it on another value.
struct Countdown { exposed left: i32; }

meet Iterator<i32> for Countdown {
	next(*mut self) => Option<i32> { Option<i32>::None }
}

main() => void {
	c := Countdown { left = 3; };
	mut other := Countdown { left = 1; };
	for item in c {
		<void>other.next();
	}
}
