import std::io::println;
import core::atomic::Atomicity32;
import core::atomic::AtomicLoadOrdering;
import core::atomic::AtomicStoreOrdering;
import core::atomic::AtomicRmwOrdering;
import std::atomic::AtomicU32;
import std::atomic::AtomicI32;
import std::atomic::AtomicBool;
import std::atomic::AtomicU16;
import std::atomic::AtomicI64;
import std::alloc::alloc;
import std::alloc::free;

show_u32(label: *str, result: Result<u32, u32>) => void {
	match result {
		Result::Ok => println$(label, ": ok ", result.value),
		Result::Err => println$(label, ": err ", result.error),
	}
}

show_i32(label: *str, result: Result<i32, i32>) => void {
	match result {
		Result::Ok => println$(label, ": ok ", result.value),
		Result::Err => println$(label, ": err ", result.error),
	}
}

show_u16(label: *str, result: Result<u16, u16>) => void {
	match result {
		Result::Ok => println$(label, ": ok ", result.value),
		Result::Err => println$(label, ": err ", result.error),
	}
}

show_i64(label: *str, result: Result<i64, i64>) => void {
	match result {
		Result::Ok => println$(label, ": ok ", result.value),
		Result::Err => println$(label, ": err ", result.error),
	}
}

show_bool(label: *str, result: Result<bool, bool>) => void {
	match result {
		Result::Ok => println$(label, ": ok ", result.value),
		Result::Err => println$(label, ": err ", result.error),
	}
}

# `atomics.md` requires every atomic location to be naturally aligned, and
# `std`'s wrappers state that with `@layout(align = sizeof<T>)`. That is an
# address guarantee, so it must survive being nested inside declarations
# that make no alignment request of their own -- a leading byte, a container
# holding the wrapper, a trailing byte, an array element, a global, and a
# heap block all have to keep the wrapper's own alignment.
struct Inner {
	exposed pad: u8;
	exposed counter: AtomicI64;
}

struct Nested {
	exposed lead: u8;
	exposed inner: Inner;
	exposed trail: u8;
}

mut global_nested: Nested;

naturally_aligned(address: usize) => bool { address % sizeof<i64> == 0 }

# The raw gaps take the address of ordinary storage, so this wrapper gives
# the slots below owning storage that already meets `atomics.md` rather than
# leaving it to where the frame happens to put them.
@layout(align = sizeof<u32>)
struct RawSlots {
	exposed unsigned: u32;
	exposed signed: i32;
}

# The core gaps work on ordinary mutable storage; a wrapper type is a
# convenience, not the source of atomicity.
raw_operations() => void {
	mut slots := RawSlots { unsigned = 0u32; signed = -5i32; };
	println$("raw-slot-aligned: ", <usize>&slots.unsigned % sizeof<u32> == 0);
	Atomicity32::store(&mut slots.unsigned, 7u32, AtomicStoreOrdering::Relaxed);
	println$("raw-load: ", Atomicity32::load(&slots.unsigned, AtomicLoadOrdering::Acquire));

	println$("raw-exchange: ", Atomicity32::exchange(&mut slots.unsigned, 9u32, AtomicRmwOrdering::AcquireRelease));
	println$("raw-after-exchange: ", Atomicity32::load(&slots.unsigned, AtomicLoadOrdering::SeqConsistent));

	println$("raw-fetch-add: ", Atomicity32::fetch_add(&mut slots.unsigned, 3u32, AtomicRmwOrdering::Relaxed));
	println$("raw-after-fetch-add: ", Atomicity32::load(&slots.unsigned, AtomicLoadOrdering::Relaxed));

	println$("raw-fetch-min-unsigned: ", Atomicity32::fetch_min_unsigned(&mut slots.unsigned, 5u32, AtomicRmwOrdering::Release));
	println$("raw-after-fetch-min-unsigned: ", Atomicity32::load(&slots.unsigned, AtomicLoadOrdering::Relaxed));

	show_u32("raw-compare-exchange-success", Atomicity32::compare_exchange(&mut slots.unsigned, 5u32, 50u32, AtomicRmwOrdering::SeqConsistent, AtomicLoadOrdering::Relaxed));
	show_u32("raw-compare-exchange-failure", Atomicity32::compare_exchange(&mut slots.unsigned, 5u32, 60u32, AtomicRmwOrdering::SeqConsistent, AtomicLoadOrdering::Relaxed));
	println$("raw-after-compare-exchange: ", Atomicity32::load(&slots.unsigned, AtomicLoadOrdering::Relaxed));

	# Signed min/max are separate gap members, so the comparison is a signed
	# one rather than a guess about an unsigned bit pattern.
	println$("raw-fetch-min-signed: ", Atomicity32::fetch_min_signed(&mut slots.signed, 3i32, AtomicRmwOrdering::Relaxed));
	println$("raw-after-fetch-min-signed: ", slots.signed);
	println$("raw-fetch-max-signed: ", Atomicity32::fetch_max_signed(&mut slots.signed, 3i32, AtomicRmwOrdering::Relaxed));
	println$("raw-after-fetch-max-signed: ", slots.signed);
}

# Every one of these locations is reached through a declaration that never
# asks for alignment itself; each must still be naturally aligned before the
# operation runs, and must produce the ordinary result afterwards.
nested_alignment() => void {
	mut local := Nested {
		lead = 1u8;
		inner = Inner { pad = 2u8; counter = AtomicI64::new(5i64); };
		trail = 3u8;
	};
	println$("nested-local-aligned: ", naturally_aligned(<usize>&local.inner.counter));
	println$("nested-local-fetch-add: ", local.inner.counter.fetch_add(4i64, AtomicRmwOrdering::SeqConsistent));
	println$("nested-local-load: ", local.inner.counter.load(AtomicLoadOrdering::Acquire));
	println$("nested-local-neighbours: ", local.lead, " ", local.inner.pad, " ", local.trail);

	global_nested = Nested {
		lead = 6u8;
		inner = Inner { pad = 7u8; counter = AtomicI64::new(20i64); };
		trail = 8u8;
	};
	println$("nested-global-aligned: ", naturally_aligned(<usize>&global_nested.inner.counter));
	global_nested.inner.counter.store(30i64, AtomicStoreOrdering::Release);
	println$("nested-global-exchange: ", global_nested.inner.counter.exchange(31i64, AtomicRmwOrdering::AcquireRelease));
	println$("nested-global-load: ", global_nested.inner.counter.load(AtomicLoadOrdering::SeqConsistent));

	mut row: [3]Nested;
	mut index: usize = 0;
	mut row_aligned := true;
	while index < 3 {
		row[index] = Nested {
			lead = <u8>index;
			inner = Inner { pad = 9u8; counter = AtomicI64::new(<i64>index * 10i64); };
			trail = <u8>index;
		};
		if !naturally_aligned(<usize>&row[index].inner.counter) { row_aligned = false; }
		index += 1;
	}
	println$("nested-array-aligned: ", row_aligned);
	println$("nested-array-fetch-max: ", row[2].inner.counter.fetch_max(25i64, AtomicRmwOrdering::Relaxed));
	println$("nested-array-loads: ",
		row[0].inner.counter.load(AtomicLoadOrdering::Relaxed), " ",
		row[1].inner.counter.load(AtomicLoadOrdering::Relaxed), " ",
		row[2].inner.counter.load(AtomicLoadOrdering::Relaxed));

	# Reached through a pointer, the alignment has to come from the
	# allocation rather than from where the frame happened to land.
	heap := <*mut Nested>alloc(sizeof<Nested>, alignof<Nested>);
	*heap = Nested {
		lead = 4u8;
		inner = Inner { pad = 5u8; counter = AtomicI64::new(50i64); };
		trail = 6u8;
	};
	println$("nested-heap-aligned: ", naturally_aligned(<usize>&(*heap).inner.counter));
	println$("nested-heap-fetch-sub: ", (*heap).inner.counter.fetch_sub(8i64, AtomicRmwOrdering::AcquireRelease));
	println$("nested-heap-load: ", (*heap).inner.counter.load(AtomicLoadOrdering::Acquire));
	free(<*u8>heap);
}

unsigned_wrapper() => void {
	mut counter := AtomicU32::new(10u32);
	println$("u32-load: ", counter.load(AtomicLoadOrdering::SeqConsistent));

	println$("u32-fetch-add: ", counter.fetch_add(5u32, AtomicRmwOrdering::Relaxed));
	println$("u32-fetch-sub: ", counter.fetch_sub(3u32, AtomicRmwOrdering::Relaxed));
	println$("u32-fetch-and: ", counter.fetch_and(10u32, AtomicRmwOrdering::Relaxed));
	println$("u32-fetch-or: ", counter.fetch_or(1u32, AtomicRmwOrdering::Relaxed));
	println$("u32-fetch-xor: ", counter.fetch_xor(255u32, AtomicRmwOrdering::Relaxed));
	println$("u32-after-bitwise: ", counter.load(AtomicLoadOrdering::Relaxed));

	counter.store(100u32, AtomicStoreOrdering::Release);
	println$("u32-fetch-max: ", counter.fetch_max(150u32, AtomicRmwOrdering::Relaxed));
	println$("u32-fetch-min: ", counter.fetch_min(20u32, AtomicRmwOrdering::Relaxed));
	println$("u32-exchange: ", counter.exchange(7u32, AtomicRmwOrdering::AcquireRelease));

	show_u32("u32-compare-exchange-success", counter.compare_exchange(7u32, 8u32, AtomicRmwOrdering::AcquireRelease, AtomicLoadOrdering::Acquire));
	show_u32("u32-compare-exchange-failure", counter.compare_exchange(7u32, 9u32, AtomicRmwOrdering::AcquireRelease, AtomicLoadOrdering::Acquire));

	# Omega orders the two paths independently: a failure ordering stronger
	# than the success ordering is a valid request, not an error.
	show_u32("u32-compare-exchange-weak", counter.compare_exchange_weak(8u32, 11u32, AtomicRmwOrdering::Relaxed, AtomicLoadOrdering::SeqConsistent));
	println$("u32-final: ", counter.load(AtomicLoadOrdering::Relaxed));
}

signed_wrapper() => void {
	mut value := AtomicI32::new(-1i32);
	println$("i32-load: ", value.load(AtomicLoadOrdering::Acquire));

	println$("i32-fetch-add: ", value.fetch_add(-4i32, AtomicRmwOrdering::Relaxed));
	println$("i32-fetch-sub: ", value.fetch_sub(-10i32, AtomicRmwOrdering::Relaxed));
	println$("i32-after-arithmetic: ", value.load(AtomicLoadOrdering::Relaxed));

	println$("i32-fetch-min: ", value.fetch_min(-7i32, AtomicRmwOrdering::Relaxed));
	println$("i32-fetch-max: ", value.fetch_max(-9i32, AtomicRmwOrdering::Relaxed));
	println$("i32-after-min-max: ", value.load(AtomicLoadOrdering::Relaxed));

	println$("i32-fetch-xor: ", value.fetch_xor(-1i32, AtomicRmwOrdering::Relaxed));
	println$("i32-fetch-or: ", value.fetch_or(1i32, AtomicRmwOrdering::Relaxed));
	println$("i32-fetch-and: ", value.fetch_and(2i32, AtomicRmwOrdering::Relaxed));
	println$("i32-after-bitwise: ", value.load(AtomicLoadOrdering::Relaxed));

	println$("i32-exchange: ", value.exchange(-100i32, AtomicRmwOrdering::SeqConsistent));
	show_i32("i32-compare-exchange-success", value.compare_exchange(-100i32, 42i32, AtomicRmwOrdering::AcquireRelease, AtomicLoadOrdering::Relaxed));
	show_i32("i32-compare-exchange-failure", value.compare_exchange(-100i32, 43i32, AtomicRmwOrdering::AcquireRelease, AtomicLoadOrdering::Relaxed));
	println$("i32-final: ", value.load(AtomicLoadOrdering::Relaxed));
}

boolean_wrapper() => void {
	mut flag := AtomicBool::new(false);
	println$("bool-load: ", flag.load(AtomicLoadOrdering::Acquire));

	println$("bool-exchange: ", flag.exchange(true, AtomicRmwOrdering::AcquireRelease));
	println$("bool-fetch-and: ", flag.fetch_and(false, AtomicRmwOrdering::Relaxed));
	println$("bool-fetch-or: ", flag.fetch_or(true, AtomicRmwOrdering::Relaxed));
	println$("bool-fetch-xor: ", flag.fetch_xor(true, AtomicRmwOrdering::Relaxed));
	println$("bool-after-bitwise: ", flag.load(AtomicLoadOrdering::Relaxed));

	flag.store(true, AtomicStoreOrdering::SeqConsistent);
	show_bool("bool-compare-exchange-success", flag.compare_exchange(true, false, AtomicRmwOrdering::Release, AtomicLoadOrdering::Relaxed));
	show_bool("bool-compare-exchange-failure", flag.compare_exchange(true, true, AtomicRmwOrdering::Release, AtomicLoadOrdering::Relaxed));
	show_bool("bool-compare-exchange-weak", flag.compare_exchange_weak(false, true, AtomicRmwOrdering::Relaxed, AtomicLoadOrdering::Acquire));
	println$("bool-final: ", flag.load(AtomicLoadOrdering::SeqConsistent));
}

# Each storage width is its own capability, so a platform can fill one and
# leave another open. The 8-bit width is reached through `AtomicBool` and the
# 32-bit one through the wrappers above; these two reach the remaining ones.
remaining_widths() => void {
	mut half := AtomicU16::new(1000u16);
	println$("u16-fetch-add: ", half.fetch_add(24u16, AtomicRmwOrdering::Relaxed));
	println$("u16-exchange: ", half.exchange(7u16, AtomicRmwOrdering::SeqConsistent));
	show_u16("u16-compare-exchange-success", half.compare_exchange(7u16, 65535u16, AtomicRmwOrdering::AcquireRelease, AtomicLoadOrdering::Relaxed));
	println$("u16-final: ", half.load(AtomicLoadOrdering::SeqConsistent));

	mut wide := AtomicI64::new(-2i64);
	println$("i64-fetch-sub: ", wide.fetch_sub(6i64, AtomicRmwOrdering::Release));
	println$("i64-fetch-min: ", wide.fetch_min(-100i64, AtomicRmwOrdering::Relaxed));
	println$("i64-fetch-or: ", wide.fetch_or(3i64, AtomicRmwOrdering::Relaxed));
	show_i64("i64-compare-exchange-failure", wide.compare_exchange(0i64, 1i64, AtomicRmwOrdering::SeqConsistent, AtomicLoadOrdering::Acquire));
	println$("i64-final: ", wide.load(AtomicLoadOrdering::Relaxed));
}

main() => void {
	raw_operations();
	unsigned_wrapper();
	signed_wrapper();
	boolean_wrapper();
	remaining_widths();
	nested_alignment();
}
