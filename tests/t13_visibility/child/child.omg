exposed struct Public {
	exposed data: i32;
}

shared struct PackageWide {
	exposed data: i32;
}

# No modifier: hidden by default, visible only throughout this module.
struct HiddenByDefault {
	exposed data: i32;
}

exposed make_hidden(v: i32) => HiddenByDefault {
	HiddenByDefault { data = v; }
}

# A hidden top-level item is visible throughout its exact declaring module.
hidden_helper(v: i32) => i32 {
	v * 2
}

exposed call_hidden_helper(v: i32) => i32 {
	hidden_helper(v)
}

exposed struct Box {
	exposed visible_field: i32;
	hidden_field: i32;

	exposed new(v: i32, h: i32) => Self {
		Self { visible_field = v; hidden_field = h; }
	}

	hidden_double(*self) => i32 {
		self.hidden_field * 2
	}

	exposed call_hidden_double(*self) => i32 {
		self.hidden_double()
	}
}

# Hidden members are visible throughout their declaring module, not only
# inside the owner's own methods.
exposed read_box_internals(b: *Box) => i32 {
	b.hidden_field + b.hidden_double()
}

exposed make_box_directly(v: i32, h: i32) => Box {
	Box { visible_field = v; hidden_field = h; }
}

shared spec Mammal {
	breathe(*self) => i32;
}

meet Mammal for Box {
	breathe(*self) => i32 { self.hidden_field }
}

exposed struct Dog {
	exposed id: i32;
}

meet Mammal for Dog {
	breathe(*self) => i32 { 1 }
}

shared spec Greeter {
	# No modifier: inherits the spec's own visibility (shared).
	name(*self) => i32;

	# Explicitly hidden: narrower than the spec itself, reachable
	# throughout this module but not from other modules of the package.
	# Writing `hidden` is not redundant here, since the spec's own
	# default is `shared`.
	hidden double_name(*self) => i32 {
		self.name() * 2
	}

	greet(*self) => i32 {
		self.double_name() + 1
	}
}

meet Greeter for Dog {
	name(*self) => i32 { self.id }
}

doubled_name_of<T: Greeter>(value: *T) => i32 {
	value.double_name()
}

exposed call_double_name_generically(dog: *Dog) => i32 {
	doubled_name_of(dog)
}

# `scaled` is a hook only this module calls. Its default body is checked in
# this module, so it reaches `hidden_helper` even when the conformance is
# written in another module, which may implement `count` but never call
# `scaled`.
exposed spec Counter {
	count(*self) => i32;

	hidden scaled(*self) => i32 {
		hidden_helper(self.count())
	}
}

exposed scaled_total<T: Counter>(value: *T) => i32 {
	value.scaled() + 1
}

# A hidden alias: `reveal` on the import is the only way to bind this name
# from another module, and the binding stays usable afterwards.
alias HiddenAlias = Public;
