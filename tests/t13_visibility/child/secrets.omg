# A physical module carries no visibility of its own; each declaration here
# is hidden on its own account. One `reveal` written on this prefix inside an
# import tree is what its terminal bindings inherit.
exposed struct Held<T> {
	exposed value: T;
}

alias HiddenTemplate<T> = Held<T>;

exposed struct Pair {
	exposed left: i32;
	exposed right: i32;
}

alias HiddenPair = Pair;
