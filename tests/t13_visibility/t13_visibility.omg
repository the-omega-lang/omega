import std::io::println;
# `reveal` is scoped to the import-tree node it is written on and inherited
# by every leaf beneath it. `HiddenAlias` is revealed on its own; the whole
# `secrets` subtree is revealed at once; the exposed siblings are untouched
# and still resolve under ordinary visibility.
import self::child::{
	self,
	Mammal,
	Greeter,
	Dog,
	reveal HiddenAlias,
	reveal secrets::{ HiddenTemplate, HiddenPair },
};

main() => void {
	# `exposed` and `shared` are both reachable across modules within the
	# same top-level package.
	p := child::Public { data = 1; };
	pw := child::PackageWide { data = 2; };
	println$("cross-module-fields: ", p.data, " ", pw.data);

	# `HiddenByDefault` cannot be *named* here, but a value of that type can
	# still be obtained through an exposed accessor, and its own exposed
	# field is reachable directly -- visibility is per-declaration.
	h := child::make_hidden(3);
	println$("hidden-accessor: ", h.data, " ", child::call_hidden_helper(4));

	# The hidden field/method require an exposed accessor from inside the
	# owning type, or an explicit `reveal` at this use site.
	mut box := child::Box::new(5, 6);
	println$("box-visible-hidden: ", box.visible_field, " ", box.call_hidden_double());
	println$("reveal-hidden-field: ", reveal box.hidden_field);
	reveal box.hidden_field = 99;
	println$("reveal-after-mutate: ", reveal box.hidden_field);

	# A spec requirement's effective visibility is the declaring spec's
	# visibility; `shared` here is still package-wide.
	dog := Dog { id = 1; };
	println$("spec-req-visibility: ", Mammal::breathe(&dog));

	# Dynamic dispatch does not widen visibility: `Mammal` stays shared
	# whether `breathe` is reached through static or dynamic dispatch.
	obj := <*spec Mammal>&dog;
	println$("dynamic-dispatch-visibility: ", obj.breathe());

	# `greet` has no modifier, so it inherits `Greeter`'s own visibility
	# (shared) and is callable directly. `double_name` is explicitly
	# `hidden`, narrower than the spec -- it is reachable from `greet`'s
	# own default body (proven by `greet`'s result), but from here, an
	# unrelated location outside the spec, it needs `reveal` just like an
	# ordinary hidden struct member would.
	println$(
		"spec-hidden-member-visibility: ",
		Greeter::greet(&dog),
		" ",
		reveal Greeter::double_name(&dog)
	);

	# `reveal` on an import is the whole gate: the alias's own visibility is
	# not checked a second time when the lazily-bound name is finally
	# resolved, and the same holds for a hidden alias template.
	revealed := HiddenAlias { data = 11; };
	revealed_template := HiddenTemplate<i32> { value = 12; };
	println$("revealed-alias-import: ", revealed.data, " ", revealed_template.value);

	# The second leaf of the same revealed subtree inherited the bypass too,
	# without any `reveal` of its own.
	revealed_pair := HiddenPair { left = 13; right = 14; };
	println$("revealed-subtree-import: ", revealed_pair.left, " ", revealed_pair.right);
}
