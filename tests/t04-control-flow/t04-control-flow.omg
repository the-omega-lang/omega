import extern::std::io::println;

struct Point {
	exposed x: i32;
}

classify(n: i32) => *str {
	match n {
		0..=9 => "single digit",
		10..<100 => "double digit",
	} else {
		"large or negative"
	}
}

# `defer` runs at function exit, FILO, after the return value is fixed.
defer_demo() => i32 {
	mut result := 10;
	defer { println$("defer-a"); result = 999; }
	defer { println$("defer-b"); }
	result
}

main() => i32 {
	# --- if as an expression, with else-if chaining ------------------------
	label := if 0 > 0 { "positive" } else if 0 < 0 { "negative" } else { "zero" };
	println$(label);

	# A `{` right after a condition starts the control-flow body, not a
	# struct literal; parenthesize the literal to use it as the condition.
	tag := if (Point { x = 1; }).x > 0 { "has-x" } else { "no-x" };
	println$(tag);

	# --- match as an expression, with a fallback `else` ---------------------
	println$(classify(4), classify(42), classify(-1));

	# --- the four loop forms -------------------------------------------------
	mut total := 0;
	mut i := 0;
	while i < 5 {
		total += i;
		i += 1;
	}

	mut stop_at := 0;
	loop {
		if stop_at == 3 { break; }
		stop_at += 1;
	}

	mut classic_sum := 0;
	for mut k := 0; k < 4; k += 1 {
		classic_sum += k;
	}

	mut range_count := 0;
	for v in 0..<3 {
		range_count += 1;
	}

	println$(total, stop_at, classic_sum, range_count);

	# --- break / continue -----------------------------------------------------
	mut odds_below_eight := 0;
	for m in 0..<10 {
		if m % 2 == 0 { continue; }
		if m > 7 { break; }
		odds_below_eight += m;
	}
	println$(odds_below_eight);

	# --- defer: FILO order, return value fixed before defers run --------------
	returned := defer_demo();
	println$(returned);

	return 0;
}
