import std::io::println;

# `plat` supplies the one `glue core::panic::PanicHandler` for this hosted
# target, so the panic below reaches libc's handler rather than an
# application-supplied one. The message is optional: `no_message` never runs
# -- the panic in `main` does not return -- but it must still compile.
no_message() => never {
	panic$()
}

main() => void {
	println$("before-panic");
	panic$("boom");
}
