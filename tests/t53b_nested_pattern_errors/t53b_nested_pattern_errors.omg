struct Point {
	x: i32;
	y: i32;
}

struct Pair {
	a: bool;
	b: bool;
}

union Bits {
	word: u32;
	bytes: [4]u8;
}

struct Packet {
	bits: Bits;
	len: u8;
}

enum Res {
	Ok {
		value: i32;
	},
	Err {
		code: i32;
	};
}

enum Opt {
	None,
	Some {
		value: Res;
	};
}

enum Level(tag: u8, label: *str) {
	Low(0, "low") {
		amount: i32;
	},
	High(1, "high");
}

# Rule 1: two leaves that overlap without nesting.
leaf_partial_overlap(p: Point) => i32 {
	match p {
		Point { x = 0..<10; .. } => 1,
		Point { x = 5..<20; .. } => 2,
	} else {
		0
	}
}

# Rule 2: the more specific arm must come first.
specific_after_general(o: Opt) => i32 {
	match o {
		Opt::Some => 1,
		Opt::Some { value = Res::Ok; } => 2,
		Opt::None => 0,
	}
}

# Rule 5: identical patterns.
duplicate(p: Point) => i32 {
	match p {
		Point { x = 0; .. } => 1,
		Point { x = 0; .. } => 2,
		.. => 0,
	}
}

# Rule 4: the earlier arms cover the last one between them.
covered_by_union(p: Pair) => i32 {
	match p {
		Pair { a = true; .. } => 1,
		Pair { a = false; .. } => 2,
		Pair { .. } => 3,
	}
}

covered_by_ranges(n: u8) => i32 {
	match n {
		0..<100 => 1,
		100..<200 => 2,
		0..<200 => 3,
		.. => 4,
	}
}

catch_all_not_last(n: u8) => i32 {
	match n {
		.. => 0,
		3 => 1,
	}
}

missing_cells(o: Opt) => i32 {
	match o {
		Opt::None => 0,
		Opt::Some { value = Res::Ok; } => 1,
	}
}

unknown_field(p: Point) => i32 {
	match p {
		Point { z = 0; .. } => 1,
		.. => 0,
	}
}

header_field(l: Level) => i32 {
	match l {
		Level::Low { label = 0; .. } => 1,
		.. => 0,
	}
}

union_field(p: Packet) => i32 {
	match p {
		Packet { bits = 0; .. } => 1,
		.. => 0,
	}
}

missing_field(p: Point) => i32 {
	match p {
		Point { x = 0; } => 1,
		.. => 0,
	}
}

assign_refined_path(o: Opt) => void {
	^local := o;
	match local {
		Opt::Some { value = Res::Ok; } => {
			local.value = Res::Err { code = 1; };
		},
		.. => {},
	}
}

widened_by_mutable_alias(o: Opt) => i32 {
	^local := o;
	match local {
		Opt::Some { value = Res::Ok; } => {
			pointer := ^local.value;
			local.value.value
		},
		.. => 0,
	}
}

empty_range(n: u8) => i32 {
	match n {
		5..<5 => 1,
		.. => 0,
	}
}

empty_nested_range(p: Point) => i32 {
	match p {
		Point { x = 5..<5; .. } => 1,
		.. => 0,
	}
}
