# Signature-phase rules for anonymous enums. They live in their own package
# because a rejected signature stops body analysis, which is where
# `t27b_anonymous_enum_errors` does its work.

spec Named {
	name(*self) => *str;
}

alias Errors = enum i32 | bool;

# An anonymous enum has no declaration, so it has no methods, static
# functions, or conformances of its own in v1.
meet Named for Errors {
	name(*self) => *str {
		"anonymous"
	}
}

# It is an ordinary composite, so the non-Omega `c` convention rejects it by
# value exactly as it does every other composite. `foreign` linkage is not
# what causes this -- bare `foreign` uses the Omega ABI and accepts it.
foreign(c) takes_by_value(value: Errors) => void;

main() => void {
}
