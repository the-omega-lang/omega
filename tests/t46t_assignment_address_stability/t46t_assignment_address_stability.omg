select_target(value: ^i32) => ^i32 { value }
main() => void {
    ^first: i32 = 0;
    ^second: i32 = 0;
    ^pointer := ^first;
    select_target(pointer).* = { pointer = ^second; 7 };
    pointer.* = 3;
    if first != 7 || second != 3 { panic$("assignment address changed"); }
    ^values: [2]i32 = [0, 0];
    ^index: i32 = 0;
    values[index] = { index = 1; 9 };
    if values[0] != 9 || values[index] != 0 { panic$("assignment index changed"); }
}
