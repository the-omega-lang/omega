# Inference-hole diagnostics: `_` outside an inferable position, holes that
# nothing determines, and the removed `spec A` selector and `[]T` binding.

exposed spec SpecThree { three(*self) => i32; }
meet SpecThree for i32 { three(*self) => i32 { 3 } }

struct Pair<T, U> {
    exposed a: T;
    exposed b: U;
}

# --- positions where nothing is inferred -----------------------------------
@suppress(unused_parameter)
bad_param(v: _) => void {}

bad_return() => _ { 1 }

struct BadField { exposed f: _; }

alias Holey = Pair<_, u8>;
@suppress(unused_parameter)
through_alias(v: Holey) => void {}

bad_default<T = _>() => usize { sizeof<T> }

@suppress(unused_parameter)
bad_spec(v: spec _) => void {}

@suppress(unused_parameter)
bad_object(v: *spec _) => void {}

spec Holds<T> { held() => T; }

# --- selection and determination ------------------------------------------
nothing<T>() => usize { sizeof<T> }

@suppress(unused_parameter)
rank<T>(value: T) => i32 { 33 }
@suppress(unused_parameter)
rank<T: SpecThree>(value: T) => i32 { 44 }

mid<T = u16, U = u32>() => usize { sizeof<T> + sizeof<U> }

# --- inferred spec slots ---------------------------------------------------
exposed spec Make { make() => Self; }
exposed spec Other { make() => Self; }

struct Twice {
    exposed id: i32;

    exposed inherent() => i32 { 5 }
}
meet Make for Twice { make() => Self { Self { id = 1; } } }
meet Other for Twice { make() => Self { Self { id = 2; } } }

# --- one generic spec, two applications ------------------------------------
spec P<T> { f() => Self; }
struct Both { exposed id: i32; }
meet P<u8> for Both { f() => Self { Self { id = 1; } } }
meet P<u16> for Both { f() => Self { Self { id = 2; } } }

hole_make<T, U>(a: T, b: U) => Pair<T, U> { Pair<T, U> { a = a; b = b; } }
@suppress(unused_parameter)
hole_make<T>(a: T) => Pair<T, T> { Pair<T, T> { a = a; b = a; } }

main() => void {
    # Defaults and static-spec bounds are resolved where they are used.
    defaulted := bad_default();
    bad_spec(1);
    no_init : _;
    cast := <_>5;
    applied := Holds<_>::held();
    undetermined := nothing<_>();
    unsolved : Pair<_, u8> = 5;
    conflicting : Pair<_, u8> = Pair<i32, i32> { a = 1; b = 2; };
    ambiguous := rank<i32 : _>(1);
    migrated := rank<spec SpecThree>(1);
    unsized : []i32 = [1, 2];
    both := <_ : _>::make();
    two_specs := <Twice : _>::make();
    inherent_only := <Twice : _>::inherent();
    defaulted_hole := mid<_, u8>();
    applications := <Both : _>::f();
    in_spec : Pair<_, *spec Holds<_>> = 1;
    in_enum : Pair<_, enum i32 | [_]u8> = 1;
    for r : enum _ | i32 in 0..<2 {}
    value_slot : Pair<_, 5> = Pair { a = 1; b = 2; };
    known_conflict : Pair<_, [2]u8> = Pair<i32, [2]i32> { a = 1; b = [2, 3]; };
    branch_conflict : Pair<_, u8> = if true { hole_make(1, 2) } else { Pair<i32, i32> { a = 3; b = 4; } };
}
