import std::io::println;

count() => void {
	# The initializer's block is left as soon as it yields `0`, so its
	# `defer` runs once, before the first iteration.
	for ^i := { defer { println$("deferred"); } 0 }; i < 2; ++i {
		println$("iteration ", i);
	}
	println$("loop done");
}

main() => void {
	count();
	println$("returned");
}
