# Emits its own copy of `Node`'s table in this source's object, which the
# linker merges with the one `main` emits.
import core::reflection::TypeInfo;
import super::Node;

exposed node_info() => *TypeInfo {
	typeinfo<Node>
}

exposed callback_enum_info() => *TypeInfo {
	typeinfo<enum (other: i32) => void | u8>
}
