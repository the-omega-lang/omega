import std::io::println;
import self::helper;
import self::mymodule;
import self::mymodule::thing::something;
import self::mymodule::other::other_greeting;

main() => void {
	# `import self::helper;` -- an explicit same-package sibling import from
	# the package root; unprefixed `import helper;` is no longer legal since
	# unprefixed imports are always top-level package identities.
	println$("helper-greeting: ", helper::greeting());

	# `import self::mymodule;` makes the module path available; `import
	# self::mymodule::thing::something;` separately binds one item's final name.
	println$("mymodule-label: ", mymodule::label());
	println$("something-import: ", something());

	# `mymodule::other` reaches `helper` through a chained `super::super::`
	# from two logical levels down -- the same target `thing.omg` reaches
	# with `root::helper`.
	println$("chained-super-import: ", other_greeting());

	# `core`'s exposed declarations participate in ambient name resolution:
	# `Option` needs no explicit import here.
	value := Option::Some { value = 7; };
	match value {
		Option::Some => { println$("ambient-option: ", value.value); },
	} else {}
}
