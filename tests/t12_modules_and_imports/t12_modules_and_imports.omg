import extern::std::io::println;
import helper;
import mymodule;
import mymodule::thing::something;

main() => i32 {
	# `import helper;` -- an unrooted import of a sibling root-level module.
	println$("helper-greeting: ", helper::greeting());

	# `import mymodule;` makes the module path available; `import
	# mymodule::thing::something;` separately binds one item's final name.
	println$("mymodule-label: ", mymodule::label());
	println$("something-import: ", something());

	# `core`'s exposed declarations participate in ambient name resolution:
	# `Option` needs no explicit import here.
	value := Option::Some { value = 7; };
	match value {
		Option::Some => { println$("ambient-option: ", value.value); },
	} else {}

	return 0;
}
