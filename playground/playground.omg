import std::io::println;

spec A {
	a() => void;
}

spec B {
	b() => void;
}

marker MyMarker {}

meet A for MyMarker {
	a() => void {
		println$("a() called");
	}
}

meet B for MyMarker {
	b() => void {
		println$("b() called");
	}
}

some_fn<T : A>() => void {
	T::a();
}

some_fn<T : B>() => void {
	T::b();
}

some_fn_with_value<T : A>(value : T) => T {
	T::a();
	value
}

some_fn_with_value<T : B>(value : T) => T {
	T::b();
	value
}

main() => void {
	MyMarker{};
	MyMarker::a();
	MyMarker::b();
	some_fn<MyMarker : A>();
	some_fn<MyMarker : B>();
	some_fn_with_value<_ : A>(MyMarker{});
	some_fn_with_value<_ : B>(MyMarker{});
}
