import std::io::println;

shared spec A {
	a() => void;
}

shared spec B {
	b() => void;
}

marker MyMarker {}

meet A for MyMarker {
	a() => void {
		println$("a() called");
	}
}

meet B for MyMarker {
	b() => void {
		println$("b() called");
	}
}

some_fn<T : A>() => void {
	T::a();
}

some_fn<T : B>() => void {
	T::b();
}

main() => void {
	MyMarker{};
	MyMarker::a();
	MyMarker::b();
	some_fn<MyMarker>();
}
